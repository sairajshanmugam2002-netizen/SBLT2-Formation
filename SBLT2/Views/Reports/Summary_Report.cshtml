@{
    ViewBag.Title = "Summary_Report";
}

<script type="text/javascript">
    $(document).ready(function () {
        var ID = 0;
        var User = sessionStorage.getItem("user");
        var currentGridRecords = [];

        $("#from_Date").jqxDateTimeInput({ width: '100%', height: '32px', formatString: 'dd-MMM-yyyy' });
        $("#to_Date").jqxDateTimeInput({ width: '100%', height: '32px', formatString: 'dd-MMM-yyyy' });

        function renderSummaryCharts(records) {
            var passedMap = {};
            var failedMap = {};

            if (Array.isArray(records)) {
                for (var i = 0; i < records.length; i++) {
                    var r = records[i];
                    if (!r) continue;

                    var bType = (r.mv_BatteryType || r.BatteryType || r.label || '').toString().trim();
                    if (!bType) continue;

                    var pQty = parseInt(r.mv_CDPassedQty != null ? r.mv_CDPassedQty : (r.PassedQty != null ? r.PassedQty : (r.TotalPassed != null ? r.TotalPassed : 0)), 10);
                    if (isNaN(pQty) || pQty < 0) pQty = 0;

                    var fQty = parseInt(r.mv_CDFailQty != null ? r.mv_CDFailQty : (r.FailQty != null ? r.FailQty : (r.FailedQty != null ? r.FailedQty : (r.TotalFailed != null ? r.TotalFailed : 0))), 10);
                    if (isNaN(fQty) || fQty < 0) fQty = 0;

                    if (pQty === 0 && fQty === 0) {
                        pQty = 1;
                    }

                    if (pQty > 0) {
                        passedMap[bType] = (passedMap[bType] || 0) + pQty;
                    }
                    if (fQty > 0) {
                        failedMap[bType] = (failedMap[bType] || 0) + fQty;
                    }
                }
            }

            var passedItems = [];
            for (var pKey in passedMap) {
                if (passedMap.hasOwnProperty(pKey)) {
                    passedItems.push({ type: pKey, qty: passedMap[pKey] });
                }
            }
            passedItems.sort(function (a, b) { return b.qty - a.qty; });

            var failedItems = [];
            for (var fKey in failedMap) {
                if (failedMap.hasOwnProperty(fKey)) {
                    failedItems.push({ type: fKey, qty: failedMap[fKey] });
                }
            }
            failedItems.sort(function (a, b) { return b.qty - a.qty; });

            if (typeof window.renderModernDonutChart === 'function') {
                window.renderModernDonutChart('#summaryChartPassed', passedItems, 'passed');
                window.renderModernDonutChart('#summaryChartFailed', failedItems, 'failed');
            }
        }

        getgrid();
        function getgrid(ID) {
            var Rights = sessionStorage.getItem('rights');
            var User = sessionStorage.getItem('Code');
            var url = "";
            if (ID == 1) {
                $("#from_Date").jqxDateTimeInput({ width: '100%', height: '32px', formatString: 'yyyyMMdd' });
                $("#to_Date").jqxDateTimeInput({ width: '100%', height: '32px', formatString: 'yyyyMMdd' });

                url = "Pr_Fetch_SummaryReport?from=" + $('#from_Date').val() + "&to=" + $('#to_Date').val();

                $("#from_Date").jqxDateTimeInput({ width: '100%', height: '32px', formatString: 'dd-MMM-yyyy' });
                $("#to_Date").jqxDateTimeInput({ width: '100%', height: '32px', formatString: 'dd-MMM-yyyy' });
            }
            else {
                $("#from_Date").jqxDateTimeInput({ width: '100%', height: '32px', formatString: 'yyyyMMdd' });
                $("#to_Date").jqxDateTimeInput({ width: '100%', height: '32px', formatString: 'yyyyMMdd' });

                url = "Pr_Fetch_SummaryReport?from=" + $('#from_Date').val() + "&to=" + $('#to_Date').val();

                $("#from_Date").jqxDateTimeInput({ width: '100%', height: '32px', formatString: 'dd-MMM-yyyy' });
                $("#to_Date").jqxDateTimeInput({ width: '100%', height: '32px', formatString: 'dd-MMM-yyyy' });
            }
            var source = {
                datatype: "json",
                datafields: [{ name: 'mv_BatteryType', type: 'string' }, { name: 'mv_FillingLine', type: 'string' },
                    { name: 'mv_BankNo', type: 'string' }, { name: 'mv_Date', type: 'string' },
                    { name: 'mv_NoOfCells', type: 'string' }, { name: 'mv_FillingStartTime', type: 'string' },
                    { name: 'mv_FillingEndTime', type: 'string' }, { name: 'mv_CDPassedQty', type: 'string' },
                    { name: 'mv_CDFailQty', type: 'string' }, { name: 'mv_AcidSPG', type: 'string' },
                    { name: 'mv_AcidVolume', type: 'string' }, { name: 'mv_TubNo', type: 'string' },
                    { name: 'mv_CKTNo', type: 'string' }, { name: 'mv_CellShortQty', type: 'string' },
                    { name: 'mv_Temperature', type: 'string' }, { name: 'mv_PRDSupervisior', type: 'string' },
                    { name: 'mv_FillingOperator', type: 'string' }, { name: 'mv_QAInspector', type: 'string' },
                    { name: 'mv_ShiftEngineer', type: 'string' }, { name: 'mv_QRCode', type: 'string' },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source, {
                loadComplete: function (records) {
                    currentGridRecords = dataAdapter.records || records || [];
                    renderSummaryCharts(currentGridRecords);
                },
                loadError: function (xhr, status, error) {
                    currentGridRecords = [];
                    renderSummaryCharts([]);
                }
            });
            $("#Grid").jqxGrid({
                theme: 'ui-sunny',
                width: '100%',
                autoheight: true,
                source: dataAdapter,
                columnsresize: true,
                pageable: true,
                pagermode: 'simple',
                enabletooltips: true,
                showfilterrow: true,
                filterable: true,
                pagesize: 14,
                columns: [
                    { text: 'QRCode', datafield: 'mv_QRCode', width: 160, minwidth: 140 },
                    { text: 'Battery type', datafield: 'mv_BatteryType', width: 140, minwidth: 120 },
                    { text: 'Filling Line', datafield: 'mv_FillingLine', width: 120, minwidth: 100 },
                    { text: 'Bank No', datafield: 'mv_BankNo', width: 100, minwidth: 90 },
                    { text: 'Date', datafield: 'mv_Date', width: 120, minwidth: 110 },
                    { text: 'No Of Cells', datafield: 'mv_NoOfCells', width: 110, minwidth: 90 },
                    { text: 'Start Time', datafield: 'mv_FillingStartTime', width: 120, minwidth: 100 },
                    { text: 'End Time', datafield: 'mv_FillingEndTime', width: 120, minwidth: 100 },
                    { text: 'Passed Qty', datafield: 'mv_CDPassedQty', width: 100, minwidth: 90 },
                    { text: 'Fail Qty', datafield: 'mv_CDFailQty', width: 100, minwidth: 90 },
                    { text: 'Acid SPG', datafield: 'mv_AcidSPG', width: 110, minwidth: 95 },
                    { text: 'Acid Volume', datafield: 'mv_AcidVolume', width: 110, minwidth: 95 },
                    { text: 'Tub No', datafield: 'mv_TubNo', width: 100, minwidth: 85 },
                    { text: 'CKT No', datafield: 'mv_CKTNo', width: 100, minwidth: 85 },
                    { text: 'Cell Short Qty', datafield: 'mv_CellShortQty', width: 120, minwidth: 100 },
                    { text: 'Temperature', datafield: 'mv_Temperature', width: 120, minwidth: 100 },
                    { text: 'PRD Supervisor', datafield: 'mv_PRDSupervisior', width: 140, minwidth: 120 },
                    { text: 'Operator', datafield: 'mv_FillingOperator', width: 130, minwidth: 110 },
                    { text: 'QAInspector', datafield: 'mv_QAInspector', width: 130, minwidth: 110 },
                    { text: 'Shift Engg', datafield: 'mv_ShiftEngineer', width: 130, minwidth: 110 }
                ]
            });
        }

        $("#btnshow").click(function () {
            getgrid(1);
        });
        $("#btnINV").click(function () {
            getgrid(2);
        });

        $("#Reports").addClass("active");
        $("#Summary_Report").addClass("active");

        $("#sidebar-collapse").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        });
        $("#btn_Clear").click(function () {
            Clear();
        });
        $("#btn_Refresh").click(function () {
            getgrid(1);
        });
        $("#btn_Excel").click(function () {
            var from = $('#from_Date').val();
            var to = $('#to_Date').val();
            $("#from_Date").jqxDateTimeInput({ width: '100%', height: '32px', formatString: 'yyyyMMdd' });
            $("#to_Date").jqxDateTimeInput({ width: '100%', height: '32px', formatString: 'yyyyMMdd' });
            window.open("../../Master/Export_To_Excel?FileName=Material Receipt Expire Report&Heading=Over all Material Receipt Expire Report for the particular period from " + from + " to " + to + "&Data=pr_FetchExpiryAlertReport_Excel '" + $('#from_Date').val() + "','" + $('#to_Date').val() + "'");
            $("#from_Date").jqxDateTimeInput({ width: '100%', height: '32px', formatString: 'dd-MMM-yyyy' });
            $("#to_Date").jqxDateTimeInput({ width: '100%', height: '32px', formatString: 'dd-MMM-yyyy' });
        });

        function toggleCharts() {
            var $sec = $('#summaryChartsSection');
            if ($sec.is(':visible')) {
                $sec.slideUp(200);
                $('#btn_ToggleCharts').html('<i class="fa fa-pie-chart text-primary"></i> Show Charts');
            } else {
                $sec.slideDown(200, function () {
                    if (currentGridRecords && currentGridRecords.length) {
                        renderSummaryCharts(currentGridRecords);
                    }
                });
                $('#btn_ToggleCharts').html('<i class="fa fa-pie-chart text-primary"></i> Hide Charts');
            }
        }

        $("#btn_ToggleCharts").click(toggleCharts);
        $("#btn_Chart").click(toggleCharts);
        $("#btn_Pdf").click(function () { });
        $("#btn_Help").click(function () { });

        $(document).on('themeChanged', function () {
            if (currentGridRecords && $('#summaryChartsSection').is(':visible')) {
                renderSummaryCharts(currentGridRecords);
            }
        });

        $(window).on('resize', function () {
            if (currentGridRecords && $('#summaryChartsSection').is(':visible')) {
                renderSummaryCharts(currentGridRecords);
            }
        });
    });
</script>

<div class="content-wrapper">
    <section class="content">
        <div class="row">
            <div class="col-xs-12">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">
                            <i class="fa fa-bar-chart text-primary"></i>
                            MVRLA Formation Summary Report
                        </h3>
                        <div class="box-tools pull-right">
                            <button type="button" id="btn_ToggleCharts" title="Toggle Charts Display" data-rel="tooltip" class="btn btn-default btn-sm" style="margin-right: 6px;">
                                <i class="fa fa-pie-chart text-primary"></i> Charts
                            </button>
                            <button type="button" id="btn_Refresh" title="Refresh Grid Data" data-rel="tooltip" class="btn btn-default btn-sm" style="margin-right: 6px;">
                                <i class="fa fa-refresh text-primary"></i> Refresh
                            </button>
                            <button type="button" id="btn_Excel" title="Export to Excel" data-rel="tooltip" class="btn btn-success btn-sm">
                                <i class="fa fa-file-excel-o"></i> Export Excel
                            </button>
                        </div>
                    </div>

                    <!-- Filter Control Panel -->
                    <div class="box-body" style="background-color: var(--bg-secondary); border-bottom: 1px solid var(--border-color); padding: 20px;">
                        <form class="form-horizontal" role="form" id="form1">
                            <div class="row" style="align-items: flex-end; display: flex; flex-wrap: wrap;">
                                <div class="col-md-3 col-sm-5 col-xs-12" style="margin-bottom: 10px;">
                                    <label class="control-label" style="font-size: 12px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 5px; display: block;">From Date</label>
                                    <div id="from_Date"></div>
                                </div>
                                <div class="col-md-3 col-sm-5 col-xs-12" style="margin-bottom: 10px;">
                                    <label class="control-label" style="font-size: 12px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 5px; display: block;">To Date</label>
                                    <div id="to_Date"></div>
                                </div>
                                <div class="col-md-3 col-sm-2 col-xs-12" style="margin-bottom: 10px;">
                                    <button type="button" id="btnshow" class="btn btn-primary" style="min-width: 130px; margin-top: 24px;">
                                        <i class="fa fa-search"></i> Search
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Modern Battery Analytics Charts Section (Passed & Failed Donut Cards) -->
                    <div class="box-body" id="summaryChartsSection" style="padding: 20px 20px 8px 20px; background-color: var(--bg-primary); border-bottom: 1px solid var(--border-color);">
                        <div class="row">
                            <!-- Chart 1: Passed -->
                            <div class="col-md-6 col-sm-12" style="margin-bottom: 20px;">
                                <div class="modern-chart-card">
                                    <div class="modern-chart-card-header">
                                        <span class="donut-badge-icon badge-passed"><i class="fa fa-check"></i></span>
                                        <h4 class="modern-chart-title">Battery Type Wise Passed Qty</h4>
                                    </div>
                                    <div class="modern-chart-card-body">
                                        <div id='summaryChartPassed' style="width:100%;"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Chart 2: Failed -->
                            <div class="col-md-6 col-sm-12" style="margin-bottom: 20px;">
                                <div class="modern-chart-card">
                                    <div class="modern-chart-card-header">
                                        <span class="donut-badge-icon badge-failed"><i class="fa fa-exclamation"></i></span>
                                        <h4 class="modern-chart-title">Battery Type Wise Failed Qty</h4>
                                    </div>
                                    <div class="modern-chart-card-body">
                                        <div id='summaryChartFailed' style="width:100%;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Report Data Grid Section -->
                    <div class="box-body" style="padding: 16px 20px 20px 20px;">
                        <div style="margin-bottom: 10px;">
                            <h4 style="font-size: 13.5px; font-weight: 700; color: var(--text-primary); margin: 0;">
                                <i class="fa fa-table text-primary"></i> Production Log Summary Records
                            </h4>
                        </div>
                        <div class="table-wrapper">
                            <div id="Grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
