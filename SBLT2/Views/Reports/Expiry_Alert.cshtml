@{
    ViewBag.Title = "Expiry_Alert";
}

<script type="text/javascript">
    $(document).ready(function () {
        var ID = 0;
        var User = sessionStorage.getItem("user");

        $("#from_Date").jqxDateTimeInput({ width: '110px', height: '25px', formatString: 'dd-MMM-yyyy' });
        $("#to_Date").jqxDateTimeInput({ width: '110px', height: '25px', formatString: 'dd-MMM-yyyy' });

        getgrid();
        function getgrid() {
            var Rights = sessionStorage.getItem('rights');
            var User = sessionStorage.getItem('Code');
            var url = "";
            if (Rights == 19) {
                $("#from_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });
                $("#to_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });

                url = "pr_FetchExpiryAlertReport?from=" + $('#from_Date').val() + "&to=" + $('#to_Date').val();

                $("#from_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
                $("#to_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
            }
            else {
                $("#from_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });
                $("#to_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });

                url = "pr_FetchExpiryAlertReport?from=" + $('#from_Date').val() + "&to=" + $('#to_Date').val();

                $("#from_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
                $("#to_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
            }
            var source = {
                datatype: "json",
                datafields: [{
                    name: 'mr_MRC_No',
                    type: 'string'
                },
                {
                    name: 'mr_DOR',
                    type: 'string'
                    },                   
                {
                    name: 'mr_MaterialCode',
                    type: 'string'
                    },
                    {
                        name: 'mr_MaterialDescription',
                        type: 'string'
                    },
                {
                    name: 'Qty',
                    type: 'string'
                },
                {
                    name: 'UOM',
                    type: 'string'
                    }, {
                    name: 'mr_SupplierName',
                        type: 'string'
                    }, {
                    name: 'mr_DOM',
                        type: 'string'
                    }, {
                    name: 'mr_DOE',
                        type: 'string'
                    }, {
                    name: 'RemainingDays',
                        type: 'string'
                    },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source);
            $("#Grid").jqxGrid({
                theme: 'ui-sunny',
                width: '100%',
                autoheight: true,
                source: dataAdapter,
                columnsresize: true,
                pageable: true,
                enabletooltips: false,
                pagermode: 'simple',
                enabletooltips: true,
                showfilterrow: true,
                filterable: true,
                pagesize: 14,
                columns: [{
                        text: 'Tag No',
                    datafield: 'mr_MRC_No',
                        width: '20%'
                    },
                    {
                        text: 'DOR',
                        datafield: 'mr_DOR',
                        width: '20%'
                    },
                    {
                        text: 'Material Code',
                        datafield: 'mr_MaterialCode',
                        width: '20%'
                    }, {
                        text: 'Material Description',
                        datafield: 'mr_MaterialDescription',
                        width: '20%'
                    },
                    {
                        text: 'Qty',
                        datafield: 'Qty',
                        width: '18%',
                    },
                    {
                    text: 'UOM',
                        datafield: 'UOM',
                        width: '20%'
                }, {
                    text: 'Supplier Name',
                        datafield: 'mr_SupplierName',
                        width: '20%',
                    }, {
                        text: 'DOM',
                        datafield: 'mr_DOM',
                        width: '20%',
                    }, {
                        text: 'DOE',
                        datafield: 'mr_DOE',
                        width: '20%',
                    }, {
                        text: 'Remaining Days',
                        datafield: 'RemainingDays',
                        width: '20%',
                    },
                    //{
                    //    text: 'Edit',
                    //    datafield: 'Edit',
                    //    filterable: false,
                    //    width: 40,
                    //    cellsrenderer: function () {
                    //        return '<div style="width: 100%"><img src="../../../img/Edit1.png" style="margin-left: 25%" /></div>';
                    //    }
                    //},
                    //{
                    //    text: 'Del',
                    //    datafield: 'delete',
                    //    filterable: false,
                    //    width: 40,
                    //    cellsrenderer: function () {
                    //        return '<div style="width: 100%"><img src="../../../img/del.png" style="margin-left: 25%" /></div>';
                    //    }
                    //},
                ]
            });
        }

        $("#btnshow").click(function () {
            $('#myModal').modal('hide');
            getgrid();
        })

        $("#Reports").addClass("active");
        $("#Expiry_Alert").addClass("active");

        $("#sidebar-collapse").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        });
        $("#btn_Clear").click(function () {
            Clear();
        })
        $("#btn_Refresh").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        })
        $("#btn_Excel").click(function () {
            var from = $('#from_Date').val();
            var to = $('#to_Date').val();
            $("#from_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });
            $("#to_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });
            window.open("../../Master/Export_To_Excel?FileName=Material Receipt Expire Report&Heading=Over all Material Receipt Expire Report for the particular period from " + from + " to " + to + "&Data=pr_FetchExpiryAlertReport_Excel '" + $('#from_Date').val() + "','" + $('#to_Date').val() + "'");
            $("#from_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
            $("#to_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
        })

        $("#Reports").addClass("active");
        $("#Expiry_Alert").addClass("active");

        $("#btn_Pdf").click(function () { })
        $("#btn_Chart").click(function () { })
        $("#btn_Help").click(function () { })
    });
</script>


