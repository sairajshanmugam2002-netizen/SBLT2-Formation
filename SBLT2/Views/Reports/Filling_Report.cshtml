<div class="content-wrapper">
    <section class="content">
        <div class="row">
            <div class="col-xs-12">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">
                            <i class="fa fa-filter text-primary"></i>
                            Formation Filling Report
                        </h3>
                        <div class="box-tools pull-right">
                            <button type="button" id="btn_Refresh" title="Refresh Grid Data" data-rel="tooltip" class="btn btn-default btn-sm" style="margin-right: 6px;">
                                <i class="fa fa-refresh text-primary"></i> Refresh
                            </button>
                            <button type="button" id="btn_Excel" title="Export to Excel" data-rel="tooltip" class="btn btn-success btn-sm">
                                <i class="fa fa-file-excel-o"></i> Export Excel
                            </button>
                        </div>
                    </div>

                    <!-- Filter Control Panel -->
                    <div class="box-body" style="background-color: var(--bg-secondary); border-bottom: 1px solid var(--border-color); padding: 20px;">
                        <form class="form-horizontal" role="form" id="form1">
                            <div class="row" style="margin-bottom: 14px;">
                                <div class="col-md-3 col-sm-6 col-xs-12" style="margin-bottom: 10px;">
                                    <label class="control-label" style="font-size: 12px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 5px; display: block;">From Date</label>
                                    <div id="from_Date"></div>
                                </div>
                                <div class="col-md-3 col-sm-6 col-xs-12" style="margin-bottom: 10px;">
                                    <label class="control-label" style="font-size: 12px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 5px; display: block;">To Date</label>
                                    <div id="to_Date"></div>
                                </div>
                                <div class="col-md-3 col-sm-6 col-xs-12" style="margin-bottom: 10px;">
                                    <label class="control-label" style="font-size: 12px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 5px; display: block;">Shift</label>
                                    <div id="shift"></div>
                                </div>
                                <div class="col-md-3 col-sm-6 col-xs-12" style="margin-bottom: 10px;">
                                    <label class="control-label" style="font-size: 12px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 5px; display: block;">Model</label>
                                    <div id="model"></div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-3 col-sm-6 col-xs-12" style="margin-bottom: 10px;">
                                    <label class="control-label" style="font-size: 12px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 5px; display: block;">Tub No</label>
                                    <div id="tub"></div>
                                </div>
                                <div class="col-md-3 col-sm-6 col-xs-12" style="margin-bottom: 10px;">
                                    <label class="control-label" style="font-size: 12px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 5px; display: block;">Bank No</label>
                                    <div id="bank"></div>
                                </div>
                                <div class="col-md-6 col-sm-12 col-xs-12" style="margin-top: 24px; display: flex; gap: 8px; flex-wrap: wrap;">
                                    <button type="button" id="btnshow" class="btn btn-primary" style="min-width: 140px;">
                                        <i class="fa fa-search"></i> Search (Shift/Model)
                                    </button>
                                    <button type="button" id="btnSearch" class="btn btn-white btn-info" style="min-width: 140px;">
                                        <i class="fa fa-filter"></i> Search (Tub/Bank)
                                    </button>
                                    <button type="button" id="btnPrint" class="btn btn-white btn-warning" style="min-width: 110px;">
                                        <i class="fa fa-print"></i> Print PDF
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Report Data Grid Section -->
                    <div class="box-body" style="padding: 16px 20px 20px 20px;">
                        <div style="margin-bottom: 10px;">
                            <h4 style="font-size: 13.5px; font-weight: 700; color: var(--text-primary); margin: 0;">
                                <i class="fa fa-table text-primary"></i> Filling Production Records
                            </h4>
                        </div>
                        <div class="table-wrapper">
                            <div id="Grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>









