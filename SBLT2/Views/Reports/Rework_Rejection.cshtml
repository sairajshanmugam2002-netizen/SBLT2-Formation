@{
    ViewBag.Title = "Rework / Rejection Report";
}

<style>
    .filter-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 6px;
        display: inline-block;
    }
    .box-title {
        font-size: 16px;
        font-weight: bold;
        color: #1e395b;
    }

    /* ==========================================================================
       Rework / Rejection Report: Field Block Spacing Standards (Consistent 10px Gap)
       Applied strictly to Rework / Rejection Report page
       ========================================================================== */
    #formReport > .row {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 14px 10px !important; /* 14px vertical gap, 10px horizontal gap between field blocks */
        margin-left: 0 !important;
        margin-right: 0 !important;
        margin-bottom: 0 !important;
        align-items: flex-end !important;
    }

    #formReport > .row:before,
    #formReport > .row:after {
        display: none !important;
        content: none !important;
    }

    #formReport > .row > [class*="col-"] {
        float: none !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        margin-top: 0 !important;
        margin-bottom: 0 !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        box-sizing: border-box !important;
    }

    @@media (min-width: 992px) {
        #formReport > .row > .col-md-3 {
            flex: 0 0 calc((100% - 30px) / 4) !important;
            max-width: calc((100% - 30px) / 4) !important;
            width: calc((100% - 30px) / 4) !important;
        }
    }

    @@media (min-width: 768px) and (max-width: 991px) {
        #formReport > .row > [class*="col-"] {
            flex: 0 0 calc((100% - 10px) / 2) !important;
            max-width: calc((100% - 10px) / 2) !important;
            width: calc((100% - 10px) / 2) !important;
        }
    }

    @@media (max-width: 767px) {
        #formReport > .row > [class*="col-"] {
            flex: 0 0 100% !important;
            max-width: 100% !important;
            width: 100% !important;
        }
    }

    #formReport label.filter-label {
        display: inline-block !important;
        margin-bottom: 6px !important;
        font-size: 12.5px !important;
        font-weight: 600 !important;
        color: var(--text-primary) !important;
    }

    #formReport .form-control {
        width: 100% !important;
        box-sizing: border-box !important;
    }

    #formReport .jqx-widget {
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }
</style>

<div class="content-wrapper">
    <section class="content">
        <div class="row">
            <div class="col-xs-12" style="padding: 10px 15px 0 15px;">
                <div class="box box-primary" style="border-top: 3px solid var(--ar-primary) !important;">
                    <div class="box-header with-border" style="background-color: var(--card-header-bg); padding: 14px 20px;">
                        <h3 class="box-title" style="font-size: 15px; font-weight: 700; color: var(--text-primary);">
                            <i class="fa fa-file-text-o" style="color: var(--ar-primary); margin-right: 6px;"></i>
                            Rework / Rejection Report
                        </h3>
                        <div class="box-tools pull-right" style="display: flex; align-items: center; gap: 8px;">
                            <button type="button" id="btn_Excel" title="Export Report to Excel" class="btn btn-success btn-sm" style="background-color: var(--ar-primary) !important; border-color: var(--ar-primary) !important; color: #FFF !important; min-height: 32px; height: 32px; padding: 4px 14px;">
                                <i class="fa fa-file-excel-o"></i> Export Excel
                            </button>
                            <button type="button" id="btn_Refresh" title="Refresh Report" class="btn btn-box-tool">
                                <span class='fa fa-refresh text-primary'></span>
                            </button>
                        </div>
                    </div>

                    <div class="box-body" style="padding: 18px 20px 12px 20px; background-color: var(--bg-secondary); border-bottom: 1px solid var(--border-color);">
                        <form class="form-horizontal" role="form" id="formReport" onsubmit="return false;">
                            <div class="row">
                                <!-- Filter 1: Type Dropdown -->
                                <div class="col-md-3 col-sm-6" style="margin-bottom: 12px;">
                                    <label for="ddlType" class="filter-label"><i class="fa fa-filter text-muted"></i> Defect Type:</label>
                                    <div id="ddlType"></div>
                                </div>

                                <!-- Filter 2: From Date -->
                                <div class="col-md-3 col-sm-6" style="margin-bottom: 12px;">
                                    <label for="from_Date" class="filter-label"><i class="fa fa-calendar text-muted"></i> From Date:</label>
                                    <div id="from_Date"></div>
                                </div>

                                <!-- Filter 3: To Date -->
                                <div class="col-md-3 col-sm-6" style="margin-bottom: 12px;">
                                    <label for="to_Date" class="filter-label"><i class="fa fa-calendar text-muted"></i> To Date:</label>
                                    <div id="to_Date"></div>
                                </div>

                                <!-- Search & Clear Buttons -->
                                <div class="col-md-3 col-sm-6" style="margin-bottom: 12px; margin-top: 24px; display: flex; gap: 8px;">
                                    <button type="button" id="btnSearch" class="btn btn-primary" style="flex: 1; background-color: var(--ar-primary) !important; border-color: var(--ar-primary) !important; color: #FFFFFF !important;">
                                        <i class="fa fa-search"></i> Search
                                    </button>
                                    <button type="button" id="btnClear" class="btn btn-white btn-warning btn-bold" style="min-width: 80px;">
                                        <i class="fa fa-eraser orange"></i> Clear
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Report Grid Section -->
                    <div class="box-body" style="padding: 16px 20px 20px 20px;">
                        <div style="margin-bottom: 10px;">
                            <h4 style="font-size: 13.5px; font-weight: 700; color: var(--text-primary); margin: 0;">
                                <i class="fa fa-table text-primary"></i> Filtered Defect Logs
                            </h4>
                        </div>
                        <div class="table-wrapper">
                            <div id="Grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        // Highlight active sidebar menu
        $("#Report").addClass("active");
        $("#Reports").addClass("active");
        $("#Rework_Rejection_Report").addClass("active");

        // Initialize Date Filters (Defaults to today)
        $("#from_Date").jqxDateTimeInput({ width: '100%', height: '30px', formatString: 'dd-MMM-yyyy' });
        $("#to_Date").jqxDateTimeInput({ width: '100%', height: '30px', formatString: 'dd-MMM-yyyy' });

        // Set default date range: first day of current month to today
        var now = new Date();
        var firstDayOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
        $("#from_Date").jqxDateTimeInput('setDate', firstDayOfMonth);
        $("#to_Date").jqxDateTimeInput('setDate', now);

        // =========================================================================
        // Initialize Type Dropdown with Options: All, Rework, Rejection
        // Default selected: All
        // =========================================================================
        var typeOptions = ['All', 'Rework', 'Rejection'];
        $("#ddlType").jqxDropDownList({
            source: typeOptions,
            selectedIndex: 0,
            width: '100%',
            height: '30px',
            autoDropDownHeight: true
        });

        // Filter Grid whenever Type dropdown changes
        $("#ddlType").on('change', function (event) {
            getGrid();
        });

        // Load Grid initially
        getGrid();

        // Search Button click
        $("#btnSearch").click(function () {
            getGrid();
        });

        // Clear Button click: resets Type to 'All' and reloads grid
        $("#btnClear").click(function () {
            $("#ddlType").jqxDropDownList('selectIndex', 0);
            $("#from_Date").jqxDateTimeInput('setDate', firstDayOfMonth);
            $("#to_Date").jqxDateTimeInput('setDate', now);
            getGrid();
        });

        // Refresh Button in header
        $("#btn_Refresh").click(function () {
            getGrid();
        });

        // Export to Excel Button
        $("#btn_Excel").click(function () {
            var selectedType = $('#ddlType').val() || "All";
            var from = "";
            var to = "";
            if ($("#from_Date").val()) {
                $("#from_Date").jqxDateTimeInput({ formatString: 'yyyy-MM-dd' });
                from = $("#from_Date").val();
                $("#from_Date").jqxDateTimeInput({ formatString: 'dd-MMM-yyyy' });
            }
            if ($("#to_Date").val()) {
                $("#to_Date").jqxDateTimeInput({ formatString: 'yyyy-MM-dd' });
                to = $("#to_Date").val();
                $("#to_Date").jqxDateTimeInput({ formatString: 'dd-MMM-yyyy' });
            }
            window.open("../../Master/Export_To_Excel?FileName=Rework_Rejection_Report&Heading=Rework / Rejection Report&Data=pr_fetch_Rework_Rejection_Report '" + selectedType + "','" + from + "','" + to + "'");
        });

        // =========================================================================
        // Fetch and Render Report Grid
        // =========================================================================
        function getGrid() {
            var selectedType = $('#ddlType').val() || "All";
            var from = "";
            var to = "";

            if ($("#from_Date").val()) {
                $("#from_Date").jqxDateTimeInput({ formatString: 'yyyy-MM-dd' });
                from = $("#from_Date").val();
                $("#from_Date").jqxDateTimeInput({ formatString: 'dd-MMM-yyyy' });
            }
            if ($("#to_Date").val()) {
                $("#to_Date").jqxDateTimeInput({ formatString: 'yyyy-MM-dd' });
                to = $("#to_Date").val();
                $("#to_Date").jqxDateTimeInput({ formatString: 'dd-MMM-yyyy' });
            }

            var url = "../../Reports/pr_fetch_Rework_Rejection_Report?Type=" + encodeURIComponent(selectedType) + "&from=" + encodeURIComponent(from) + "&to=" + encodeURIComponent(to);
            var source = {
                datatype: "json",
                datafields: [
                    { name: 'SNo', type: 'int' },
                    { name: 'FRR_ID', type: 'int' },
                    { name: 'Formation_ID', type: 'string' },
                    { name: 'FRR_QRCode', type: 'string' },
                    { name: 'FRR_BatteryType', type: 'string' },
                    { name: 'FRR_CKTNo', type: 'string' },
                    { name: 'FRR_Formation_ID', type: 'string' },
                    { name: 'FRR_Type_Name', type: 'string' },
                    { name: 'FRR_Reason', type: 'string' },
                    { name: 'FRR_Employee_Name', type: 'string' },
                    { name: 'FRR_Created_By', type: 'string' },
                    { name: 'FRR_Created_Date', type: 'string' },
                    { name: 'FRR_Status', type: 'string' }
                ],
                id: 'FRR_ID',
                url: url,
                async: true
            };
            var dataAdapter = new $.jqx.dataAdapter(source);
            $("#Grid").jqxGrid({
                theme: 'ui-sunny',
                width: '100%',
                autoheight: true,
                source: dataAdapter,
                columnsresize: true,
                pageable: true,
                pagermode: 'simple',
                pagesize: 14,
                showfilterrow: true,
                filterable: true,
                sortable: true,
                enabletooltips: true,
                columns: [
                    { text: 'S.No', datafield: 'SNo', width: '5%', minwidth: 50, align: 'center', cellsalign: 'center' },
                    { text: 'QR Code', datafield: 'FRR_QRCode', width: '12%', minwidth: 110 },
                    { text: 'Battery Type', datafield: 'FRR_BatteryType', width: '10%', minwidth: 95 },
                    { text: 'CKT No', datafield: 'FRR_CKTNo', width: '8%', minwidth: 80 },
                    { text: 'Formation ID', datafield: 'Formation_ID', width: '9%', minwidth: 90, align: 'center', cellsalign: 'center' },
                    {
                        text: 'Type',
                        datafield: 'FRR_Type_Name',
                        width: '9%',
                        minwidth: 85,
                        align: 'center',
                        cellsalign: 'center',
                        cellsrenderer: function (row, column, value) {
                            if (value === "Rework") {
                                return '<div style="margin-top: 5px; text-align: center;"><span class="badge" style="background-color: #f39c12; font-weight: 600;">' + value + '</span></div>';
                            } else if (value === "Rejection") {
                                return '<div style="margin-top: 5px; text-align: center;"><span class="badge" style="background-color: #dd4b39; font-weight: 600;">' + value + '</span></div>';
                            }
                            return '<div style="margin-top: 5px; text-align: center;">' + value + '</div>';
                        }
                    },
                    { text: 'Reason', datafield: 'FRR_Reason', width: '18%', minwidth: 160 },
                    { text: 'Employee', datafield: 'FRR_Employee_Name', width: '12%', minwidth: 120 },
                    { text: 'Date / Time', datafield: 'FRR_Created_Date', width: '10%', minwidth: 120, align: 'center', cellsalign: 'center' },
                    { text: 'Created By', datafield: 'FRR_Created_By', width: '7%', minwidth: 75 }
                ]
            });
        }
    });
</script>
