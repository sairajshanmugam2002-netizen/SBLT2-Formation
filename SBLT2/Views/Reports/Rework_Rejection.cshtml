@{
    ViewBag.Title = "Rework / Rejection Report";
}

<style>
    .filter-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 6px;
        display: inline-block;
    }
    .box-title {
        font-size: 16px;
        font-weight: bold;
        color: #1e395b;
    }

    /* ==========================================================================
       Rework / Rejection Report: Field Block Spacing Standards (Consistent 10px Gap)
       Applied strictly to Rework / Rejection Report page
       ========================================================================== */
    #formReport > .row {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 14px 10px !important; /* 14px vertical gap, 10px horizontal gap between field blocks */
        margin-left: 0 !important;
        margin-right: 0 !important;
        margin-bottom: 0 !important;
        align-items: flex-end !important;
    }

    #formReport > .row:before,
    #formReport > .row:after {
        display: none !important;
        content: none !important;
    }

    #formReport > .row > [class*="col-"] {
        float: none !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        margin-top: 0 !important;
        margin-bottom: 0 !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        box-sizing: border-box !important;
    }

    @@media (min-width: 992px) {
        #formReport > .row > .col-md-3 {
            flex: 0 0 calc((100% - 30px) / 4) !important;
            max-width: calc((100% - 30px) / 4) !important;
            width: calc((100% - 30px) / 4) !important;
        }
    }

    @@media (min-width: 768px) and (max-width: 991px) {
        #formReport > .row > [class*="col-"] {
            flex: 0 0 calc((100% - 10px) / 2) !important;
            max-width: calc((100% - 10px) / 2) !important;
            width: calc((100% - 10px) / 2) !important;
        }
    }

    @@media (max-width: 767px) {
        #formReport > .row > [class*="col-"] {
            flex: 0 0 100% !important;
            max-width: 100% !important;
            width: 100% !important;
        }
    }

    #formReport label.filter-label {
        display: inline-block !important;
        margin-bottom: 6px !important;
        font-size: 12.5px !important;
        font-weight: 600 !important;
        color: var(--text-primary) !important;
    }

    #formReport .form-control {
        width: 100% !important;
        box-sizing: border-box !important;
    }

    #formReport .jqx-widget {
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }
</style>

<div class="content-wrapper">
    <section class="content">
        <div class="row">
            <div class="col-xs-12" style="padding: 10px 15px 0 15px;">
                <div class="box box-primary" style="border-top: 3px solid var(--ar-primary) !important;">
                    <div class="box-header with-border" style="background-color: var(--card-header-bg); padding: 14px 20px;">
                        <h3 class="box-title" style="font-size: 15px; font-weight: 700; color: var(--text-primary);">
                            <i class="fa fa-file-text-o" style="color: var(--ar-primary); margin-right: 6px;"></i>
                            Rework / Rejection Report
                        </h3>
                        <div class="box-tools pull-right" style="display: flex; align-items: center; gap: 8px;">
                            <button type="button" id="btn_Excel" title="Export Report to Excel" class="btn btn-success btn-sm" style="background-color: var(--ar-primary) !important; border-color: var(--ar-primary) !important; color: #FFF !important; min-height: 32px; height: 32px; padding: 4px 14px;">
                                <i class="fa fa-file-excel-o"></i> Export Excel
                            </button>
                            <button type="button" id="btn_Refresh" title="Refresh Report" class="btn btn-box-tool">
                                <span class='fa fa-refresh text-primary'></span>
                            </button>
                        </div>
                    </div>

                    <div class="box-body" style="padding: 18px 20px 12px 20px; background-color: var(--bg-secondary); border-bottom: 1px solid var(--border-color);">
                        <form class="form-horizontal" role="form" id="formReport" onsubmit="return false;">
                            <div class="row">
                                <!-- Filter 1: Type Dropdown -->
                                <div class="col-md-3 col-sm-6" style="margin-bottom: 12px;">
                                    <label for="ddlType" class="filter-label"><i class="fa fa-filter text-muted"></i> Defect Type:</label>
                                    <div id="ddlType"></div>
                                </div>

                                <!-- Filter 2: From Date -->
                                <div class="col-md-3 col-sm-6" style="margin-bottom: 12px;">
                                    <label for="from_Date" class="filter-label"><i class="fa fa-calendar text-muted"></i> From Date:</label>
                                    <div id="from_Date"></div>
                                </div>

                                <!-- Filter 3: To Date -->
                                <div class="col-md-3 col-sm-6" style="margin-bottom: 12px;">
                                    <label for="to_Date" class="filter-label"><i class="fa fa-calendar text-muted"></i> To Date:</label>
                                    <div id="to_Date"></div>
                                </div>

                                <!-- Search & Clear Buttons -->
                                <div class="col-md-3 col-sm-6" style="margin-bottom: 12px; margin-top: 24px; display: flex; gap: 8px;">
                                    <button type="button" id="btnSearch" class="btn btn-primary" style="flex: 1; background-color: var(--ar-primary) !important; border-color: var(--ar-primary) !important; color: #FFFFFF !important;">
                                        <i class="fa fa-search"></i> Search
                                    </button>
                                    <button type="button" id="btnClear" class="btn btn-white btn-warning btn-bold" style="min-width: 80px;">
                                        <i class="fa fa-eraser orange"></i> Clear
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Report Grid Section -->
                    <div class="box-body" style="padding: 16px 20px 20px 20px;">
                        <div style="margin-bottom: 10px;">
                            <h4 style="font-size: 13.5px; font-weight: 700; color: var(--text-primary); margin: 0;">
                                <i class="fa fa-table text-primary"></i> Filtered Defect Logs
                            </h4>
                        </div>
                        <div class="table-wrapper">
                            <div id="Grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit Record Modal -->
        <div class="modal fade" id="editRecordModal" tabindex="-1" role="dialog" aria-labelledby="editRecordModalLabel">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content" style="border-radius: 4px; overflow: hidden; border-top: 3px solid var(--ar-primary);">
                    <div class="modal-header" style="background-color: var(--card-header-bg); padding: 12px 20px;">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="opacity: 0.8;">
                            <span aria-hidden="true">&times;</span>
                        </button>
                        <h4 class="modal-title" id="editRecordModalLabel" style="font-size: 15px; font-weight: 700; color: var(--text-primary); margin: 0;">
                            <i class="fa fa-pencil-square-o" style="color: var(--ar-primary); margin-right: 6px;"></i> Edit Rework / Rejection Record
                        </h4>
                    </div>
                    <div class="modal-body" style="padding: 20px; background-color: var(--bg-primary); max-height: 75vh; overflow-y: auto;">
                        <form id="formEditRecord" class="form-horizontal" onsubmit="return false;">
                            <input type="hidden" id="edit_FRR_ID" />
                            
                            <div class="row">
                                <div class="col-md-4 col-sm-6" style="margin-bottom: 12px;">
                                    <label class="filter-label">Formation ID:</label>
                                    <input type="text" id="edit_Formation_ID" class="form-control input-sm" readonly style="background-color: #eee;" />
                                </div>
                                <div class="col-md-4 col-sm-6" style="margin-bottom: 12px;">
                                    <label class="filter-label">QR Code:</label>
                                    <input type="text" id="edit_QRCode" class="form-control input-sm" readonly style="background-color: #eee;" />
                                </div>
                                <div class="col-md-4 col-sm-6" style="margin-bottom: 12px;">
                                    <label class="filter-label">Battery Type:</label>
                                    <input type="text" id="edit_BatteryType" class="form-control input-sm" readonly style="background-color: #eee;" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 col-sm-6" style="margin-bottom: 12px;">
                                    <label class="filter-label">CKT No:</label>
                                    <input type="text" id="edit_CKTNo" class="form-control input-sm" readonly style="background-color: #eee;" />
                                </div>
                                <div class="col-md-4 col-sm-6" style="margin-bottom: 12px;">
                                    <label class="filter-label">Defect Type:</label>
                                    <select id="edit_TypeName" class="form-control input-sm">
                                        <option value="Rework">Rework</option>
                                        <option value="Rejection">Rejection</option>
                                    </select>
                                </div>
                                <div class="col-md-4 col-sm-6" style="margin-bottom: 12px;">
                                    <label class="filter-label">Employee:</label>
                                    <input type="text" id="edit_EmployeeName" class="form-control input-sm" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 col-sm-6" style="margin-bottom: 12px;">
                                    <label class="filter-label">Defect Reason Type:</label>
                                    <input type="text" id="edit_DefectReasonType" class="form-control input-sm" />
                                </div>
                                <div class="col-md-4 col-sm-6" style="margin-bottom: 12px;">
                                    <label class="filter-label">Defect Reason:</label>
                                    <input type="text" id="edit_Reason" class="form-control input-sm" />
                                </div>
                                <div class="col-md-4 col-sm-6" style="margin-bottom: 12px;">
                                    <label class="filter-label">Defect Code Reason:</label>
                                    <input type="text" id="edit_DefectReason" class="form-control input-sm" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 col-sm-6" style="margin-bottom: 12px;">
                                    <label class="filter-label">Defect Cell:</label>
                                    <input type="text" id="edit_DefectCell" class="form-control input-sm" />
                                </div>
                                <div class="col-md-4 col-sm-6" style="margin-bottom: 12px;">
                                    <label class="filter-label">OCV:</label>
                                    <input type="text" id="edit_OCV" class="form-control input-sm" />
                                </div>
                                <div class="col-md-4 col-sm-6" style="margin-bottom: 12px;">
                                    <label class="filter-label">Plate No:</label>
                                    <input type="text" id="edit_PlateNo" class="form-control input-sm" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 col-sm-6" style="margin-bottom: 12px;">
                                    <label class="filter-label">Location:</label>
                                    <input type="text" id="edit_Location" class="form-control input-sm" />
                                </div>
                                <div class="col-md-4 col-sm-6" style="margin-bottom: 12px;">
                                    <label class="filter-label">Plate Type:</label>
                                    <input type="text" id="edit_PlateType" class="form-control input-sm" />
                                </div>
                                <div class="col-md-4 col-sm-6" style="margin-bottom: 12px;">
                                    <label class="filter-label">Created By:</label>
                                    <input type="text" id="edit_CreatedBy" class="form-control input-sm" readonly style="background-color: #eee;" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-2 col-xs-4" style="margin-bottom: 10px;">
                                    <label class="filter-label">Cell 1:</label>
                                    <input type="text" id="edit_Cell1" class="form-control input-sm" />
                                </div>
                                <div class="col-md-2 col-xs-4" style="margin-bottom: 10px;">
                                    <label class="filter-label">Cell 2:</label>
                                    <input type="text" id="edit_Cell2" class="form-control input-sm" />
                                </div>
                                <div class="col-md-2 col-xs-4" style="margin-bottom: 10px;">
                                    <label class="filter-label">Cell 3:</label>
                                    <input type="text" id="edit_Cell3" class="form-control input-sm" />
                                </div>
                                <div class="col-md-2 col-xs-4" style="margin-bottom: 10px;">
                                    <label class="filter-label">Cell 4:</label>
                                    <input type="text" id="edit_Cell4" class="form-control input-sm" />
                                </div>
                                <div class="col-md-2 col-xs-4" style="margin-bottom: 10px;">
                                    <label class="filter-label">Cell 5:</label>
                                    <input type="text" id="edit_Cell5" class="form-control input-sm" />
                                </div>
                                <div class="col-md-2 col-xs-4" style="margin-bottom: 10px;">
                                    <label class="filter-label">Cell 6:</label>
                                    <input type="text" id="edit_Cell6" class="form-control input-sm" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 col-sm-12" style="margin-bottom: 10px;">
                                    <label class="filter-label">Date / Time:</label>
                                    <input type="text" id="edit_CreatedDate" class="form-control input-sm" readonly style="background-color: #eee;" />
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer" style="padding: 12px 20px; background-color: var(--card-header-bg);">
                        <button type="button" id="btn_UpdateRecord" class="btn btn-primary btn-sm" style="background-color: var(--ar-primary) !important; border-color: var(--ar-primary) !important; color: #FFF !important; min-width: 90px;">
                            <i class="fa fa-save"></i> Update
                        </button>
                        <button type="button" class="btn btn-default btn-sm" data-dismiss="modal" style="min-width: 80px;">
                            <i class="fa fa-times"></i> Close
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        // Highlight active sidebar menu
        $("#Report").addClass("active");
        $("#Reports").addClass("active");
        $("#Rework_Rejection_Report").addClass("active");

        // Initialize Date Filters (Defaults to today)
        $("#from_Date").jqxDateTimeInput({ width: '100%', height: '30px', formatString: 'dd-MMM-yyyy' });
        $("#to_Date").jqxDateTimeInput({ width: '100%', height: '30px', formatString: 'dd-MMM-yyyy' });

        // Set default date range: first day of current month to today
        var now = new Date();
        var firstDayOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
        $("#from_Date").jqxDateTimeInput('setDate', firstDayOfMonth);
        $("#to_Date").jqxDateTimeInput('setDate', now);

        // =========================================================================
        // Initialize Type Dropdown with Options: All, Rework, Rejection
        // Default selected: All
        // =========================================================================
        var typeOptions = ['All', 'Rework', 'Rejection'];
        $("#ddlType").jqxDropDownList({
            source: typeOptions,
            selectedIndex: 0,
            width: '100%',
            height: '30px',
            autoDropDownHeight: true
        });

        // Filter Grid whenever Type dropdown changes
        $("#ddlType").on('change', function (event) {
            getGrid();
        });

        // Load Grid initially
        getGrid();

        // Search Button click
        $("#btnSearch").click(function () {
            getGrid();
        });

        // Clear Button click: resets Type to 'All' and reloads grid
        $("#btnClear").click(function () {
            $("#ddlType").jqxDropDownList('selectIndex', 0);
            $("#from_Date").jqxDateTimeInput('setDate', firstDayOfMonth);
            $("#to_Date").jqxDateTimeInput('setDate', now);
            getGrid();
        });

        // Refresh Button in header
        $("#btn_Refresh").click(function () {
            getGrid();
        });

        function formatDateToYMD(d) {
            if (!d) return "";
            if (typeof d === "string") {
                d = new Date(d);
            }
            if (isNaN(d.getTime())) return "";
            var y = d.getFullYear();
            var m = ('0' + (d.getMonth() + 1)).slice(-2);
            var day = ('0' + d.getDate()).slice(-2);
            return y + '-' + m + '-' + day;
        }

        // Export to Excel Button
        $("#btn_Excel").click(function () {
            var selectedType = $('#ddlType').val() || "All";
            var from = formatDateToYMD($("#from_Date").jqxDateTimeInput('getDate'));
            var to = formatDateToYMD($("#to_Date").jqxDateTimeInput('getDate'));
            window.open("../../Master/Export_To_Excel?FileName=Rework_Rejection_Report&Heading=Rework / Rejection Report&Data=pr_fetch_Rework_Rejection_Report '" + selectedType + "','" + from + "','" + to + "'");
        });

        // =========================================================================
        // Fetch and Render Report Grid
        // =========================================================================
        function getGrid() {
            var selectedType = $('#ddlType').val() || "All";
            var from = formatDateToYMD($("#from_Date").jqxDateTimeInput('getDate'));
            var to = formatDateToYMD($("#to_Date").jqxDateTimeInput('getDate'));

            var url = "../../Reports/pr_fetch_Rework_Rejection_Report?Type=" + encodeURIComponent(selectedType) + "&from=" + encodeURIComponent(from) + "&to=" + encodeURIComponent(to);
            var source = {
                datatype: "json",
                datafields: [
                    { name: 'SNo', type: 'int' },
                    { name: 'FRR_ID', type: 'int' },
                    { name: 'Formation_ID', type: 'string' },
                    { name: 'FRR_QRCode', type: 'string' },
                    { name: 'FRR_BatteryType', type: 'string' },
                    { name: 'FRR_CKTNo', type: 'string' },
                    { name: 'FRR_Formation_ID', type: 'string' },
                    { name: 'FRR_Type_Name', type: 'string' },
                    { name: 'FRR_DefectReasonType', type: 'string' },
                    { name: 'FRR_DefectReason', type: 'string' },
                    { name: 'FRR_Reason', type: 'string' },
                    { name: 'FRR_Employee_Name', type: 'string' },
                    { name: 'FRR_Created_By', type: 'string' },
                    { name: 'FRR_Created_Date', type: 'string' },
                    { name: 'FRR_Status', type: 'string' },
                    { name: 'FRR_Cell1', type: 'string' },
                    { name: 'FRR_Cell2', type: 'string' },
                    { name: 'FRR_Cell3', type: 'string' },
                    { name: 'FRR_Cell4', type: 'string' },
                    { name: 'FRR_Cell5', type: 'string' },
                    { name: 'FRR_Cell6', type: 'string' },
                    { name: 'FRR_DefectCell', type: 'string' },
                    { name: 'FRR_OCV', type: 'string' },
                    { name: 'FRR_PlateNo', type: 'string' },
                    { name: 'FRR_Location', type: 'string' },
                    { name: 'FRR_PlateType', type: 'string' }
                ],
                id: 'FRR_ID',
                url: url,
                async: true
            };
            var dataAdapter = new $.jqx.dataAdapter(source);
            $("#Grid").jqxGrid({
                theme: 'ui-sunny',
                width: '100%',
                autoheight: true,
                source: dataAdapter,
                columnsresize: true,
                pageable: true,
                pagermode: 'simple',
                pagesize: 14,
                showfilterrow: true,
                filterable: true,
                sortable: true,
                enabletooltips: true,
                columns: [
                    { text: 'S.No', datafield: 'SNo', width: 50, align: 'center', cellsalign: 'center' },
                    { text: 'QR Code', datafield: 'FRR_QRCode', width: 110 },
                    { text: 'Battery Type', datafield: 'FRR_BatteryType', width: 95 },
                    { text: 'CKT No', datafield: 'FRR_CKTNo', width: 80 },
                    { text: 'Formation ID', datafield: 'Formation_ID', width: 90, align: 'center', cellsalign: 'center' },
                    {
                        text: 'Type',
                        datafield: 'FRR_Type_Name',
                        width: 90,
                        align: 'center',
                        cellsalign: 'center',
                        cellsrenderer: function (row, column, value) {
                            var textVal = value || '';
                            var bg = '#777';
                            if (textVal === "Rework") {
                                bg = '#f39c12';
                            } else if (textVal === "Rejection") {
                                bg = '#dd4b39';
                            }
                            return '<div style="margin-top: 5px; text-align: center;"><span style="display: inline-block; width: 72px; padding: 3px 0; border-radius: 12px; font-size: 11.5px; font-weight: 600; color: #fff; background-color: ' + bg + '; text-align: center; box-shadow: 0 1px 2px rgba(0,0,0,0.12);">' + textVal + '</span></div>';
                        }
                    },
                    { text: 'Defect Reason', datafield: 'FRR_Reason', width: 140 },
                    { text: 'Defect Code Reason', datafield: 'FRR_DefectReason', width: 150 },
                    { text: 'Employee', datafield: 'FRR_Employee_Name', width: 110 },
                    { text: 'Defect Cell', datafield: 'FRR_DefectCell', width: 85, align: 'center', cellsalign: 'center' },
                    { text: 'OCV', datafield: 'FRR_OCV', width: 75, align: 'center', cellsalign: 'center' },
                    { text: 'Plate No', datafield: 'FRR_PlateNo', width: 75, align: 'center', cellsalign: 'center' },
                    { text: 'Location', datafield: 'FRR_Location', width: 75, align: 'center', cellsalign: 'center' },
                    { text: 'Plate Type', datafield: 'FRR_PlateType', width: 110 },
                    { text: 'Cell 1', datafield: 'FRR_Cell1', width: 65, align: 'center', cellsalign: 'center' },
                    { text: 'Cell 2', datafield: 'FRR_Cell2', width: 65, align: 'center', cellsalign: 'center' },
                    { text: 'Cell 3', datafield: 'FRR_Cell3', width: 65, align: 'center', cellsalign: 'center' },
                    { text: 'Cell 4', datafield: 'FRR_Cell4', width: 65, align: 'center', cellsalign: 'center' },
                    { text: 'Cell 5', datafield: 'FRR_Cell5', width: 65, align: 'center', cellsalign: 'center' },
                    { text: 'Cell 6', datafield: 'FRR_Cell6', width: 65, align: 'center', cellsalign: 'center' },
                    { text: 'Date / Time', datafield: 'FRR_Created_Date', width: 120, align: 'center', cellsalign: 'center' },
                    { text: 'Created By', datafield: 'FRR_Created_By', width: 75 }
                ]
            });
        }

        // =========================================================================
        // Delete Record Action
        // Prompts confirmation, executes delete, refreshes grid & alerts
        // =========================================================================
        function deleteRecord(dataRecord) {
            var recordId = dataRecord.FRR_ID || dataRecord.ID;
            if (!recordId) {
                alert("Invalid Record ID.");
                return;
            }

            var confirmDelete = confirm("Are you sure want to delete press OK");
            if (confirmDelete === true) {
                $.ajax({
                    type: 'POST',
                    contentType: "application/json; charset=utf-8",
                    url: '../../Transaction/Pr_Delete_Formation_Rework_Rejection',
                    data: JSON.stringify({ ID: recordId }),
                    success: function (response) {
                        getGrid();
                        alert('Record Deleted Successfully');
                    },
                    error: function (xhr, status, error) {
                        // Fallback attempt to Reports controller if routed there
                        $.ajax({
                            type: 'POST',
                            contentType: "application/json; charset=utf-8",
                            url: '../../Reports/Pr_Delete_Formation_Rework_Rejection',
                            data: JSON.stringify({ ID: recordId }),
                            success: function (response) {
                                getGrid();
                                alert('Record Deleted Successfully');
                            },
                            error: function () {
                                alert('Record delete failed. Please ensure the backend stored procedure pr_delete_Formation_Rework_Rejection exists in the database.');
                            }
                        });
                    }
                });
            }
        }

        // =========================================================================
        // Open Edit Modal with Row Data Pre-Populated (Preserves all fields)
        // =========================================================================
        function openEditModal(dataRecord) {
            $('#edit_FRR_ID').val(dataRecord.ID || dataRecord.FRR_ID || '');
            $('#edit_Formation_ID').val(dataRecord.Formation_ID || '');
            $('#edit_QRCode').val(dataRecord.QRCode || dataRecord.FRR_QRCode || '');
            $('#edit_BatteryType').val(dataRecord.BatteryType || dataRecord.FRR_BatteryType || '');
            $('#edit_CKTNo').val(dataRecord.CKTNo || dataRecord.FRR_CKTNo || '');
            $('#edit_TypeName').val(dataRecord.Type_Name || dataRecord.FRR_Type_Name || 'Rework');
            $('#edit_Reason').val(dataRecord.Reason || dataRecord.FRR_Reason || '');
            $('#edit_DefectReasonType').val(dataRecord.DefectReasonType || dataRecord.FRR_DefectReasonType || '');
            $('#edit_DefectReason').val(dataRecord.DefectReason || dataRecord.FRR_DefectReason || '');
            $('#edit_EmployeeName').val(dataRecord.Employee_Name || dataRecord.FRR_Employee_Name || '');
            $('#edit_DefectCell').val(dataRecord.DefectCell || dataRecord.FRR_DefectCell || '');
