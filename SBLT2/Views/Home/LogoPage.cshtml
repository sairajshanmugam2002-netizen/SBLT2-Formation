@{
    ViewBag.Title = "LogoPage";
}

<script type="text/javascript">
    $(document).ready(function() {
        var ID = 0;
        var User = sessionStorage.getItem("user");
        
        var url = "Pr_Fetch_LogoPage";
        var source = {
            datatype: "json",
            datafields: [{
                name: 'LP_id',
                type: 'string'
            }, {
                name: 'LP_Heading1',
                    type: 'string'
                },
                {
                    name: 'LP_Heading2',
                    type: 'string'
                },
                {
                    name: 'LP_CreatedBy',
                    type: 'string'
                },
                {
                    name: 'LP_image',
                    type: 'string'
                },
                
            ],
            id: 'id',
            url: url
        };
        var dataAdapter = new $.jqx.dataAdapter(source);
        $("#Grid").jqxGrid({
            theme: 'ui-sunny',
            width: '100%',
            height: '480px',
            source: dataAdapter,
            columnsresize: true,
            pageable: true,
            enabletooltips: false,
            pagermode: 'simple',
            enabletooltips: true,
            showfilterrow: true,
            filterable: true,
            pagesize: 14,
            columns: [{
                text: 'LP_image',
                    datafield: 'LP_image',
                    width: '100px',
                    hidden: true
            }, {
                text: 'LP_id',
                datafield: 'LP_id',
                width: '100px',
                hidden: true
            },{
                    text: 'Heding 1',
                    datafield: 'LP_Heading1'
                },
                {
                    text: 'Heading 2',
                    datafield: 'LP_Heading2'
                },
                {
                    text: 'Created By',
                    datafield: 'LP_CreatedBy',
                    width: '10%'
                }, {
                    text: 'View',
                    datafield: 'View',
                    columntype: 'button',
                    width: '50px',
                    cellsrenderer: function () {
                        return "View";
                    },
                    buttonclick: function (row) {
                        var dataRecord = $("#Grid").jqxGrid('getrowdata', row);

                        window.open("../../" + dataRecord.LP_image);
                    }
                }, {
                    text: 'Edit',
                    datafield: 'Edit',
                    filterable: false,
                    width: 40,
                    cellsrenderer: function() {
                        return '<div style="width: 100%"><img src="../../../img/Edit1.png" style="margin-left: 25%" /></div>';
                    }
                },
                {
                    text: 'Del',
                    datafield: 'delete',
                    filterable: false,
                    width: 40,
                    cellsrenderer: function() {
                        return '<div style="width: 100%"><img src="../../../img/del.png" style="margin-left: 25%" /></div>';
                    }
                },
            ]
        });
        $("#Grid").on("cellclick", function(event) {
            var column = event.args.column;
            var rowindex = event.args.rowindex;
            var columnindex = event.args.columnindex;
            if (columnindex == 6) {

                editrow = rowindex;
                var dataRecord = $("#Grid").jqxGrid('getrowdata', editrow);
                ID = dataRecord.LP_id;
              
                var url = "Pr_Fetch_LogoPage_ById?Id=" + ID;
                var source = {
                    datatype: "json",
                    datafields: [{
                        name: 'LP_Heading1',
                            type: 'string'
                        },
                        {
                            name: 'LP_Heading2',
                            type: 'string'
                        },
                        
                    ],
                    id: 'id',
                    url: url
                };
                var dataAdapter_per = new $.jqx.dataAdapter(source, {
                    contentType: 'application/json; charset=utf-8',
                    loadComplete: function() {
                        var length = dataAdapter_per.records.length;
                        var records = dataAdapter_per.records;
                        var record = records[0];
                        $('#LP_Heading1').val(record.LP_Heading1);
                        $('#LP_Heading2').val(record.LP_Heading2);
                        ;
                        $("#btn_save_label").text('Update');
                        $('#myModal').modal('show');
                    },
                    error: function(xhr, status, error) {
                        alert(JSON.stringify(xhr));
                    }
                })
                dataAdapter_per.dataBind();
            }
            if (columnindex == 7) {               
                editrow = rowindex;
                var dataRecord = $("#Grid").jqxGrid('getrowdata', editrow);
                var id = dataRecord.UM_iID;
                var a = confirm("Are you sure want to delete press OK");
                if(a == true) {
                    $.ajax({
                        type: 'POST',
                        contentType: "application/json; charset=utf-8",
                        url: 'Pr_delete_LogoPage',
                        data: "{'ID':'" + dataRecord.LP_id + "'}",
                        async: false,
                        success: function(response) {
                            $("#Grid").jqxGrid('updatebounddata');
                            alert('Record Deleted Success');
                        },
                        error: function() {
                            console.log('there is some error');
                        }
                    });
                }
            }
        });


        //$('#form1').jqxValidator({
        //    hintType: 'label',
        //    animationDuration: 2,
        //    rules: [{
        //        input: '#UM_vPhone_Number',
        //        message: 'Phone Number Required..!',
        //        action: 'keyup, blur',
        //        rule: function (input) {
        //            if ($("#UM_vPhone_Number").val() == "") return false; else return true;
        //        },
        //        focus: true
        //    }, {
        //        input: '#UM_vPassword',
        //        message: 'Password Required..!',
        //        action: 'keyup, blur',
        //        rule: 'required',
        //        focus: true
        //    }, {
        //        input: '#UM_vC_Password',
        //        message: 'Conform Password Required..!',
        //        action: 'keyup, blur',
        //        rule: 'required',
        //        focus: true
        //    }, {
        //        input: '#UM_vEmail_ID',
        //        message: 'Email Id Required..!',
        //        action: 'keyup, blur',
        //        rule: 'required',
        //        focus: true
        //    }, ]
        //});
        //var flag = false;
        //var flag = false;
        //$('#form1').on('validationSuccess', function(event) {
        //    flag = true;
        //});


        $("#btn_Save").click(function() {
            //$('#form1').jqxValidator('validate');
            //if(flag == true) {

           
            if ($("#btn_save_label").text() == "Save") {
                Upload_Document();
            }
            else {
                Upload_Document_Update();
            }
            //    flag = false;
            //}
        });

        function Upload_Document() {
        //    alert("hii");
            var data = new FormData();
            var files = $("#LP_image").get(0).files;
            if (files.length > 0) {
                data.append("MyImages", files[0]);
                // alert("hii");
            }
            $.ajax({
                url: "Pr_Insert_LogoPage?LP_Heading1=" + $('#LP_Heading1').val() + "&LP_Heading2=" + $('#LP_Heading2').val() + "&LP_CreatedBy=" + User,
                type: "POST",
                processData: false,
                contentType: false,
                data: data,
                async: false,
                success: function (response) {

                    if (response == 'True') {
                        alert("Record Saved Successfully...!");
                        $("#Grid").jqxGrid('updatebounddata');
                        Clear();

                    } else {
                        alert(response)
                    }
                },
                error: function (er) {
                    alert(er.responseText);
                }

            });
        }

        function Upload_Document_Update() {
          
            var data = new FormData();
            var files = $("#LP_image").get(0).files;
            if (files.length > 0) {
                data.append("MyImages", files[0]);
                // alert("hii");
            }
            $.ajax({
                url: "Pr_Update_LogoPage?LP_Heading1=" + $('#LP_Heading1').val() + "&LP_Heading2=" + $('#LP_Heading2').val() + "&LP_CreatedBy=" + User + "&LP_id=" + ID,
                type: "POST",
                processData: false,
                contentType: false,
                data: data,
                async: false,
                success: function (response) {

                    if (response == 'True') {
                        alert("Record Saved Successfully...!");
                        $("#Grid").jqxGrid('updatebounddata');
                        
                        $('#myModal').modal('hide');

                    } else {
                        alert(response)
                    }
                },
                error: function (er) {
                    alert(er.responseText);
                }

            });
        }


      
        function Clear() {
            $('#LP_Heading2').val('');
            $('#LP_Heading1').val('');
             
            flag = false;
        }
        $("#btn_AddNew").click(function() {
            $("#btn_save_label").text('Save');
            Clear();
        })
        $("#sidebar-collapse").click(function() {
            $("#Grid").jqxGrid('updatebounddata');
        });
        $("#btn_Clear").click(function() {
            Clear();
        })
        $("#btn_Refresh").click(function() {
            $("#Grid").jqxGrid('updatebounddata');
        })
        $("#btn_Excel").click(function () {
            window.open("../../Master/Export_To_Excel?FileName=User_Master&Heading=User Master&Data=Pr_Fetch_User_Master_Details_Excel");

        })

        $("#Master").addClass("active");
        $("#User_Master").addClass("active");

        $("#btn_Pdf").click(function() {})
        $("#btn_Chart").click(function() {})
        $("#btn_Help").click(function() {})
    });
</script>



<div class="content-wrapper">
    <section class="content">
        <div class="row">
            <div class="col-xs-12" style="padding:5px;  padding-top:0px">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">Logo Master</h3>
                        <div class="box-tools pull-right">
                            <button type="button" id="btn_AddNew" title="Add New" data-rel="tooltip" class="btn btn-box-tool" data-toggle="modal" data-target="#myModal" style="padding:5px"><span class='fa fa fa-plus-square  bigger-130 green'></span></button>
                            <button type="button" id="btn_Refresh" title="Refresh" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-refresh bigger-130 vilote'></span></button>
                            <button type="button" id="btn_Excel" title="Export to Excel" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-file-excel-o bigger-130 green'></span></button>
                            @*<button type="button" id="btn_Pdf" title="Export to Pdf" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-file-pdf-o bigger-130 red'> </span></button>*@
                        </div>
                        <!-- /.nav-search -->
                    </div>
                    <div class="box-body">
                        <div class="col-md-12" style="padding-left:0px; padding-right:0px">
                            <div id="Grid"></div>
                        </div>
                    </div>
                </div>
                <div class="modal fade" id="myModal">
                    <div class="modal-dialog">  
                        <div>
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title">Logo Master <span class="pull-right ">
                                            <a href="#" data-dismiss="modal" aria-label="Close">
                                                <i class="ace-icon fa fa-times"></i>
                                            </a>
                                        </span> </h3>
                                </div>
                                <div class="panel-body">
                                    <form class="form-horizontal" role="form" id="form1">
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label no-padding-right" for="form-field-1">Heading1</label>
                                            <div class="col-sm-7">
                                                <textarea id="LP_Heading1" class="form-control" rows="2" placeholder="Enter Heading Here ......"></textarea>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label no-padding-right" for="form-field-1">Heading2</label>
                                            <div class="col-sm-7">
                                                <textarea id="LP_Heading2" class="form-control" rows="2" placeholder="Enter Heading Here ......"></textarea>
                                            </div>
                                        </div>
                                         
                                      <div class="form-group">
                                            <label class="col-sm-4 control-label no-padding-right" for="form-field-1">File&nbsp;Name</label>
                                            <div class="col-sm-6">
                                                <input id="LP_image" type="file" />
                                            </div>
                                        </div>
                                    </form>
                                    <div class="col-sm-5"></div>
                                    <p>
                                        <button id="btn_Save" class="btn btn-white btn-info btn-bold">
                                            <i class="ace-icon fa fa-floppy-o bigger-120 blue"></i>
                                            <span id="btn_save_label">Save</span>
                                        </button>
                                        <button id="btn_Clear" class="btn btn-white btn-warning btn-bold">
                                            <i class="ace-icon fa fa-trash-o bigger-120 orange"></i>
                                            Clear
                                        </button>
                                        <button class="btn btn-white btn-default btn-round" data-dismiss="modal">
                                            <i class="ace-icon fa fa-times red2"></i>
                                            Close
                                        </button>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
