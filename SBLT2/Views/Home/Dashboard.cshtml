
@{
    /**/
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">
    $(document).ready(function () {
        var ID = 0;
        var User = sessionStorage.getItem("Plant");

        //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });

        function sumAge() {
            //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });
            var url = "pr_fetch_AgeWiseInventory_Chart_Sum?ID=" + $('#DateTime').val();
            //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'Qty', type: 'string' },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source, {
                contentType: 'application/json; charset=utf-8',
                loadComplete: function () {
                    var length = dataAdapter.records.length;
                    flag = false;
                    var records = dataAdapter.records;
                    var record = records[0];
                    $('#TotalQty_Age').val(record.Qty);
                },
                error: function (xhr, status, error) {
                    alert(JSON.stringify(xhr));
                }
            });
            dataAdapter.dataBind();
        }
        function sumMat() {
            //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });
            var url = "pr_fetch_MaterialWiseInventory_Chart_Sum?ID=" + $('#DateTime').val();
            //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'TotalMat', type: 'string' },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source, {
                contentType: 'application/json; charset=utf-8',
                loadComplete: function () {
                    var length = dataAdapter.records.length;
                    flag = false;
                    var records = dataAdapter.records;
                    var record = records[0];
                    $('#TotalQty_Mat').val(record.TotalMat);
                },
                error: function (xhr, status, error) {
                    alert(JSON.stringify(xhr));
                }
            });
            dataAdapter.dataBind();
        }

        // ==========================================================================
        // Modern Enterprise Donut Chart Renderer (Passed & Failed Analytics)
        // ==========================================================================
        function renderModernDonutChart(containerSelector, apiUrl, chartType) {
            var $container = $(containerSelector);
            if (!$container.length) return;

            var passedPalette = [
                '#10B981', // 1. Green
                '#06B6D4', // 2. Teal / Cyan
                '#F59E0B', // 3. Yellow
                '#3B82F6', // 4. Blue
                '#8B5CF6', // 5. Purple
                '#EC4899', // 6. Pink
                '#6366F1', // 7. Indigo
                '#059669', // 8. Emerald
                '#F97316', // 9. Orange
                '#14B8A6'  // 10. Teal
            ];
            var failedPalette = [
                '#EF4444', // 1. Red
                '#F97316', // 2. Orange
                '#F59E0B', // 3. Yellow
                '#3B82F6', // 4. Blue
                '#8B5CF6', // 5. Purple
                '#EC4899', // 6. Pink
                '#DC2626', // 7. Crimson
                '#D97706', // 8. Amber
                '#7C3AED', // 9. Violet
                '#FB7185'  // 10. Rose
            ];
            var palette = (chartType === 'passed') ? passedPalette : failedPalette;
            var isFailed = (chartType === 'failed');

            $.ajax({
                type: "GET",
                url: apiUrl,
                dataType: "text",
                cache: false,
                success: function (response) {
                    var rawData = [];
                    try {
                        rawData = JSON.parse(response);
                        if (rawData && rawData.record && Array.isArray(rawData.record)) {
                            rawData = rawData.record;
                        }
                    } catch (e) {
                        rawData = [];
                    }

                    // Process and sanitize records
                    var items = [];
                    var total = 0;
                    if (Array.isArray(rawData)) {
                        for (var i = 0; i < rawData.length; i++) {
                            var r = rawData[i];
                            if (!r) continue;
                            var type = (r.mv_BatteryType || r.BatteryType || r.type || ('Type ' + (i + 1))).toString().trim();
                            var qty = parseInt(r.Qty || r.qty || 0, 10);
                            if (isNaN(qty) || qty < 0) qty = 0;
                            if (qty > 0) {
                                items.push({ type: type, qty: qty });
                                total += qty;
                            }
                        }
                    }

                    // Graceful Zero / No Data State
                    if (items.length === 0 || total === 0) {
                        $container.html(
                            '<div class="donut-empty-container">' +
                                '<div class="donut-empty-icon"><i class="fa fa-pie-chart"></i></div>' +
                                '<div class="donut-empty-text">No data available</div>' +
                                '<div class="donut-empty-sub">No ' + (isFailed ? 'failed' : 'passed') + ' batteries recorded for current shift</div>' +
                            '</div>'
                        );
                        return;
                    }

                    // SVG Donut Ring Geometry: Circular donut with clean inner center and background track
                    var cx = 120, cy = 120, r = 78, strokeW = 30;
                    var C = 2 * Math.PI * r;
                    var svgPaths = '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="none" ' +
                        'stroke="var(--border-color, #e2e8f0)" stroke-width="' + strokeW + '" opacity="0.22" class="donut-track" />';
                    var percentLabelsSvg = '';
                    var tableRowsHtml = '';
                    var accumulatedOffset = 0;
                    var gap = items.length > 1 ? 4 : 0;

                    for (var k = 0; k < items.length; k++) {
                        var itm = items[k];
                        var pctVal = (itm.qty / total);
                        var pctStr = (pctVal * 100).toFixed(1) + '%';
                        var segColor = palette[k % palette.length];
                        var safeType = $('<div>').text(itm.type).html();

                        if (items.length === 1) {
                            svgPaths += '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="none" ' +
                                'stroke="' + segColor + '" stroke-width="' + strokeW + '" ' +
                                'class="donut-segment" data-index="' + k + '" />';
                            percentLabelsSvg += '<text x="' + (cx + r) + '" y="' + (cy + 3.5) + '" ' +
                                'class="donut-segment-pct" text-anchor="middle" data-index="0">100.0%</text>';
                        } else {
                            var segLength = pctVal * C;
                            var visibleLen = Math.max(1, segLength - gap);
                            var remainingLen = C - visibleLen;
                            var dashArr = visibleLen.toFixed(2) + ' ' + remainingLen.toFixed(2);
                            var dashOff = (-accumulatedOffset).toFixed(2);

                            svgPaths += '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="none" ' +
                                'stroke="' + segColor + '" stroke-width="' + strokeW + '" ' +
                                'stroke-dasharray="' + dashArr + '" stroke-dashoffset="' + dashOff + '" ' +
                                'transform="rotate(-90 ' + cx + ' ' + cy + ')" ' +
                                'class="donut-segment" data-index="' + k + '" />';

                            // Calculate midpoint of segment arc for percentage label on ring
                            var midFraction = (accumulatedOffset + (segLength / 2)) / C;
                            var midAngle = (midFraction * 2 * Math.PI) - (Math.PI / 2);
                            var labelX = cx + r * Math.cos(midAngle);
                            var labelY = cy + r * Math.sin(midAngle) + 3.5;

                            if (pctVal >= 0.05) {
                                percentLabelsSvg += '<text x="' + labelX.toFixed(1) + '" y="' + labelY.toFixed(1) + '" ' +
                                    'class="donut-segment-pct" text-anchor="middle" data-index="' + k + '">' + pctStr + '</text>';
                            }

                            accumulatedOffset += segLength;
                        }

                        tableRowsHtml +=
                            '<tr class="donut-table-row" data-index="' + k + '">' +
                                '<td class="td-type">' +
                                    '<span class="donut-table-dot" style="background-color:' + segColor + ';"></span>' +
                                    '<span class="donut-table-name" title="' + safeType + '">' + safeType + '</span>' +
                                '</td>' +
                                '<td class="td-qty">' + itm.qty.toLocaleString() + '</td>' +
                                '<td class="td-pct">' + pctStr + '</td>' +
                            '</tr>';
                    }

                    var subLabel = isFailed ? 'Failed Qty' : 'Passed Qty';
                    var totalNumFontSize = total >= 100000 ? '19px' : '22px';
                    var centerSvg =
                        '<circle cx="' + cx + '" cy="' + cy + '" r="' + (r - strokeW / 2) + '" class="donut-center-bg" />' +
                        '<g class="donut-center-group">' +
                            '<text x="' + cx + '" y="' + (cy - 16) + '" class="donut-center-label">TOTAL</text>' +
                            '<text x="' + cx + '" y="' + (cy + 7) + '" class="donut-center-num" style="font-size:' + totalNumFontSize + ';">' + total.toLocaleString() + '</text>' +
                            '<text x="' + cx + '" y="' + (cy + 24) + '" class="donut-center-sub">' + subLabel + '</text>' +
                        '</g>';

                    var cardClass = 'modern-donut-card' + (isFailed ? ' donut-failed-card' : '');
                    var html =
                        '<div class="' + cardClass + '">' +
                            '<div class="donut-visual-col">' +
                                '<svg class="donut-svg" viewBox="0 0 240 240">' +
                                    svgPaths +
                                    centerSvg +
                                    percentLabelsSvg +
                                '</svg>' +
                            '</div>' +
                            '<div class="donut-table-col">' +
                                '<div class="donut-table-wrapper">' +
                                    '<table class="donut-details-table">' +
                                        '<thead>' +
                                            '<tr>' +
                                                '<th class="th-type">Battery Type</th>' +
                                                '<th class="th-qty">Qty</th>' +
                                                '<th class="th-pct">%</th>' +
                                            '</tr>' +
                                        '</thead>' +
                                        '<tbody>' +
                                            tableRowsHtml +
                                        '</tbody>' +
                                    '</table>' +
                                '</div>' +
                            '</div>' +
                            '<div class="donut-tooltip" style="display:none;"></div>' +
                        '</div>';

                    $container.html(html);

                    // Setup Tooltip & Interactivity
                    var $tooltip = $container.find('.donut-tooltip');

                    function positionTooltip(e) {
                        var cOffset = $container.offset();
                        var x = e.pageX - cOffset.left + 14;
                        var y = e.pageY - cOffset.top - 24;

                        var ttW = $tooltip.outerWidth();
                        var ttH = $tooltip.outerHeight();
                        var cW = $container.width();
                        var cH = $container.height();

                        if (x + ttW > cW - 8) {
                            x = e.pageX - cOffset.left - ttW - 14;
                        }
                        if (x < 8) x = 8;
                        if (y + ttH > cH - 8) {
                            y = cH - ttH - 8;
                        }
                        if (y < 8) y = 8;

                        $tooltip.css({ left: x + 'px', top: y + 'px' });
                    }

                    $container.find('.donut-segment, .donut-table-row, .donut-segment-pct').on('mouseenter', function (e) {
                        var idx = parseInt($(this).attr('data-index'), 10);
                        if (isNaN(idx) || !items[idx]) return;

                        var itm = items[idx];
                        var col = palette[idx % palette.length];
                        var pct = ((itm.qty / total) * 100).toFixed(1) + '%';
                        var safeType = $('<div>').text(itm.type).html();

                        $container.find('.donut-segment').each(function () {
                            if ($(this).attr('data-index') == idx) {
                                $(this).css({ 'stroke-width': '36px', 'opacity': '1' });
                            } else {
                                $(this).css({ 'stroke-width': '30px', 'opacity': '0.35' });
                            }
                        });

                        $container.find('.donut-table-row').removeClass('active');
                        $container.find('.donut-table-row[data-index="' + idx + '"]').addClass('active');

                        var ttContent =
                            '<div class="donut-tt-header">' +
                                '<span class="donut-tt-dot" style="background-color:' + col + ';"></span>' +
                                safeType +
                            '</div>' +
                            '<div class="donut-tt-body">' +
                                '<div><span class="donut-tt-lbl">Battery Type:</span><span class="donut-tt-val">' + safeType + '</span></div>' +
                                '<div><span class="donut-tt-lbl">Qty:</span><span class="donut-tt-val">' + itm.qty.toLocaleString() + '</span></div>' +
                                '<div><span class="donut-tt-lbl">Percentage:</span><span class="donut-tt-val">' + pct + '</span></div>' +
                            '</div>';

                        $tooltip.html(ttContent).stop(true, true).fadeIn(120);
                        positionTooltip(e);
                    });

                    $container.find('.donut-segment, .donut-table-row, .donut-segment-pct').on('mousemove', function (e) {
                        positionTooltip(e);
                    });

                    $container.find('.donut-segment, .donut-table-row, .donut-segment-pct').on('mouseleave', function () {
                        $container.find('.donut-segment').css({ 'stroke-width': '30px', 'opacity': '1' });
                        $container.find('.donut-table-row').removeClass('active');
                        $tooltip.stop(true, true).fadeOut(100);
                    });
                },
                error: function () {
                    $container.html(
                        '<div class="donut-empty-container">' +
                            '<div class="donut-empty-icon"><i class="fa fa-pie-chart"></i></div>' +
                            '<div class="donut-empty-text">No data available</div>' +
                            '<div class="donut-empty-sub">Unable to load ' + (isFailed ? 'failed' : 'passed') + ' battery chart</div>' +
                        '</div>'
                    );
                }
            });
        }

        function chart1() {
            renderModernDonutChart('#chartContainer2', "pr_fetch_passedqty_chart", 'passed');
        }

        function chartcolumn2() {
            renderModernDonutChart('#chartContainer', "pr_fetch_failedqty_chart", 'failed');
        }


        function chartRework() {
            var url = "pr_fetch_Today_Rework_Chart";
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'Reason', type: 'string' },
                    { name: 'Qty', type: 'string' },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source);
            var settings = {
                title: "Rework",
                description: "",
                showLegend: true,
                enableAnimations: true,
                padding: { left: 5, top: 5, right: 5, bottom: 5 },
                titlePadding: { left: 90, top: 0, right: 0, bottom: 10 },
                source: dataAdapter,
                xAxis:
                {
                    dataField: 'Reason',
                    description: 'Reason',
                    showGridLines: false,
                    valuesOnTicks: false
                },
                colorScheme: 'scheme03',
                columnSeriesOverlap: false,
                seriesGroups:
                    [
                        {
                            type: 'column',
                            valueAxis:
                            {
                                description: 'Qty(Nos)',
                                visible: true,
                                minValue: 0,
                                showGridLines: false,
                                title: { text: 'Qty(Nos)<br>' }
                            },
                            series: [
                                { dataField: 'Qty', displayText: 'Qty', showLabels: true, labelAngle: -90, color: '#F59E0B' },
                            ]
                        }
                    ]
            };
            // setup the chart
            $('#chartContainerRework').jqxChart(settings);
            var groups1 = $('#chartContainerRework').jqxChart('seriesGroups');
            $('#chartContainerRework').jqxChart({ seriesGroups: groups1 });
        }

        function chartRejection() {
            var url = "pr_fetch_Today_Rejection_Chart";
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'Reason', type: 'string' },
                    { name: 'Qty', type: 'string' },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source);
            var settings = {
                title: "Rejection",
                description: "",
                showLegend: true,
                enableAnimations: true,
                padding: { left: 5, top: 5, right: 5, bottom: 5 },
                titlePadding: { left: 90, top: 0, right: 0, bottom: 10 },
                source: dataAdapter,
                xAxis:
                {
                    dataField: 'Reason',
                    description: 'Reason',
                    showGridLines: false,
                    valuesOnTicks: false
                },
                colorScheme: 'scheme07',
                columnSeriesOverlap: false,
                seriesGroups:
                    [
                        {
                            type: 'column',
                            valueAxis:
                            {
                                description: 'Qty(Nos)',
                                visible: true,
                                minValue: 0,
                                showGridLines: false,
                                title: { text: 'Qty(Nos)<br>' }
                            },
                            series: [
                                { dataField: 'Qty', displayText: 'Qty', showLabels: true, labelAngle: -90, color: '#dd4b39' },
                            ]
                        }
                    ]
            };
            // setup the chart
            $('#chartContainerRejection').jqxChart(settings);
            var groups1 = $('#chartContainerRejection').jqxChart('seriesGroups');
            $('#chartContainerRejection').jqxChart({ seriesGroups: groups1 });
        }

        $("#btnshow").click(function () {
            chart1();
            chartcolumn2();
            chartRework();
            chartRejection();
            //sumMat();
            //sumAge();
        });

        // Load all 4 charts on startup
        chart1();
        chartcolumn2();
        chartRework();
        chartRejection();

        // Global functions for direct external invocation
        window.chartRework = chartRework;
        window.chartRejection = chartRejection;
        window.refreshReworkChart = chartRework;
        window.refreshRejectionChart = chartRejection;
        window.refreshDashboard = function () {
            chart1();
            chartcolumn2();
            chartRework();
            chartRejection();
        };

        // Real-time synchronization listeners
        window.addEventListener('storage', function (e) {
            if (e.key === 'rework_rejection_saved') {
                try {
                    if (e.newValue) {
                        var parsed = JSON.parse(e.newValue);
                        if (parsed && parsed.type) {
                            if (parsed.type.toLowerCase() === 'rework') {
                                chartRework();
                                return;
                            } else if (parsed.type.toLowerCase() === 'rejection') {
                                chartRejection();
                                return;
                            }
                        }
                    }
                } catch (err) { }
                chartRework();
                chartRejection();
            }
        });

        $(window).on('focus', function () {
            chartRework();
            chartRejection();
        });

        $(document).on('themeChanged', function (e, theme) {
            try {
                if (typeof chart1 === 'function') chart1();
                if (typeof chartcolumn2 === 'function') chartcolumn2();
                if (typeof chartRework === 'function') chartRework();
                if (typeof chartRejection === 'function') chartRejection();
            } catch (err) { }
        });

        // Fast periodic polling (every 15 seconds)
        setInterval(function () {
            chartRework();
            chartRejection();
        }, 15000);

        $("#spinner").hide();
        $("#Data").show();
    });
</script>

<div class="content-wrapper">
    <section class="content" style="padding: 16px 20px;">
        
        <div class="row">
            <div class="col-lg-12">
     
                <div class="overlay" id="spinner" style="margin-left:15%;margin-top:40%">
