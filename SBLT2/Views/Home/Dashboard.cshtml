
@{
    /**/
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">
    $(document).ready(function () {
        var ID = 0;
        var User = sessionStorage.getItem("Plant");

        //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });

        function sumAge() {
            //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });
            var url = "pr_fetch_AgeWiseInventory_Chart_Sum?ID=" + $('#DateTime').val();
            //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'Qty', type: 'string' },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source, {
                contentType: 'application/json; charset=utf-8',
                loadComplete: function () {
                    var length = dataAdapter.records.length;
                    flag = false;
                    var records = dataAdapter.records;
                    var record = records[0];
                    $('#TotalQty_Age').val(record.Qty);
                },
                error: function (xhr, status, error) {
                    alert(JSON.stringify(xhr));
                }
            });
            dataAdapter.dataBind();
        }
        function sumMat() {
            //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });
            var url = "pr_fetch_MaterialWiseInventory_Chart_Sum?ID=" + $('#DateTime').val();
            //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'TotalMat', type: 'string' },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source, {
                contentType: 'application/json; charset=utf-8',
                loadComplete: function () {
                    var length = dataAdapter.records.length;
                    flag = false;
                    var records = dataAdapter.records;
                    var record = records[0];
                    $('#TotalQty_Mat').val(record.TotalMat);
                },
                error: function (xhr, status, error) {
                    alert(JSON.stringify(xhr));
                }
            });
            dataAdapter.dataBind();
        }

        function renderModernDonutChart(containerSelector, apiUrl, chartType) {
            if (typeof window.renderModernDonutChart === 'function') {
                window.renderModernDonutChart(containerSelector, apiUrl, chartType);
            }
        }

        function chart1() {
            renderModernDonutChart('#chartContainer2', "pr_fetch_passedqty_chart", 'passed');
        }

        function chartcolumn2() {
            renderModernDonutChart('#chartContainer', "pr_fetch_failedqty_chart", 'failed');
        }


        function chartRework() {
            var url = "pr_fetch_Today_Rework_Chart";
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'Reason', type: 'string' },
                    { name: 'Qty', type: 'string' },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source);
            var settings = {
                title: "Rework",
                description: "",
                showLegend: true,
                enableAnimations: true,
                padding: { left: 5, top: 5, right: 5, bottom: 5 },
                titlePadding: { left: 90, top: 0, right: 0, bottom: 10 },
                source: dataAdapter,
                xAxis:
                {
                    dataField: 'Reason',
                    description: 'Reason',
                    showGridLines: false,
                    valuesOnTicks: false
                },
                colorScheme: 'scheme03',
                columnSeriesOverlap: false,
                seriesGroups:
                    [
                        {
                            type: 'column',
                            valueAxis:
                            {
                                description: 'Qty(Nos)',
                                visible: true,
                                minValue: 0,
                                showGridLines: false,
                                title: { text: 'Qty(Nos)<br>' }
                            },
                            series: [
                                { dataField: 'Qty', displayText: 'Qty', showLabels: true, labelAngle: -90, color: '#F59E0B' },
                            ]
                        }
                    ]
            };
            // setup the chart
            $('#chartContainerRework').jqxChart(settings);
            var groups1 = $('#chartContainerRework').jqxChart('seriesGroups');
            $('#chartContainerRework').jqxChart({ seriesGroups: groups1 });
        }

        function chartRejection() {
            var url = "pr_fetch_Today_Rejection_Chart";
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'Reason', type: 'string' },
                    { name: 'Qty', type: 'string' },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source);
            var settings = {
                title: "Rejection",
                description: "",
                showLegend: true,
                enableAnimations: true,
                padding: { left: 5, top: 5, right: 5, bottom: 5 },
                titlePadding: { left: 90, top: 0, right: 0, bottom: 10 },
                source: dataAdapter,
                xAxis:
                {
                    dataField: 'Reason',
                    description: 'Reason',
                    showGridLines: false,
                    valuesOnTicks: false
                },
                colorScheme: 'scheme07',
                columnSeriesOverlap: false,
                seriesGroups:
                    [
                        {
                            type: 'column',
                            valueAxis:
                            {
                                description: 'Qty(Nos)',
                                visible: true,
                                minValue: 0,
                                showGridLines: false,
                                title: { text: 'Qty(Nos)<br>' }
                            },
                            series: [
                                { dataField: 'Qty', displayText: 'Qty', showLabels: true, labelAngle: -90, color: '#dd4b39' },
                            ]
                        }
                    ]
            };
            // setup the chart
            $('#chartContainerRejection').jqxChart(settings);
            var groups1 = $('#chartContainerRejection').jqxChart('seriesGroups');
            $('#chartContainerRejection').jqxChart({ seriesGroups: groups1 });
        }

        $("#btnshow").click(function () {
            chart1();
            chartcolumn2();
            chartRework();
            chartRejection();
            //sumMat();
            //sumAge();
        });

        // Load all 4 charts on startup
        chart1();
        chartcolumn2();
        chartRework();
        chartRejection();

        // Global functions for direct external invocation
        window.chartRework = chartRework;
        window.chartRejection = chartRejection;
        window.refreshReworkChart = chartRework;
        window.refreshRejectionChart = chartRejection;
        window.refreshDashboard = function () {
            chart1();
            chartcolumn2();
            chartRework();
            chartRejection();
        };

        // Real-time synchronization listeners
        window.addEventListener('storage', function (e) {
            if (e.key === 'rework_rejection_saved') {
                try {
                    if (e.newValue) {
                        var parsed = JSON.parse(e.newValue);
                        if (parsed && parsed.type) {
                            if (parsed.type.toLowerCase() === 'rework') {
                                chartRework();
                                return;
                            } else if (parsed.type.toLowerCase() === 'rejection') {
                                chartRejection();
                                return;
                            }
                        }
                    }
                } catch (err) { }
                chartRework();
                chartRejection();
            }
        });

        $(window).on('focus', function () {
            chartRework();
            chartRejection();
        });

        $(document).on('themeChanged', function (e, theme) {
            try {
                if (typeof chart1 === 'function') chart1();
                if (typeof chartcolumn2 === 'function') chartcolumn2();
                if (typeof chartRework === 'function') chartRework();
                if (typeof chartRejection === 'function') chartRejection();
            } catch (err) { }
        });

        // Fast periodic polling (every 15 seconds)
        setInterval(function () {
            chartRework();
            chartRejection();
        }, 15000);

        $("#spinner").hide();
        $("#Data").show();
    });
</script>

<div class="content-wrapper">
    <section class="content" style="padding: 16px 20px;">
        
        <div class="row">
            <div class="col-lg-12">
     
                <div class="overlay" id="spinner" style="margin-left:15%;margin-top:40%">
                    <i class="fa fa-refresh fa-spin"></i>
                </div>

                <!-- Modern Plant Dashboard Header -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 10px;">
                    <div>
                        <h2 style="font-size: 20px; font-weight: 800; color: var(--text-primary); margin: 0; display: flex; align-items: center; gap: 8px;">
                            <i class="fa fa-tachometer" style="color: var(--ar-primary);"></i> Formation Operational Dashboard
                        </h2>
                        <span style="font-size: 13px; color: var(--text-secondary);">Real-time production, test passage, defect logs, and plant analytics</span>
                    </div>
                    <div>
                        <button type="button" class="btn btn-default" onclick="window.refreshDashboard()" title="Refresh Dashboard Data" style="min-height: 34px; height: 34px; font-size: 12px;">
                            <i class="fa fa-refresh text-primary"></i> Refresh
                        </button>
                    </div>
                </div>

                <!-- 2x2 RESPONSIVE CHARTS GRID -->
                <div class="row">
                    <!-- Chart 1: Passed -->
                    <div class="col-md-6 col-sm-12" style="margin-bottom: 20px;">
                        <div class="modern-chart-card">
                            <div class="modern-chart-card-header">
                                <span class="donut-badge-icon badge-passed"><i class="fa fa-check"></i></span>
                                <h4 class="modern-chart-title">Battery Type Wise Passed Qty</h4>
                            </div>
                            <div class="modern-chart-card-body">
                                <div id='chartContainer2' style="width:100%;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Chart 2: Failed -->
                    <div class="col-md-6 col-sm-12" style="margin-bottom: 20px;">
                        <div class="modern-chart-card">
                            <div class="modern-chart-card-header">
                                <span class="donut-badge-icon badge-failed"><i class="fa fa-exclamation"></i></span>
                                <h4 class="modern-chart-title">Battery Type Wise Failed Qty</h4>
                            </div>
                            <div class="modern-chart-card-body">
                                <div id='chartContainer' style="width:100%;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Chart 3: Rework -->
                    <div class="col-md-6 col-sm-12" style="margin-bottom: 20px;">
                        <div class="box box-warning" style="border-top: 3px solid var(--ar-warning) !important;">
                            <div class="box-header with-border">
                                <h4 class="box-title" style="color: var(--text-primary); font-weight: 700; font-size: 14px;">
                                    <i class="fa fa-wrench" style="color: var(--ar-warning); margin-right: 6px;"></i> Today's Rework Defect Distribution
                                </h4>
                            </div>
                            <div class="box-body" style="padding: 12px 16px;">
                                <div id='chartContainerRework' style="width:100%; height:320px;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Chart 4: Rejection -->
                    <div class="col-md-6 col-sm-12" style="margin-bottom: 20px;">
                        <div class="box box-danger" style="border-top: 3px solid var(--ar-danger) !important;">
                            <div class="box-header with-border">
                                <h4 class="box-title" style="color: var(--text-primary); font-weight: 700; font-size: 14px;">
                                    <i class="fa fa-ban" style="color: var(--ar-danger); margin-right: 6px;"></i> Today's Rejection Defect Distribution
                                </h4>
                            </div>
                            <div class="box-body" style="padding: 12px 16px;">
                                <div id='chartContainerRejection' style="width:100%; height:320px;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            
            </div>
          
        </div>
    </section>
</div>













