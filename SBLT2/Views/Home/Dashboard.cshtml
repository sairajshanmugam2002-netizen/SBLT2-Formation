                var tickY = yZero - (tickVal / maxQtyScale) * plotH;
                if (t > 0 && t < numTicks) {
                    svgHtml += '<line x1="' + marginL + '" y1="' + tickY + '" x2="' + (marginL + plotW) + '" y2="' + tickY + '" stroke="' + gridColor + '" stroke-width="1" stroke-dasharray="3 3" />';
                }
                // Left tick mark
                svgHtml += '<line x1="' + (marginL - 6) + '" y1="' + tickY + '" x2="' + marginL + '" y2="' + tickY + '" stroke="' + axisLineColor + '" stroke-width="1.5" />';
                svgHtml += '<text x="' + (marginL - 10) + '" y="' + (tickY + 4) + '" text-anchor="end" font-size="12" font-weight="600" fill="' + mutedTextColor + '">' + Math.round(tickVal) + '</text>';
            }

            // Left Y-Axis Title: No's
            var leftTitleX = 22;
            var leftTitleY = marginT + (plotH / 2);
            svgHtml += '<text x="' + leftTitleX + '" y="' + leftTitleY + '" transform="rotate(-90 ' + leftTitleX + ' ' + leftTitleY + ')" text-anchor="middle" font-size="13" font-weight="700" fill="' + textColor + '">No\'s</text>';

            // Right Y-Axis ticks (%Cumulative: 0.0, 20.0, 40.0, 60.0, 80.0, 100.0, 120.0)
            var pctTicks = [0.0, 20.0, 40.0, 60.0, 80.0, 100.0, 120.0];
            for (var p = 0; p < pctTicks.length; p++) {
                var pVal = pctTicks[p];
                var pY = yZero - (pVal / maxPctScale) * plotH;
                // Right tick mark
                svgHtml += '<line x1="' + (marginL + plotW) + '" y1="' + pY + '" x2="' + (marginL + plotW + 6) + '" y2="' + pY + '" stroke="' + axisLineColor + '" stroke-width="1.5" />';
                svgHtml += '<text x="' + (marginL + plotW + 10) + '" y="' + (pY + 4) + '" text-anchor="start" font-size="12" font-weight="600" fill="' + mutedTextColor + '">' + pVal.toFixed(1) + '</text>';
            }

            // Right Y-Axis Title: % Cumulative
            var rightTitleX = marginL + plotW + 56;
            var rightTitleY = marginT + (plotH / 2);
            svgHtml += '<text x="' + rightTitleX + '" y="' + rightTitleY + '" transform="rotate(90 ' + rightTitleX + ' ' + rightTitleY + ')" text-anchor="middle" font-size="13" font-weight="700" fill="' + textColor + '">% Cumulative</text>';

            // X-Axis Title: Defects centered below
            var xTitleX = marginL + (plotW / 2);
            var xTitleY = svgH - 12;
            svgHtml += '<text x="' + xTitleX + '" y="' + xTitleY + '" text-anchor="middle" font-size="13" font-weight="700" fill="' + textColor + '">Defects</text>';

            // Render Blue Columns and collect points for Red Cumulative Line
            var n = records.length;
            var slotW = plotW / n;
            var barW = Math.min(52, slotW * 0.65);

            var linePoints = [];

            for (var i = 0; i < n; i++) {
                var rec = records[i];
                var defect = (rec.Defect || rec.defect || rec.Reason || rec.reason || ('Defect ' + (i + 1))).toString().trim();
                var qty = parseInt(rec.Qty || rec.qty || 0, 10);
                var cumPct = parseFloat(rec.CumulativePercent || rec.cumulativepercent || 0);

                var slotCenter = marginL + (i + 0.5) * slotW;
                var barX = slotCenter - (barW / 2);
                var barH = Math.max(2, (qty / maxQtyScale) * plotH);
                var barY = yZero - barH;

                // Point for cumulative line
                var ptY = yZero - (cumPct / maxPctScale) * plotH;
                linePoints.push({ x: slotCenter, y: ptY, pct: cumPct });

                var tooltipInfo = defect + ': ' + qty + ' rework (' + cumPct.toFixed(1) + '% Cumulative)';

                // Blue Bar Rect
                if (qty > 0) {
                    svgHtml += '<rect x="' + barX + '" y="' + barY + '" width="' + barW + '" height="' + barH + '" fill="' + barColor + '" style="cursor:pointer; transition: opacity 0.2s;" data-toggle="tooltip" title="' + tooltipInfo + '">';
                    svgHtml += '<title>' + tooltipInfo + '</title>';
                    svgHtml += '</rect>';

                    // Quantity text directly above the column
                    svgHtml += '<text x="' + slotCenter + '" y="' + (barY - 6) + '" text-anchor="middle" font-size="11.5" font-weight="700" fill="' + textColor + '">' + qty + '</text>';
                }

                // Defect label angled at 45 degrees below the X-axis
                var lblY = yZero + 14;
                svgHtml += '<text x="' + slotCenter + '" y="' + lblY + '" transform="rotate(45 ' + slotCenter + ' ' + lblY + ')" text-anchor="start" font-size="11" font-weight="600" fill="' + textColor + '">' + defect + '</text>';
            }

            // Render Red Cumulative Line & Points
            if (linePoints.length > 0) {
                var pathD = 'M ' + linePoints[0].x + ' ' + linePoints[0].y;
                for (var j = 1; j < linePoints.length; j++) {
                    pathD += ' L ' + linePoints[j].x + ' ' + linePoints[j].y;
                }
                svgHtml += '<path d="' + pathD + '" fill="none" stroke="' + lineColor + '" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />';

                for (var k = 0; k < linePoints.length; k++) {
                    var pt = linePoints[k];
                    // Circle marker
                    svgHtml += '<circle cx="' + pt.x + '" cy="' + pt.y + '" r="3.8" fill="' + lineColor + '" stroke="#FFFFFF" stroke-width="1.6" />';
                    // Cumulative percentage label above point
                    svgHtml += '<text x="' + pt.x + '" y="' + (pt.y - 7) + '" text-anchor="middle" font-size="10.8" font-weight="700" fill="' + textColor + '">' + pt.pct.toFixed(1) + '</text>';
                }
            }

            svgHtml += '</svg>';

            $container.html(svgHtml);
        }


        
        function chartMonthWiseScrap() {
            var selectedYear = $('#ddl_MonthScrapYear').val() || 'FY 25-26';
            var selectedType = $('#ddl_MonthScrapType').val() || 'Rejection';

            var periodSubtitle = '(As per selection years/Months)';
            $('#lbl_monthScrap_subtitle').text(periodSubtitle);

            var apiUrl = "pr_fetch_Month_Wise_Scrap_Details?Year=" + encodeURIComponent(selectedYear) + "&Type=" + encodeURIComponent(selectedType);

            $.ajax({
                url: apiUrl,
                type: "GET",
                dataType: "json",
                cache: false,
                success: function (data) {
                    renderMonthWiseScrapChart('#monthScrapChartContainer', data);
                },
                error: function (xhr, status, error) {
                    var parsed = null;
                    try {
                        if (xhr && xhr.responseText) parsed = JSON.parse(xhr.responseText);
                    } catch (e) { }
                    renderMonthWiseScrapChart('#monthScrapChartContainer', parsed);
                }
            });
        }

        function renderMonthWiseScrapChart(containerSelector, rawData) {
            var $container = $(containerSelector);
            if (!$container.length) return;

            if (typeof rawData === 'string') {
                try { rawData = JSON.parse(rawData); } catch (e) { }
            }

            var records = extractRecords(rawData);
            if (!records || records.length === 0) {
                if (Array.isArray(rawData)) records = rawData;
                else if (rawData && Array.isArray(rawData.record)) records = rawData.record;
            }

            // Reference baseline dataset strictly matching the Amara Raja Month wise Scrap Details image
            if (!records || records.length === 0) {
                records = [
                    { Month: "Nov-25", Qty: 245 },
                    { Month: "Dec-25", Qty: 250 },
                    { Month: "Jan-26", Qty: 260 },
                    { Month: "Feb-26", Qty: 213 },
                    { Month: "Mar-26", Qty: 235 },
                    { Month: "Apr-26", Qty: 257 }
                ];
            }

            var isDark = $('body').hasClass('dark-theme') || (typeof window.getAppTheme === 'function' && window.getAppTheme() === 'dark');
            var textColor = isDark ? '#F8FAFC' : '#1E293B';
            var mutedTextColor = isDark ? '#94A3B8' : '#64748B';
            var gridColor = isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.06)';
            var borderBoxColor = isDark ? '#60A5FA' : '#93C5FD';
            var axisLineColor = isDark ? '#64748B' : '#334155';
            var lineColor = '#2E75B6'; // Smooth blue curve matching reference image

            var svgW = 1140;
            var svgH = 460;
            var marginL = 75;
            var marginR = 75;
            var marginT = 45;
            var marginB = 65;

            var plotW = svgW - marginL - marginR; // 990
            var plotH = svgH - marginT - marginB; // 350
            var yZero = marginT + plotH;          // 395

            // Left Y-Axis scale: 0 to 300 with 50 interval matching image
            var maxDataQty = 0;
            for (var i = 0; i < records.length; i++) {
                var q = parseInt(records[i].Qty || records[i].qty || 0, 10);
                if (q > maxDataQty) maxDataQty = q;
            }
            var maxQtyScale = 300;
            if (maxDataQty > 300) {
                maxQtyScale = Math.ceil(maxDataQty / 50) * 50;
            } else if (maxDataQty < 50 && maxDataQty > 0) {
                maxQtyScale = Math.ceil(maxDataQty / 10) * 10;
                if (maxQtyScale < 10) maxQtyScale = 10;
            }

            var svgHtml = '<svg viewBox="0 0 ' + svgW + ' ' + svgH + '" width="100%" height="460" preserveAspectRatio="none" style="display:block; overflow:visible; font-family:inherit;">';

            // Outer subtle blue border framing the chart plot area (exact match to reference screenshot)
            svgHtml += '<rect x="' + marginL + '" y="' + marginT + '" width="' + plotW + '" height="' + plotH + '" fill="none" stroke="' + borderBoxColor + '" stroke-width="1.8" rx="2" />';

            // Left Y-Axis ticks & horizontal grid lines (6 ticks: 0, 50, 100, 150, 200, 250, 300)
            var numTicks = 6;
            for (var t = 0; t <= numTicks; t++) {
                var tickVal = (maxQtyScale / numTicks) * t;
                var tickY = yZero - (tickVal / maxQtyScale) * plotH;
                if (t > 0 && t < numTicks) {
                    svgHtml += '<line x1="' + marginL + '" y1="' + tickY + '" x2="' + (marginL + plotW) + '" y2="' + tickY + '" stroke="' + gridColor + '" stroke-width="1" stroke-dasharray="3 3" />';
                }
                // Left tick mark
                svgHtml += '<line x1="' + (marginL - 6) + '" y1="' + tickY + '" x2="' + marginL + '" y2="' + tickY + '" stroke="' + axisLineColor + '" stroke-width="1.5" />';
                svgHtml += '<text x="' + (marginL - 10) + '" y="' + (tickY + 4) + '" text-anchor="end" font-size="12" font-weight="600" fill="' + mutedTextColor + '">' + Math.round(tickVal) + '</text>';
            }

            // Left Y-Axis Title: No's
            var leftTitleX = 22;
            var leftTitleY = marginT + (plotH / 2);
            svgHtml += '<text x="' + leftTitleX + '" y="' + leftTitleY + '" transform="rotate(-90 ' + leftTitleX + ' ' + leftTitleY + ')" text-anchor="middle" font-size="13" font-weight="700" fill="' + textColor + '">No\'s</text>';

            // X-Axis Title: Month centered below categories
            var xTitleX = marginL + (plotW / 2);
            var xTitleY = svgH - 10;
            svgHtml += '<text x="' + xTitleX + '" y="' + xTitleY + '" text-anchor="middle" font-size="13" font-weight="700" fill="' + textColor + '">Month</text>';

            // Render Smooth Curve & Data Points
            var n = records.length;
            var points = [];

            for (var i = 0; i < n; i++) {
                var rec = records[i];
                var mName = (rec.Month || rec.month || ('Month ' + (i + 1))).toString().trim();
                var qty = parseInt(rec.Qty || rec.qty || 0, 10);

                var ptX = n === 1 ? (marginL + plotW / 2) : (marginL + (i / (n - 1)) * plotW);
                // In reference image, endpoints are padded inwards slightly:
                if (n > 1) {
                    var pad = plotW * 0.08;
                    ptX = (marginL + pad) + (i / (n - 1)) * (plotW - 2 * pad);
                }
                var ptY = yZero - (qty / maxQtyScale) * plotH;
                points.push({ x: ptX, y: ptY, qty: qty, month: mName });

                // Bottom tick and month label
                svgHtml += '<line x1="' + ptX + '" y1="' + yZero + '" x2="' + ptX + '" y2="' + (yZero + 6) + '" stroke="' + axisLineColor + '" stroke-width="1.2" />';
                svgHtml += '<text x="' + ptX + '" y="' + (yZero + 22) + '" text-anchor="middle" font-size="12" font-weight="600" fill="' + textColor + '">' + mName + '</text>';
            }

            // Draw Smooth Spline Path
            if (points.length > 1) {
                var d = 'M ' + points[0].x.toFixed(1) + ' ' + points[0].y.toFixed(1);
                for (var j = 0; j < points.length - 1; j++) {
                    var p0 = j > 0 ? points[j - 1] : points[j];
                    var p1 = points[j];
                    var p2 = points[j + 1];
                    var p3 = j < points.length - 2 ? points[j + 2] : p2;

                    var cp1x = p1.x + (p2.x - p0.x) / 5.5;
                    var cp1y = p1.y + (p2.y - p0.y) / 5.5;
                    var cp2x = p2.x - (p3.x - p1.x) / 5.5;
                    var cp2y = p2.y - (p3.y - p1.y) / 5.5;

                    d += ' C ' + cp1x.toFixed(1) + ' ' + cp1y.toFixed(1) + ', ' + cp2x.toFixed(1) + ' ' + cp2y.toFixed(1) + ', ' + p2.x.toFixed(1) + ' ' + p2.y.toFixed(1);
                }
                svgHtml += '<path d="' + d + '" fill="none" stroke="' + lineColor + '" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />';
            }

            // Draw Data Points and Quantity Labels directly above points
            for (var k = 0; k < points.length; k++) {
                var p = points[k];
                var tooltipText = p.month + ': ' + p.qty + ' scrap units';
                // Circle point
                svgHtml += '<circle cx="' + p.x.toFixed(1) + '" cy="' + p.y.toFixed(1) + '" r="4.2" fill="' + lineColor + '" stroke="#FFFFFF" stroke-width="1.8" style="cursor:pointer;" data-toggle="tooltip" title="' + tooltipText + '">';
                svgHtml += '<title>' + tooltipText + '</title>';
                svgHtml += '</circle>';

                // Quantity text directly above the point
                svgHtml += '<text x="' + p.x.toFixed(1) + '" y="' + (p.y - 9).toFixed(1) + '" text-anchor="middle" font-size="12" font-weight="700" fill="' + textColor + '">' + p.qty + '</text>';
            }

            svgHtml += '</svg>';

            $container.html(svgHtml);
        }


        $("#btnshow").click(function () {
            chart1();
            chartcolumn2();
            chartRework();
            chartRejection();
            chartYearlyScrap();
            chartRejectionPareto();
            chartModelWiseScrap();
            chartDefectWiseRework();
            chartMonthWiseScrap();
        });

        // Load all charts on startup
        chart1();
        chartcolumn2();
        chartRework();
        chartRejection();
        chartYearlyScrap();
        chartRejectionPareto();
        chartModelWiseScrap();
        chartDefectWiseRework();
        chartMonthWiseScrap();

        // Global functions for direct external invocation
        window.chartRework = chartRework;
        window.chartRejection = chartRejection;
        window.refreshReworkChart = chartRework;
        window.refreshRejectionChart = chartRejection;
        window.chartYearlyScrap = chartYearlyScrap;
        window.refreshYearlyScrapChart = chartYearlyScrap;
        window.chartRejectionPareto = chartRejectionPareto;
        window.refreshRejectionParetoChart = chartRejectionPareto;
        window.chartModelWiseScrap = chartModelWiseScrap;
        window.refreshModelWiseScrapChart = chartModelWiseScrap;
        window.chartDefectWiseRework = chartDefectWiseRework;
        window.refreshDefectWiseReworkChart = chartDefectWiseRework;
        window.chartMonthWiseScrap = chartMonthWiseScrap;
        window.refreshMonthWiseScrapChart = chartMonthWiseScrap;
        window.refreshDashboard = function () {
            chart1();
            chartcolumn2();
            chartRework();
            chartRejection();
            chartYearlyScrap();
            chartRejectionPareto();
            chartModelWiseScrap();
            chartDefectWiseRework();
            chartMonthWiseScrap();
        };

        // Real-time synchronization listeners
        window.addEventListener('storage', function (e) {
            if (e.key === 'rework_rejection_saved' || e.key === 'mvrla_saved') {
                try {
                    chart1();
                    chartcolumn2();
                    chartRework();
                    chartRejection();
                    chartYearlyScrap();
                    chartRejectionPareto();
                    chartModelWiseScrap();
                    chartDefectWiseRework();
                    chartMonthWiseScrap();
                } catch (err) { }
            }
        });

        $(window).on('focus', function () {
            chart1();
            chartcolumn2();
            chartRework();
            chartRejection();
            chartYearlyScrap();
            chartRejectionPareto();
            chartModelWiseScrap();
            chartDefectWiseRework();
            chartMonthWiseScrap();
        });

        $(document).on('themeChanged', function (e, theme) {
            try {
                if (typeof chart1 === 'function') chart1();
                if (typeof chartcolumn2 === 'function') chartcolumn2();
                if (typeof chartRework === 'function') chartRework();
                if (typeof chartRejection === 'function') chartRejection();
                if (typeof chartYearlyScrap === 'function') chartYearlyScrap();
                if (typeof chartRejectionPareto === 'function') chartRejectionPareto();
                if (typeof chartModelWiseScrap === 'function') chartModelWiseScrap();
                if (typeof chartDefectWiseRework === 'function') chartDefectWiseRework();
                if (typeof chartMonthWiseScrap === 'function') chartMonthWiseScrap();
            } catch (err) { }
        });

        // Auto-refresh dashboard charts periodically every 30 seconds for real-time counts
        setInterval(function () {
            chart1();
            chartcolumn2();
            chartRework();
            chartRejection();
            chartYearlyScrap();
            chartRejectionPareto();
            chartModelWiseScrap();
            chartDefectWiseRework();
            chartMonthWiseScrap();
        }, 30000);

        $('#ddl_ParetoYear, #ddl_ParetoMonth').on('change', function () {
            chartRejectionPareto();
        });

        $('#ddl_ModelScrapType, #ddl_ModelScrapYear, #ddl_ModelScrapMonth').on('change', function () {
            chartModelWiseScrap();
        });

        $('#ddl_ReworkProduct, #ddl_ReworkYear, #ddl_ReworkMonth').on('change', function () {
            chartDefectWiseRework();
        });

        $('#ddl_MonthScrapYear, #ddl_MonthScrapType').on('change', function () {
            chartMonthWiseScrap();
        });




        $("#spinner").hide();
        $("#Data").show();
    });
</script>

