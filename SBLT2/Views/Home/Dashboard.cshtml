                        </div>
                        <div class="col-sm-2">
                            <div id="DateTime"></div>
                        </div>
                        <div class="col-sm-2">
                            <button type="button" id="btnshow" style="width: 80px"><span class="fa fa-search"></span>Show</button>
                        </div>
                    </div>*@
                    <div id='chartContainer2' style="width:100%; height:300px;"> </div>
                </div>

                <div class="col-lg-12">

                    @*<div class="form-group">
                        <label class="col-sm-2">Total Nos</label>
                        <div class="col-sm-4">
                            <input id="TotalQty_Mat" type="text" style="width:95px;" disabled="disabled" />
                        </div>
                    </div>*@
                    <div id='chartContainer' style="width:100%; height:300px;"> </div>
                </div>
            
            </div>
          
        </div>
    </section>
</div>













