
@{
    /**/
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">
    $(document).ready(function () {
        var ID = 0;
        var User = sessionStorage.getItem("Plant");

        //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });

        function sumAge() {
            //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });
            var url = "pr_fetch_AgeWiseInventory_Chart_Sum?ID=" + $('#DateTime').val();
            //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'Qty', type: 'string' },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source, {
                contentType: 'application/json; charset=utf-8',
                loadComplete: function () {
                    var length = dataAdapter.records.length;
                    flag = false;
                    var records = dataAdapter.records;
                    var record = records[0];
                    $('#TotalQty_Age').val(record.Qty);
                },
                error: function (xhr, status, error) {
                    alert(JSON.stringify(xhr));
                }
            });
            dataAdapter.dataBind();
        }
        function sumMat() {
            //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });
            var url = "pr_fetch_MaterialWiseInventory_Chart_Sum?ID=" + $('#DateTime').val();
            //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'TotalMat', type: 'string' },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source, {
                contentType: 'application/json; charset=utf-8',
                loadComplete: function () {
                    var length = dataAdapter.records.length;
                    flag = false;
                    var records = dataAdapter.records;
                    var record = records[0];
                    $('#TotalQty_Mat').val(record.TotalMat);
                },
                error: function (xhr, status, error) {
                    alert(JSON.stringify(xhr));
                }
            });
            dataAdapter.dataBind();
        }

        function chart1() {
            // ----------------------------Page 1  start---------------------------------
            //Absent list line chart......................................................
            //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });
            var url = "pr_fetch_passedqty_chart";//?ID=" + $('#DateTime').val();
            //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'mv_BatteryType', type: 'string' },
                    { name: 'Qty', type: 'string' },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source);
            var settings = {
                title: "Battery Type wise Passed Qty",
                description: "",
                showLegend: true,
                enableAnimations: true,
                padding: { left: 5, top: 5, right: 5, bottom: 5 },
                titlePadding: { left: 90, top: 0, right: 0, bottom: 10 },
                source: dataAdapter,
                xAxis:
                {
                    dataField: 'mv_BatteryType',
                    description: 'mv_BatteryType',
                    showGridLines: false,
                    valuesOnTicks: false
                },
                colorScheme: 'scheme02',
                columnSeriesOverlap: false,
                seriesGroups:
                    [
                        {
                            type: 'column',
                            valueAxis:
                            {
                                description: 'Qty(Nos)',
                                visible: true,
                                unitInterval: 500,
                                showGridLines: false,
                                title: { text: 'Plant Avg Cycletime<br>' }
                            },
                            series: [
                                { dataField: 'Qty', displayText: 'Qty', showLabels: true, labelAngle: -90 },
                            ]
                        }
                    ]
            };
            // setup the chart
            $('#chartContainer2').jqxChart(settings);
            var groups1 = $('#chartContainer2').jqxChart('seriesGroups');
            $('#chartContainer2').jqxChart({ seriesGroups: groups1 });
        }

        function chartcolumn2() {
            // ----------------------------Page 1  start---------------------------------
            //Absent list line chart......................................................
            var User = sessionStorage.getItem("Plant");
            //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });
            var url = "pr_fetch_failedqty_chart";//?ID=" + $('#DateTime').val();
            //$("#DateTime").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'mv_BatteryType', type: 'string' },
                    { name: 'Qty', type: 'string' }
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source);
            var settings = {
                title: "Battery Type wise failed Qty",
                description: "",
                showLegend: true,
                enableAnimations: true,
                padding: { left: 5, top: 5, right: 5, bottom: 5 },
                titlePadding: { left: 90, top: 0, right: 0, bottom: 10 },
                source: dataAdapter,
                xAxis:
                {
                    dataField: 'mv_BatteryType',
                    description: 'mv_BatteryType',
                    showGridLines: false,
                    valuesOnTicks: false,
                    //textRotationAngle: -75,
                },
                colorScheme: 'scheme07',
                columnSeriesOverlap: false,
                seriesGroups:
                    [
                        {
                            type: 'column',
                            valueAxis:
                            {
                                visible: true,
                                description: 'Qty(Nos)',
                                unitInterval: 500,
                                showGridLines: false,
                                title: { text: 'MSG Stock Modelwise<br> ' }
                            },
                            series: [
                                { dataField: 'Qty', displayText: 'Qty', showLabels: true, labelAngle: -90 }
                            ]
                        }
                    ]
            };
            // setup the chart
            $('#chartContainer').jqxChart(settings);
            var groups1 = $('#chartContainer').jqxChart('seriesGroups');
            $('#chartContainer').jqxChart({ seriesGroups: groups1 });
        }


        function chartRework() {
            var url = "pr_fetch_Today_Rework_Chart";
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'Reason', type: 'string' },
                    { name: 'Qty', type: 'string' },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source);
            var settings = {
                title: "Rework",
                description: "",
                showLegend: true,
                enableAnimations: true,
                padding: { left: 5, top: 5, right: 5, bottom: 5 },
                titlePadding: { left: 90, top: 0, right: 0, bottom: 10 },
                source: dataAdapter,
                xAxis:
                {
                    dataField: 'Reason',
                    description: 'Reason',
                    showGridLines: false,
                    valuesOnTicks: false
                },
                colorScheme: 'scheme03',
                columnSeriesOverlap: false,
                seriesGroups:
                    [
                        {
                            type: 'column',
                            valueAxis:
                            {
                                description: 'Qty(Nos)',
                                visible: true,
                                minValue: 0,
                                showGridLines: false,
                                title: { text: 'Qty(Nos)<br>' }
                            },
                            series: [
                                { dataField: 'Qty', displayText: 'Qty', showLabels: true, labelAngle: -90, color: '#f39c12' },
                            ]
                        }
                    ]
            };
            // setup the chart
            $('#chartContainerRework').jqxChart(settings);
            var groups1 = $('#chartContainerRework').jqxChart('seriesGroups');
            $('#chartContainerRework').jqxChart({ seriesGroups: groups1 });
        }

        function chartRejection() {
            var url = "pr_fetch_Today_Rejection_Chart";
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'Reason', type: 'string' },
                    { name: 'Qty', type: 'string' },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source);
            var settings = {
                title: "Rejection",
                description: "",
                showLegend: true,
                enableAnimations: true,
                padding: { left: 5, top: 5, right: 5, bottom: 5 },
                titlePadding: { left: 90, top: 0, right: 0, bottom: 10 },
                source: dataAdapter,
                xAxis:
                {
                    dataField: 'Reason',
                    description: 'Reason',
                    showGridLines: false,
                    valuesOnTicks: false
                },
                colorScheme: 'scheme07',
                columnSeriesOverlap: false,
                seriesGroups:
                    [
                        {
                            type: 'column',
                            valueAxis:
                            {
                                description: 'Qty(Nos)',
                                visible: true,
                                minValue: 0,
                                showGridLines: false,
                                title: { text: 'Qty(Nos)<br>' }
                            },
                            series: [
                                { dataField: 'Qty', displayText: 'Qty', showLabels: true, labelAngle: -90, color: '#dd4b39' },
                            ]
                        }
                    ]
            };
            // setup the chart
            $('#chartContainerRejection').jqxChart(settings);
            var groups1 = $('#chartContainerRejection').jqxChart('seriesGroups');
            $('#chartContainerRejection').jqxChart({ seriesGroups: groups1 });
        }

        $("#btnshow").click(function () {
            chart1();
            chartcolumn2();
            chartRework();
            chartRejection();
            //sumMat();
            //sumAge();
        });

        // Load all 4 charts on startup
        chart1();
        chartcolumn2();
        chartRework();
        chartRejection();

        // Global functions for direct external invocation
        window.chartRework = chartRework;
        window.chartRejection = chartRejection;
        window.refreshReworkChart = chartRework;
        window.refreshRejectionChart = chartRejection;
        window.refreshDashboard = function () {
            chart1();
            chartcolumn2();
            chartRework();
            chartRejection();
        };

        // Real-time synchronization listeners
        window.addEventListener('storage', function (e) {
            if (e.key === 'rework_rejection_saved') {
                try {
                    if (e.newValue) {
                        var parsed = JSON.parse(e.newValue);
                        if (parsed && parsed.type) {
                            if (parsed.type.toLowerCase() === 'rework') {
                                chartRework();
                                return;
                            } else if (parsed.type.toLowerCase() === 'rejection') {
                                chartRejection();
                                return;
                            }
                        }
                    }
                } catch (err) { }
                chartRework();
                chartRejection();
            }
        });

        $(window).on('focus', function () {
            chartRework();
            chartRejection();
        });

        // Fast periodic polling (every 15 seconds)
        setInterval(function () {
            chartRework();
            chartRejection();
        }, 15000);

        $("#spinner").hide();
        $("#Data").show();
    });
</script>

<div class="content-wrapper">
    <section class="content" style="padding-left:15px;padding-right:15px;padding-top:10px">
        
        <div class="row">
            <div class="col-lg-12">
     
                <div class="overlay" id="spinner" style="margin-left:15%;margin-top:40%">
                    <i class="fa fa-refresh fa-spin"></i>
                </div>

                @* 1. Battery Type wise Passed Qty *@
                <div class="col-lg-12">
                    <div id='chartContainer2' style="width:100%; height:300px;"> </div>
                </div>

                @* 2. Battery Type wise failed Qty *@
                <div class="col-lg-12" style="margin-top:15px;">
                    <div id='chartContainer' style="width:100%; height:300px;"> </div>
                </div>

                @* 3. Rework *@
                <div class="col-lg-12" style="margin-top:15px;">
                    <div id='chartContainerRework' style="width:100%; height:300px;"> </div>
                </div>

                @* 4. Rejection *@
                <div class="col-lg-12" style="margin-top:15px; margin-bottom:25px;">
                    <div id='chartContainerRejection' style="width:100%; height:300px;"> </div>
                </div>
            
            </div>
          
        </div>
    </section>
</div>













