        padding: 10px 14px !important;
        margin: 0 !important;
        box-sizing: border-box !important;
        float: none !important;
        outline: none !important;
        box-shadow: none !important;
        transition: border-color 0.15s ease, background-color 0.2s ease !important;
    }

    .login-card .login-input:focus {
        border-color: var(--ar-primary) !important;
        box-shadow: 0 0 0 2px rgba(0, 122, 61, 0.15) !important;
    }

    .login-card .login-input-group:focus-within .login-input-addon {
        border-color: var(--ar-primary) !important;
    }
</style>

