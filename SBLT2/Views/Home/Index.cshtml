                        }
                        for (var i = 0; i < length; i++) {
                            var record = records[i];
                            if (record.MM_vURL && record.MM_vURL.indexOf("Home/Dashboard") !== -1) {
                                Data += '<li class="" id="Landing_Dashboard"><a href="../../Home/Dashboard"><i class="fa fa-circle-o"></i> Landing Dashboard </a></li>';
                                continue;
                            }
                            Data += '<li class="" id="' + record.MM_vUpdatedBy + '"><a href="' + record.MM_vURL + '"><i class="' + record.MM_vIcon + '"></i> ' + record.MM_vMenu_Name + ' </a></li>';
                            Get_submenu_2(record.MM_iId);
                            //Data += Data2;
                        }
                    },
                    error: function (xhr, status, error) {
                        //alert(JSON.stringify(xhr));
                    }

                });
            dataAdapter_per.dataBind();
        }
    });
</script>



