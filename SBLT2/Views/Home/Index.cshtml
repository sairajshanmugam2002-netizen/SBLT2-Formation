<style>
    #createButton {
        font-size: 1rem;
        font-weight: 500;
    }

        #createButton:hover {
            filter: brightness(120%);
            -webkit-filter: brightness(120%);
        }

    .right span {
        font-size: 0.875rem;
        color: #989898;
        display: block;
        text-align: right;
