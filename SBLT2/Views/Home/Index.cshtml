        function Get_submenu(Parent) {
            Data = "";
            var url = "../../Home/pr_getMenu_listbyParentnew?Role=" + Right + "&module=" + MID + "&ParentID=" + Parent;
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'MM_iId', type: 'string' },
                    { name: 'Type', type: 'string' },
                    { name: 'MM_vMenu_Name', type: 'string' },
                    { name: 'MM_iMenu_Order', type: 'string' },
                    { name: 'MM_iMenuLevel', type: 'string' },
                    { name: 'MM_iParentID', type: 'string' },
                    { name: 'MM_vURL', type: 'string' },
                    { name: 'MM_vIcon', type: 'string' },
                    { name: 'MM_vUpdatedBy', type: 'string' }
                ],
                id: 'id',
                url: url,
                async: false
            };
            var dataAdapter_per = new $.jqx.dataAdapter(source,
                {
                    contentType: 'application/json; charset=utf-8',
                    loadComplete: function () {
                        var length = dataAdapter_per.records.length;
                        var records = dataAdapter_per.records;
                        Data = "";
                        for (var i = 0; i < length; i++) {
                            var record = records[i];

                            Data += '<li class="" id="' + record.MM_vUpdatedBy + '"><a href="' + record.MM_vURL + '"><i class="' + record.MM_vIcon + '"></i> ' + record.MM_vMenu_Name + ' </a></li>';
