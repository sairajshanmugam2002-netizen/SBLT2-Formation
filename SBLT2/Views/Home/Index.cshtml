    /* ==========================================================================
       Login Success Toast Notification (Top-Right Fixed Enterprise UI)
       ========================================================================== */
    #toaster {
        position: fixed !important;
        top: 20px !important;
        right: 20px !important;
        left: auto !important;
        bottom: auto !important;
        width: auto !important;
        max-width: 420px !important;
        min-width: 280px;
        margin: 0 !important;
        padding: 0 !important;
        z-index: 999999 !important;
        pointer-events: none;
        box-sizing: border-box;
    }

    #toaster .alert {
        position: relative;
        display: flex !important;
        align-items: center !important;
        gap: 12px;
        padding: 12px 18px !important;
        margin: 0 0 10px 0 !important;
        border-radius: 8px !important;
        font-family: 'Roboto', -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif !important;
        font-size: 14px !important;
        font-weight: 500 !important;
        line-height: 1.4 !important;
        letter-spacing: 0.01em;
        pointer-events: auto !important;
        box-sizing: border-box !important;
        word-break: break-word;
        animation: toastSlideInRight 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        will-change: transform, opacity;
    }

    #toaster .alert-success {
        background: #ffffff !important;
        color: #0f172a !important;
        border: 1px solid #e2e8f0 !important;
        border-left: 4px solid #10b981 !important;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.12),
                    0 4px 6px -2px rgba(15, 23, 42, 0.05),
                    0 0 0 1px rgba(16, 185, 129, 0.08) !important;
    }

    #toaster .alert .toast-icon {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 24px !important;
        height: 24px !important;
        border-radius: 50% !important;
        background: #d1fae5 !important;
        color: #059669 !important;
        flex-shrink: 0 !important;
    }

    #toaster .alert .toast-icon svg {
        width: 14px;
        height: 14px;
        display: block;
    }

    #toaster .alert .message {
        color: #1e293b !important;
        font-weight: 500 !important;
        font-size: 14px !important;
        flex-grow: 1;
    }

    #toaster .alert .title {
        display: none !important;
    }

    #toaster .alert .close {
        background: transparent !important;
        border: 0 !important;
        color: #94a3b8 !important;
        font-size: 18px !important;
        font-weight: 600 !important;
        line-height: 1 !important;
        padding: 0 0 0 8px !important;
        margin: 0 !important;
        cursor: pointer !important;
        opacity: 0.7 !important;
        transition: color 0.15s ease, opacity 0.15s ease !important;
        outline: none !important;
        box-shadow: none !important;
    }

    #toaster .alert .close:hover {
        color: #334155 !important;
        opacity: 1 !important;
    }

    @@keyframes toastSlideInRight {
        0% {
            opacity: 0;
            transform: translateY(-8px) translateX(24px) scale(0.96);
        }
        100% {
            opacity: 1;
            transform: translateY(0) translateX(0) scale(1);
        }
    }

    /* Responsive Support: Desktop, Laptop, Tablet, Mobile */
    @@media (max-width: 600px) {
        #toaster {
            top: 16px !important;
            right: 16px !important;
            left: 16px !important;
            max-width: calc(100vw - 32px) !important;
            min-width: 0 !important;
        }
        #toaster .alert {
            padding: 10px 14px !important;
            font-size: 13.5px !important;
        }
    }

