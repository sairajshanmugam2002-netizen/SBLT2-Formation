@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in | MVRLA Formation</title>

    <!-- ANTI-FOUT Immediate Theme Script (Zero-Flicker Execution) -->
    <script type="text/javascript">
        (function () {
            try {
                var savedTheme = localStorage.getItem('app_theme');
                if (savedTheme === 'dark') {
                    document.documentElement.classList.add('dark-theme', 'dark-mode');
                } else {
                    document.documentElement.classList.remove('dark-theme', 'dark-mode');
                }
            } catch (e) { }
        })();
    </script>

    <link href="~/Content/materialize.min.css" rel="stylesheet" />
    <link href="~/Content/style_.css" rel="stylesheet" />
    <link href="~/Content/fa/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/modern-theme-overrides.css" rel="stylesheet" />

    <link href="~/Content/JQWidgets/jqx.base.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-2.1.1.min.js"></script>
    <script src="~/Scripts/JQWidgets/jqx-all.js"></script>
    <script type="text/javascript" src="~/Scripts/JQWidgets/jqxcore.js"></script>
    <script src="~/Scripts/materialize.min.js"></script>
    <script src="~/Scripts/jquery.toaster.js"></script>
</head>

<!-- Login page design: split screen (brand panel + sign-in form). Classes prefixed lg- to stay clear of materialize / global theme rules -->
<style>
    html, body {
        margin: 0;
        min-height: 100%;
    }

    body.login-page {
        min-height: 100vh;
        font-family: var(--ar-font, 'Segoe UI', Roboto, Arial, sans-serif);
        background: var(--content-bg, #f5f7fa) !important;
        color: var(--text-primary, #1f2937) !important;
    }

    .lg-shell {
        display: flex;
        min-height: 100vh;
        width: 100%;
    }

    /* ---------- Left: brand panel ---------- */
    .lg-brand {
        position: relative;
        flex: 1 1 52%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 48px 56px;
        overflow: hidden;
        color: #ffffff;
        background: linear-gradient(150deg, #00843f 0%, #006a35 45%, #013d20 100%);
    }

    /* Decorative concentric arcs (Amara Raja swirl colours), centred on the panel's bottom-right corner */
    .lg-arc {
        position: absolute;
        border-radius: 50%;
        border: 14px solid transparent;
        pointer-events: none;
        transform: translate(50%, 50%);
        right: 0;
        bottom: 0;
    }

    .lg-arc-1 { width: 760px; height: 760px; border-top-color: rgba(178, 210, 53, .22); border-left-color: rgba(178, 210, 53, .22); }
    .lg-arc-2 { width: 600px; height: 600px; border-top-color: rgba(243, 123, 35, .22); border-left-color: rgba(243, 123, 35, .22); }
    .lg-arc-3 { width: 440px; height: 440px; border-top-color: rgba(236, 92, 160, .22); border-left-color: rgba(236, 92, 160, .22); }
    .lg-arc-4 { width: 280px; height: 280px; border-top-color: rgba(0, 150, 199, .26); border-left-color: rgba(0, 150, 199, .26); }

    .lg-brand-top,
    .lg-brand-main,
    .lg-brand-foot {
        position: relative;
        z-index: 1;
    }

    .lg-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, .12);
        border: 1px solid rgba(255, 255, 255, .22);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .6px;
        text-transform: uppercase;
    }

    .lg-badge-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #7CF0A6;
        box-shadow: 0 0 0 3px rgba(124, 240, 166, .25);
    }

    .login-page .lg-brand-main h1 {
        margin: 0 0 14px 0 !important;
        padding: 0 !important;
        border: 0 !important;
        font-size: 40px !important;
        line-height: 1.15 !important;
        font-weight: 800 !important;
        letter-spacing: -.5px;
        color: #ffffff !important;
    }

    .login-page .lg-brand-main h1::before,
    .login-page .lg-brand-main h1::after {
        content: none !important;
        display: none !important;
    }

    .lg-brand-main p {
        margin: 0 0 32px 0;
        max-width: 440px;
        font-size: 15px;
        line-height: 1.6;
        color: rgba(255, 255, 255, .82);
    }

    .lg-features {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 14px;
        max-width: 440px;
    }

    .lg-features li {
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 14px;
        color: rgba(255, 255, 255, .92);
    }

    .lg-feature-icon {
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, .12);
        border: 1px solid rgba(255, 255, 255, .18);
        font-size: 16px;
    }

    .lg-features strong {
        display: block;
        font-size: 14px;
        font-weight: 700;
        color: #ffffff;
    }

    .lg-features span {
        font-size: 12.5px;
        color: rgba(255, 255, 255, .72);
    }

    .lg-brand-foot {
        font-size: 12px;
        color: rgba(255, 255, 255, .65);
    }

    /* ---------- Right: sign-in form ---------- */
    .lg-panel {
        position: relative;
        flex: 1 1 48%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 24px;
        background: var(--bg-card, #ffffff);
    }

    .lg-form-wrap {
        width: 100%;
        max-width: 400px;
    }

    .lg-logo-chip {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        margin-bottom: 28px;
        border-radius: 10px;
        background: #ffffff;
    }

    .login-page .lg-logo-chip img.lg-logo {
        height: 56px !important;
        width: auto !important;
        object-fit: contain !important;
        object-position: center !important;
        margin: 0 !important;
        display: block !important;
    }

    .lg-form-wrap h2 {
        margin: 0 0 6px 0;
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -.3px;
        color: var(--text-primary, #1f2937);
    }

    .lg-sub {
        margin: 0 0 28px 0;
        font-size: 14px;
        color: var(--text-secondary, #6b7280);
    }

    .lg-field {
        margin-bottom: 18px;
    }

    .login-page .lg-field label.lg-label {
        display: block !important;
        margin: 0 0 7px 0 !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        color: var(--text-primary, #1f2937) !important;
        position: static !important;
        transform: none !important;
    }

    .lg-input-wrap {
        position: relative;
    }

    .lg-input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-secondary, #6b7280);
        font-size: 15px;
        pointer-events: none;
        transition: color .15s ease;
    }

    .login-page .lg-input-wrap input.lg-input {
        display: block !important;
        width: 100% !important;
        height: 48px !important;
        min-height: 48px !important;
        margin: 0 !important;
        padding: 0 44px 0 42px !important;
        box-sizing: border-box !important;
        border: 1.5px solid var(--input-border, #CBD5E1) !important;
        border-radius: 10px !important;
        background: var(--input-bg, #ffffff) !important;
        color: var(--input-text, #1f2937) !important;
        font-size: 14.5px !important;
        font-weight: 500 !important;
        box-shadow: none !important;
        outline: none !important;
        transition: border-color .15s ease, box-shadow .15s ease !important;
    }

    .login-page .lg-input-wrap input.lg-input::placeholder {
        color: var(--input-placeholder, #9CA3AF);
        font-weight: 400;
    }

    .login-page .lg-input-wrap input.lg-input:focus {
        border-color: var(--ar-primary, #007A3D) !important;
        box-shadow: 0 0 0 4px var(--ar-primary-ring, rgba(0, 122, 61, .18)) !important;
    }

    .lg-input-wrap:focus-within .lg-input-icon {
        color: var(--ar-primary, #007A3D);
    }

    .lg-eye {
        position: absolute;
        right: 6px;
        top: 50%;
        transform: translateY(-50%);
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: var(--text-secondary, #6b7280);
        cursor: pointer;
        font-size: 15px;
    }

    .lg-eye:hover,
    .lg-eye:focus {
        color: var(--ar-primary, #007A3D);
        background: var(--ar-primary-subtle, #F0FDF4);
        outline: none;
    }

    .lg-caps {
        display: none;
        margin-top: 6px;
        font-size: 12px;
        color: #B45309;
    }

    .lg-caps.show {
        display: block;
    }

    .login-page button.lg-submit {
        display: flex !important;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100% !important;
        height: 50px !important;
        margin: 26px 0 0 0 !important;
        border: 0 !important;
        border-radius: 10px !important;
        background: var(--ar-primary, #007A3D) !important;
        color: #ffffff !important;
        font-size: 15px !important;
        font-weight: 700 !important;
        letter-spacing: .3px;
        text-transform: none !important;
        cursor: pointer;
        box-shadow: 0 8px 18px -6px rgba(0, 122, 61, .55) !important;
        transition: background .15s ease, transform .1s ease, box-shadow .15s ease !important;
    }

    .login-page button.lg-submit:hover {
        background: var(--ar-primary-hover, #006030) !important;
        box-shadow: 0 10px 22px -6px rgba(0, 122, 61, .6) !important;
    }

    .login-page button.lg-submit:active {
        transform: translateY(1px);
    }

    .login-page button.lg-submit:disabled {
        opacity: .75;
        cursor: wait;
    }

    .lg-help {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 24px;
        padding: 12px 14px;
        border-radius: 10px;
        background: var(--bg-secondary, #f5f7fa);
        border: 1px solid var(--border-color, #e5e7eb);
        font-size: 12.5px;
        line-height: 1.5;
        color: var(--text-secondary, #6b7280);
    }

    .lg-help i {
        margin-top: 2px;
        color: var(--ar-primary, #007A3D);
    }

    .lg-foot-mobile {
        display: none;
        margin-top: 28px;
        text-align: center;
        font-size: 11.5px;
        color: var(--text-secondary, #6b7280);
    }

    /* materialize paints focused buttons teal */
    .login-page .lg-eye:focus {
        background: var(--ar-primary-subtle, #F0FDF4) !important;
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 1100px) {
        .lg-brand { padding: 40px; }
        .lg-brand-main h1 { font-size: 32px; }
    }

    @@media (max-width: 860px) {
        .lg-brand { display: none; }
        .lg-panel { padding: 32px 16px; background: var(--content-bg, #f5f7fa); }
        .lg-form-wrap {
            padding: 28px 22px;
            border-radius: 14px;
            background: var(--bg-card, #ffffff);
            border: 1px solid var(--border-color, #e5e7eb);
            border-top: 4px solid var(--ar-primary, #007A3D);
            box-shadow: 0 10px 30px -12px rgba(15, 23, 42, .25);
        }
        .lg-foot-mobile { display: block; }
    }
</style>

<style>
    #createButton {
        font-size: 1rem;
        font-weight: 500;
    }

        #createButton:hover {
            filter: brightness(120%);
            -webkit-filter: brightness(120%);
        }

    .right span {
        font-size: 0.875rem;
        color: #989898;
        display: block;
        text-align: right;
    }

    /* ==========================================================================
       Login Success Toast Notification (Top-Right Fixed Enterprise UI)
       ========================================================================== */
    #toaster {
        position: fixed !important;
        top: 20px !important;
        right: 20px !important;
        left: auto !important;
        bottom: auto !important;
        width: auto !important;
        max-width: 420px !important;
        min-width: 280px;
        margin: 0 !important;
        padding: 0 !important;
        z-index: 999999 !important;
        pointer-events: none;
        box-sizing: border-box;
    }

    #toaster .alert {
        position: relative;
        display: flex !important;
        align-items: center !important;
        gap: 12px;
        padding: 12px 18px !important;
        margin: 0 0 10px 0 !important;
        border-radius: 8px !important;
        font-family: 'Roboto', -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif !important;
        font-size: 14px !important;
        font-weight: 500 !important;
        line-height: 1.4 !important;
        letter-spacing: 0.01em;
        pointer-events: auto !important;
        box-sizing: border-box !important;
        word-break: break-word;
        animation: toastSlideInRight 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        will-change: transform, opacity;
    }

    #toaster .alert-success {
        background: #ffffff !important;
        color: #0f172a !important;
        border: 1px solid #e2e8f0 !important;
        border-left: 4px solid #10b981 !important;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.12),
                    0 4px 6px -2px rgba(15, 23, 42, 0.05),
                    0 0 0 1px rgba(16, 185, 129, 0.08) !important;
    }

    #toaster .alert .toast-icon {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 24px !important;
        height: 24px !important;
        border-radius: 50% !important;
        background: #d1fae5 !important;
        color: #059669 !important;
        flex-shrink: 0 !important;
    }

    #toaster .alert .toast-icon svg {
        width: 14px;
        height: 14px;
        display: block;
    }

    #toaster .alert .message {
        color: #1e293b !important;
        font-weight: 500 !important;
        font-size: 14px !important;
        flex-grow: 1;
    }

    #toaster .alert .title {
        display: none !important;
    }

    #toaster .alert .close {
        background: transparent !important;
        border: 0 !important;
        color: #94a3b8 !important;
        font-size: 18px !important;
        font-weight: 600 !important;
        line-height: 1 !important;
        padding: 0 0 0 8px !important;
        margin: 0 !important;
        cursor: pointer !important;
        opacity: 0.7 !important;
        transition: color 0.15s ease, opacity 0.15s ease !important;
        outline: none !important;
        box-shadow: none !important;
    }

    #toaster .alert .close:hover {
        color: #334155 !important;
        opacity: 1 !important;
    }

    @@keyframes toastSlideInRight {
        0% {
            opacity: 0;
            transform: translateY(-8px) translateX(24px) scale(0.96);
        }
        100% {
            opacity: 1;
            transform: translateY(0) translateX(0) scale(1);
        }
    }

    /* Responsive Support: Desktop, Laptop, Tablet, Mobile */
    @@media (max-width: 600px) {
        #toaster {
            top: 16px !important;
            right: 16px !important;
            left: 16px !important;
            max-width: calc(100vw - 32px) !important;
            min-width: 0 !important;
        }
        #toaster .alert {
            padding: 10px 14px !important;
            font-size: 13.5px !important;
        }
    }

</style>

<script type="text/javascript">
    $(window).load(function () {
        $(".loader").fadeOut("slow");



    });
</script>
<script type="text/javascript">
    $(document).ready(function () {

        var flag = false;
        var isLoggingIn = false;

        $('#Password').keypress(function (e) {
            if (e.keyCode == 13) {  //detect the enter key
                login();
            }
        });

        $('#btnlogin').on('click', function () {
            login();
        });

        var Right = '';
        function login() {
            if (isLoggingIn) return;
            var userName = $.trim($('#UserName').val());
            var password = $('#Password').val();

            if (userName === "" || password === "") {
                $.toaster({ priority: 'warning', title: '', message: 'Please enter User Name and Password' });
                return;
            }

            $("#spinner").show();
            $('#btnlogin').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Signing in...');

            var f = "false";
            $.ajax({
                type: "POST",
                url: "../../Home/pr_getlogin1?user=" + encodeURIComponent(userName) + "&pwd=" + encodeURIComponent(password),
                dataType: "text",
                async: false,
                success: function (response) {
                    f = response;
                },
                error: function () {
                    f = "false";
                }
            });

            if (f === "false" || !f) {
                $("#spinner").hide();
                $('#btnlogin').prop('disabled', false).html('<i class="fa fa-sign-in"></i> Sign in');
                $('#Password').val("");
                $.toaster({ priority: 'danger', title: '', message: 'Invalid User Name or Password' });
            }
            else {
                isLoggingIn = true;
                var res = f.split("~");
                sessionStorage.setItem('Name', res[0]);
                sessionStorage.setItem('rights', res[1]);
                sessionStorage.setItem('user', res[0]);
                sessionStorage.setItem('Area', res[2]);
                sessionStorage.setItem('User_ID', res[4]);

                Right = res[1];

                Loaddetails(1);
                $("#spinner").hide();

                $.toaster({ priority: 'success', title: '', message: 'Login successful! Redirecting...' });

                setTimeout(function () {
                    window.location = '@Url.Action("Dashboard", "Home")';
                }, 1000);
            }
        }
