<script type="text/javascript">
    $(document).ready(function () {

        var flag = false;
        var isLoggingIn = false;

        $('#Password').keypress(function (e) {
            if (e.keyCode == 13) {  //detect the enter key
                login();
            }
        });

        $('#btnlogin').on('click', function () {
            login();
        });

        var Right = '';
        function login() {
            if (isLoggingIn) return;
            var userName = $.trim($('#UserName').val());
            var password = $('#Password').val();

            if (userName === "" || password === "") {
                $.toaster({ priority: 'warning', title: '', message: 'Please enter User Name and Password' });
                return;
            }

            $("#spinner").show();
            $('#btnlogin').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> SIGNING IN...');

            var f = "false";
            $.ajax({
                type: "POST",
                url: "../../Home/pr_getlogin1?user=" + encodeURIComponent(userName) + "&pwd=" + encodeURIComponent(password),
                dataType: "text",
                async: false,
                success: function (response) {
                    f = response;
                },
                error: function () {
                    f = "false";
                }
            });

            if (f === "false" || !f) {
                $("#spinner").hide();
                $('#btnlogin').prop('disabled', false).html('<i class="fa fa-sign-in"></i> SIGN IN TO FORMATION CONSOLE');
                $('#Password').val("");
                $.toaster({ priority: 'danger', title: '', message: 'Invalid User Name or Password' });
            }
            else {
                isLoggingIn = true;
                var res = f.split("~");
                sessionStorage.setItem('Name', res[0]);
                sessionStorage.setItem('rights', res[1]);
                sessionStorage.setItem('user', res[0]);
                sessionStorage.setItem('Area', res[2]);
                sessionStorage.setItem('User_ID', res[4]);

                Right = res[1];

                Loaddetails(1);
                $("#spinner").hide();

                $.toaster({ priority: 'success', title: '', message: 'Login successful! Redirecting...' });

                setTimeout(function () {
                    window.location = '@Url.Action("Dashboard", "Home")';
                }, 1000);
            }
        }
        var MID = 0;
        var Data = "";

        function Loaddetails(IDS) {
            MID = IDS;
            var url = "../../Home/pr_getMenu_listnew1?Role= " + Right + "&module=" + IDS;
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'MM_iId', type: 'string' },
                    { name: 'Type', type: 'string' },
                    { name: 'MM_vMenu_Name', type: 'string' },
                    { name: 'MM_iMenu_Order', type: 'string' },
                    { name: 'MM_iMenuLevel', type: 'string' },
                    { name: 'MM_iParentID', type: 'string' },
                    { name: 'MM_vURL', type: 'string' },
                    { name: 'MM_vIcon', type: 'string' },
                    { name: 'MM_vUpdatedBy', type: 'string' },
                ],
                id: 'id',
