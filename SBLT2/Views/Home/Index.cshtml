<body class="login-page">

    <!-- Floating Dark / Light Mode Toggle Button -->
    <div class="login-theme-toggle-wrapper">
        <button type="button" 
                id="login-theme-toggle" 
                class="btn-global-theme-toggle" 
                onclick="window.toggleLoginTheme()" 
                title="Toggle Dark / Light Theme" 
                aria-label="Toggle Theme">
            <i class="fa fa-moon-o theme-toggle-icon" id="login-theme-icon"></i>
            <span class="theme-toggle-text" id="login-theme-text">Dark Mode</span>
        </button>
    </div>

    <div style="width: 100%; max-width: 440px; margin: auto;">
        <!-- Brand Header Above Card -->
        <div style="text-align: center; margin-bottom: 24px;">
            <div style="display: inline-flex; align-items: center; justify-content: center; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 12px 20px; margin-bottom: 12px; box-shadow: var(--ar-shadow-sm);">
                <img src="~/img/Logo11.png" class="brand-logo-icon" style="height: 38px; width: 31px; object-fit: cover; object-position: 0% 50%; margin-right: 8px;" alt="Amara Raja" onerror="this.src='../../img/Logo11.png'" />
                <span class="amara-raja-name">AMARA RAJA</span>
            </div>
            <h2 style="font-size: 20px; font-weight: 800; color: var(--text-primary); margin: 0; letter-spacing: -0.3px;">
                MVRLA FORMATION PLANT
            </h2>
            <p style="font-size: 13px; color: var(--text-secondary); margin: 4px 0 0 0;">
                Battery Barcode Traceability & Quality Console
            </p>
        </div>

        <!-- Modern Industrial Card -->
        <div class="box login-card" style="background: var(--card-bg) !important; border-radius: 12px !important; box-shadow: var(--ar-shadow-lg) !important; border: 1px solid var(--border-color) !important; border-top: 4px solid var(--ar-primary) !important; padding: 32px 28px !important; margin-bottom: 20px !important;">
            <div style="margin-bottom: 24px; border-bottom: 1px solid var(--border-color); padding-bottom: 16px;">
                <h3 style="font-size: 16px; font-weight: 700; color: var(--text-primary); margin: 0 0 4px 0; display: flex; align-items: center; gap: 8px;">
                    <i class="fa fa-shield" style="color: var(--ar-primary);"></i> Operator Authentication
                </h3>
                <span style="font-size: 12px; color: var(--text-secondary);">Enter your plant credentials to access the terminal</span>
            </div>

            <form id="form1" onsubmit="return false;" style="margin: 0; padding: 0;">
                <!-- User Name Field -->
                <div class="form-group" style="margin-bottom: 20px;">
                    <label for="UserName" class="login-label" style="display: block; width: 100%; text-align: left; font-size: 12.5px; font-weight: 600; color: var(--text-primary); margin: 0 0 6px 0; padding: 0;">
                        Username <span class="text-danger" style="color: #EF4444;">*</span>
