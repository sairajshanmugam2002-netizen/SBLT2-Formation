<script type="text/javascript">
    $(document).ready(function () {

        var flag = false;

        $('#Password').keypress(function (e) {
            if (e.keyCode == 13) {  //detect the enter key
                login();
            }
        });

        $('#btnlogin').on('click', function () {
            login();
        });

        var Right = '';
        function login() {
            $("#spinner").show();
            flag = true;
            if ($('#UserName').val() == "" || $('#Password').val() == "") {
                alert("Enter Valid User Name");
                $("#spinner").hide();
                //$.toaster({ priority: 'danger', title: 'Notice', message: 'User Name and Password Should Not Empty' });
                flag = false;
            }
            if (flag == true) {
                var f = "false";
                $.ajax({
                    type: "POST",
                    url: "../../Home/pr_getlogin1?user=" + $('#UserName').val() + "&pwd=" + $('#Password').val(),
                    dataType: "text",
                    async: false,
                    success: function (response) {
                        f = response;
                    }
                });
                if (f == "false") {
                    alert("Enter Valid User Name & Password");
                    $('#UserName').val("");
                    $('#Password').val("");
                    $("#spinner").hide();
                }
                else {
                    var res = f.split("~");
                    sessionStorage.setItem('Name', res[0]);
                    sessionStorage.setItem('rights', res[1]);
                    sessionStorage.setItem('user', res[0]);
                    sessionStorage.setItem('Area', res[2]);
                    sessionStorage.setItem('User_ID', res[4]);

                    //sessionStorage.setItem('Points', res[5]);

                    Right = res[1];

                    Loaddetails(1);
                    var menues = sessionStorage.getItem('Menu');
                    //alert(menues);
                    if (menues == null) {
                        //Loaddetails(1);
                    } else {
                        //this function is executed after function1
                        window.location = "../Home/Home";
                    }
                }
            }
        }
        var MID = 0;
        var Data = "";

        function Loaddetails(IDS) {
            MID = IDS;
            var url = "../../Home/pr_getMenu_listnew1?Role= " + Right + "&module=" + IDS;
            var source =
            {
                datatype: "json",
                datafields: [
                    { name: 'MM_iId', type: 'string' },
                    { name: 'Type', type: 'string' },
                    { name: 'MM_vMenu_Name', type: 'string' },
                    { name: 'MM_iMenu_Order', type: 'string' },
                    { name: 'MM_iMenuLevel', type: 'string' },
                    { name: 'MM_iParentID', type: 'string' },
                    { name: 'MM_vURL', type: 'string' },
                    { name: 'MM_vIcon', type: 'string' },
                    { name: 'MM_vUpdatedBy', type: 'string' },
                ],
                id: 'id',
                url: url,
                async: false
            };
            var dataAdapter_per = new $.jqx.dataAdapter(source,
                {
                    contentType: 'application/json; charset=utf-8',
                    loadComplete: function () {
                        var length = dataAdapter_per.records.length;
                        var records = dataAdapter_per.records;
                        var html = "";
                        var s = "";
                        html += '<ul class="sidebar-menu">';
                        for (var i = 0; i < length; i++) {
                            var record = records[i];
                            $("#wait").text("Waiti.." + i);
                            html += ' <li class="treeview " id="' + record.MM_vUpdatedBy + '">';
                            html += '<a href="#">';
                            html += '<i class="' + record.MM_vIcon + '"></i>';
                            html += '<span> ' + record.MM_vMenu_Name + ' </span>';
                            html += '<i class="fa fa-angle-left pull-right"></i>';
                            html += '</a>';
                            html += '<ul class="treeview-menu  ">';
                            Get_submenu(record.MM_iId);
                            html += Data;
                            html += '</ul> </li>';
                        }
                        html += '</Ul>';
                        sessionStorage.setItem('Menu', html);
                        //$("#table").html(html);
                    },
                    error: function (xhr, status, error) {
                        //alert(JSON.stringify(xhr));
                    }
                });
            dataAdapter_per.dataBind();
        }


