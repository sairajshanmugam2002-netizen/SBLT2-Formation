    <!-- Global Theme Management Script for Login Page -->
    <script type="text/javascript">
        window.getLoginTheme = function () {
            try {
                return localStorage.getItem('app_theme') === 'dark' ? 'dark' : 'light';
            } catch (e) {
                return 'light';
            }
        };

        window.updateLoginThemeUI = function (theme) {
            var isDark = (theme === 'dark');
            var $icon = $('#login-theme-icon');
            var $text = $('#login-theme-text');
            var $btn = $('#login-theme-toggle');

            if (isDark) {
                $('html').addClass('dark-theme dark-mode');
                $('body').addClass('dark-theme dark-mode');
                if ($icon.length) {
                    $icon.removeClass('fa-moon-o').addClass('fa-sun-o');
                }
                if ($text.length) {
                    $text.text('Light Mode');
                }
                if ($btn.length) {
                    $btn.attr('title', 'Switch to Light Mode');
                }
            } else {
                $('html').removeClass('dark-theme dark-mode');
                $('body').removeClass('dark-theme dark-mode');
                if ($icon.length) {
                    $icon.removeClass('fa-sun-o').addClass('fa-moon-o');
                }
                if ($text.length) {
                    $text.text('Dark Mode');
                }
                if ($btn.length) {
                    $btn.attr('title', 'Switch to Dark Mode');
                }
            }
        };

        window.toggleLoginTheme = function () {
            var current = window.getLoginTheme();
            var next = (current === 'dark') ? 'light' : 'dark';
            try {
                localStorage.setItem('app_theme', next);
            } catch (e) { }
            window.updateLoginThemeUI(next);
        };

        $(document).ready(function () {
            window.updateLoginThemeUI(window.getLoginTheme());
        });
    </script>

