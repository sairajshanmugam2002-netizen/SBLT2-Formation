                                </span>
                            </h3>
                        </div>
                        <div class="panel-body">
                            <form class="form-horizontal" role="form" id="form1">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label no-padding-right" for="form-field-1">User Name</label>
                                    <div class="col-sm-7">
                                        <input id="User_Name_" class="form-control" />
                                    </div>
                                </div>


                                <div class="form-group">
                                    <label class="col-sm-4 control-label no-padding-right" for="form-field-1">Please Choose Profile Image</label>
                                    <div class="col-sm-6">
                                        <input id="LP_image" type="file" />
                                    </div>
                                </div>
                            </form>
                            <div class="col-sm-5"></div>
                            <p>
                                <button id="btn_Save___" class="btn btn-white btn-info btn-bold">
                                    <i class="ace-icon fa fa-floppy-o bigger-120 blue"></i>
                                    <span id="btn_save_label___">Save</span>
                                </button>
                                <button id="btn_Clear" class="btn btn-white btn-warning btn-bold">
                                    <i class="ace-icon fa fa-trash-o bigger-120 orange"></i>
                                    Clear
                                </button>
                                <button class="btn btn-white btn-default btn-round" data-dismiss="modal">
                                    <i class="ace-icon fa fa-times red2"></i>
                                    Close
                                </button>
                            </p>
                        </div>
                    </div>
                </div>
