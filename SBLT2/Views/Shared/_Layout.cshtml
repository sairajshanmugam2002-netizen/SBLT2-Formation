<script type="text/javascript">
    // Global Theme Management System
    window.getAppTheme = function () {
        try {
            return localStorage.getItem('app_theme') === 'dark' ? 'dark' : 'light';
        } catch (e) {
            return 'light';
        }
    };

    window.updateThemeUI = function (theme) {
        var isDark = (theme === 'dark');
        var $icon = $('#theme-toggle-icon');
        var $text = $('#theme-toggle-text');
        var $btn = $('#btn-global-theme-toggle');

        if (isDark) {
            $('html').addClass('dark-theme dark-mode');
            $('body').addClass('dark-theme dark-mode');
            $('.wrapper').addClass('dark-theme dark-mode');
            if ($icon.length) {
                $icon.removeClass('fa-moon-o').addClass('fa-sun-o');
            }
            if ($text.length) {
                $text.text('Light Mode');
            }
            if ($btn.length) {
                $btn.attr('title', 'Switch to Light Mode');
            }
        } else {
            $('html').removeClass('dark-theme dark-mode');
            $('body').removeClass('dark-theme dark-mode');
            $('.wrapper').removeClass('dark-theme dark-mode');
            if ($icon.length) {
                $icon.removeClass('fa-sun-o').addClass('fa-moon-o');
            }
            if ($text.length) {
                $text.text('Dark Mode');
            }
            if ($btn.length) {
                $btn.attr('title', 'Switch to Dark Mode');
            }
        }
    };

    window.setAppTheme = function (theme) {
        try {
            localStorage.setItem('app_theme', theme);
        } catch (e) { }
        window.updateThemeUI(theme);

        // Notify all components, charts, and grids immediately without requiring reload
        $(document).trigger('themeChanged', [theme]);
        try {
            window.dispatchEvent(new CustomEvent('themeChanged', { detail: { theme: theme } }));
        } catch (e) { }

        setTimeout(function () {
            $(window).trigger('resize');
            if ($("#Grid").length && typeof $("#Grid").jqxGrid === 'function') {
                try {
                    $("#Grid").jqxGrid('refresh');
                } catch (e) { }
            }
        }, 50);
    };

    window.toggleAppTheme = function () {
        var current = window.getAppTheme();
        var next = (current === 'dark') ? 'light' : 'dark';
        window.setAppTheme(next);
    };

    $(document).ready(function () {
        var current = window.getAppTheme();
        window.updateThemeUI(current);

        var User = sessionStorage.getItem("user") || "Operator";
        var html = sessionStorage.getItem('Menu');
        $("#User_Name").text(User);
        if (html) {
            $("#vin_Menu").html(html);
        }

        // Global HTML Table Layout Handler:
        // Automatically ensures every standard HTML table is safely wrapped inside .table-wrapper.
        // NEVER wraps JQWidgets Grids (jqxGrid has its own scrolling engine).
        function ensureTableWrappers() {
            $('table.table:not([class*="jqx"])').each(function () {
                var $t = $(this);
                if (!$t.parent().hasClass('table-wrapper') && !$t.parent().hasClass('grid-wrapper') && !$t.parent().hasClass('table-responsive')) {
                    $t.wrap('<div class="table-wrapper"></div>');
                }
            });
        }

        ensureTableWrappers();

        // Re-check after dynamic content or AJAX completes
        $(document).ajaxComplete(function () {
            ensureTableWrappers();
        });

        // Window resize handler to maintain grid responsiveness across desktop/laptop/tablet/mobile
        var resizeTimer;
        $(window).on('resize orientationchange', function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
                if ($("#Grid").length && typeof $("#Grid").jqxGrid === 'function') {
                    try {
                        $("#Grid").jqxGrid('refresh');
                    } catch (e) { }
                }
            }, 150);
        });

        // Sidebar pushMenu toggle animation listener: refresh grids & charts after sidebar expands/collapses
        $(document).on('expanded.pushMenu', function () {
            $('#sidebar-collapse12').attr('title', 'Collapse Sidebar (<)');
            setTimeout(function () {
                $(window).trigger('resize');
                if ($("#Grid").length && typeof $("#Grid").jqxGrid === 'function') {
                    try {
                        $("#Grid").jqxGrid('refresh');
                    } catch (e) { }
                }
            }, 320);
        });

        $(document).on('collapsed.pushMenu', function () {
            $('#sidebar-collapse12').attr('title', 'Expand Sidebar (>)');
            setTimeout(function () {
                $(window).trigger('resize');
                if ($("#Grid").length && typeof $("#Grid").jqxGrid === 'function') {
                    try {
                        $("#Grid").jqxGrid('refresh');
                    } catch (e) { }
                }
            }, 320);
        });
    });
</script>

