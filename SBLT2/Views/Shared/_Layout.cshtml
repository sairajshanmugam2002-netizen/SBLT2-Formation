
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Admin | Dashboard</title>
    <!-- Tell the browser to be responsive to screen width -->
    <meta content="width=device-width, initial-scale=1, maximum-scale=1.1, user-scalable=no" name="viewport">
    <!-- Bootstrap 3.3.5 -->
    @*<link href='https://fonts.googleapis.com/css?family=Aldrich' rel='stylesheet'>
        <link href='https://fonts.googleapis.com/css?family=Amiko' rel='stylesheet'>
        <link href='https://fonts.googleapis.com/css?family=Cutive' rel='stylesheet'>
    *@
    @System.Web.Optimization.Styles.Render("~/bundle/css")
    <link href="~/Content/Style.css" rel="stylesheet" />
    @System.Web.Optimization.Scripts.Render("~/bundle/js")

</head>

<style>

    .box-title {
        font-family: 'Amiko';
        font-size: 15px !important;
        font-weight: bold !important;
        color: #160202
    }

    .tooltip.bottom .tooltip-inner {
        max-width: 310px;
        padding: 3px 8px;
        color: #fff;
        text-align: center;
        background-color: #245973;
        border-radius: 5px
    }
</style>

<script type="text/javascript">

    $(document).ready(function () {

        var User = sessionStorage.getItem("user");
        //(User);
        var html = sessionStorage.getItem('Menu');
        //var user = sessionStorage.getItem('user');
        // $("#User_Name").val(User);
        $("#User_Name").text(User);
        $("#vin_Menu").html(html);

        if ($(window).width() < 600) {
            $("#Limg").removeClass("hidden");
            $("#Ltxt").addClass("hidden");
        }
        else {
            $("#Limg").addClass("hidden");
            $("#Ltxt").removeClass("hidden");
        }
    });


</script>

<style>

    .content {
        min-height: 250px;
        padding-top: 5px;
        margin-right: auto;
        margin-left: auto;
        padding-left: 15px;
        padding-right: 15px;
        padding-bottom: 0px;
    }

    .box {
        position: relative;
        border-radius: 3px;
        background: #ffffff;
        border-top: 3px solid #d2d6de;
        margin-bottom: 8px;
        width: 100%;
        box-shadow: 0 1px 1px rgba(0,0,0,0.1);
    }
</style>
<body class="hold-transition skin-blue sidebar-mini" style="font-family:Verdana">

    <div class="wrapper">
        <header class="main-header">
            <!-- Logo -->
            <!-- Header Navbar: style can be found in header.less -->
            <nav class="navbar navbar-static-top" role="navigation" style="height:40px">
                <!-- Sidebar toggle button-->
                <a href="#" class="sidebar-toggle" id="sidebar-collapse12" data-toggle="offcanvas" role="button">
                    <span class="sr-only">Toggle navigation</span>
                </a>
                <img src="../../img/Logo11.png" class="hidden" id="Limg" style="height:50px;width:180px" alt="User Image">
                <span id="Ltxt" class="hidden" style=" line-height:55px;  flex-align:center; font-family:Aldrich; font-size:15px; color:white"> Barcode Traceability System</span>
                <div class="navbar-custom-menu">
                    <ul class="nav navbar-nav">


                        <!-- User Account: style can be found in dropdown.less -->
                        <li class="dropdown user user-menu">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                @* <span id="Letter" style="background-color :#0073b7; border-bottom-style:solid;border-bottom-color:black; padding:5px;border-radius:30px;font-family: 'Cutive';font-size: 22px;" >&nbsp;&nbsp;<span id="Letter1"></span>&nbsp;&nbsp; </span>*@
                                <img id="UserImage" src="../../img/Admin.jpg" class="user-image" alt="">
                                <span class="hidden-xs"><span id="User_Name">User</span></span>
                            </a>
                            <ul class="dropdown-menu">
                                <!-- User image -->
                                <li class="user-header">
                                    <img id="blah" src="../../img/user2-160x160.jpg" class="img-circle" alt="User Image">
                                    @* <p>
                                            Vinoth Kumar - Web Developer
                                            <small>Member since Nov. 2017</small>
                                        </p>*@
                                </li>
                                <!-- Menu Body -->
                                <li class="user-body">

                                </li>
                                <!-- Menu Footer-->
                                <li class="user-footer">
                                    <div class="pull-left">
                                        <a href="#" id="btn_logo" class="btn btn-default btn-flat">Profile</a>
                                    </div>
                                    <div class="pull-right">
                                        <a href="../../Home/Index" class="btn btn-default btn-flat">Sign out</a>
                                    </div>
                                </li>
                            </ul>
                        </li>
                        <!-- Control Sidebar Toggle Button -->

                    </ul>
                </div>
            </nav>
        </header>
        <!-- Left side column. contains the logo and sidebar -->
        <aside class="main-sidebar" Style="padding-top:0px; margin-top:0px">
            <!-- sidebar: style can be found in sidebar.less -->
            <section class="sidebar">
                <!-- Sidebar user panel -->
                <div class="user-panel" style="background-color:#3c8dbc">
                    <div class="pull-left image">
                        <img src="../../img/Logo11.png" style="height:30px;width:160px" alt="User Image">
                    </div>
                    <div class="pull-left info">
                        <p style="font-family:Verdana; font-size:11px;  "> <br /> <font style="line-height:20px;"></font></p>

                    </div>
                </div>
                <!-- search form -->
                <!-- /.search form -->
                <!-- sidebar menu: : style can be found in sidebar.less -->

                <div id="vin_Menu">

                    <ul class="sidebar-menu">



                        <li class="treeview " id="dashboard">
                            <a href="#">
                                <i class="fa fa-laptop"></i>
                                <span>Dashboard </span>
                                <i class="fa fa-angle-left pull-right"></i>
                            </a>
                            <ul class="treeview-menu  ">
                                <li class="" id="Landing_Dashboard"><a href="@Url.Action("Dashboard", "Home")"><i class="fa fa-circle-o"></i> Landing Dashboard</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>


            </section>
            <!-- /.sidebar -->
        </aside>

        @RenderBody()





        <div class="modal fade" id="myModalx">
            <div class="modal-dialog">
                <div>
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h3 class="panel-title">
                                Logo Master <span class="pull-right ">
                                    <a href="#" data-dismiss="modal" aria-label="Close">
                                        <i class="ace-icon fa fa-times"></i>
