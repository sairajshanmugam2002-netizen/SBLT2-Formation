@{
    ViewBag.Title = "Supplier_Master";
}

<script type="text/javascript">
    $(document).ready(function () {
        var ID = 0;
        var User = sessionStorage.getItem("user");


        //var url = "../../Master/pr_FetchMaterialCode"//?ID=" + User;
        //var Source =
        //{
        //    datatype: "json",
        //    datafields: [
        //        { name: 'mm_ID', type: 'string' },
        //        { name: 'mm_MaterialCode', type: 'string' }
        //    ],
        //    id: 'id',
        //    url: url
        //};
        //var adapter = new $.jqx.dataAdapter(Source);
        //$("#cm_vCustomerID").jqxComboBox({ selectedIndex: -1, source: adapter, displayMember: "mm_MaterialCode", valueMember: "mm_ID", width: '100%', height: '30' });


        var url = "Pr_Fetch_Supplier_Master_Details_Web";
        var source = {
            datatype: "json",
            datafields: [{
                name: 'cm_iTransId',
                type: 'string'
            },
            {
                name: 'cm_vCustomerID',
                type: 'string'
            },
            {
                name: 'cm_GSTNo',
                type: 'string'
            },
            {
                name: 'cm_vCustomerName',
                type: 'string'
                }, {
                    name: 'cm_vAddress',
                    type: 'string'
                },
            {
                name: 'cm_EMail',
                type: 'string'
                },
                {
                    name: 'cm_vMobileNo1',
                    type: 'string'
                },
            ],
            id: 'id',
            url: url
        };
        var cellsrenderer = function (row, columnfield, value, defaulthtml, columnproperties, rowdata) {
            debugger
            if (value == 'No') {
                return '<span style="margin: 4px; float: ' + columnproperties.cellsalign + '; color: #ff0000;">' + value + '</span>';
            }
            if (value == 'yes' || value == 'Yes') {
                return '<span style="margin: 4px; float: ' + columnproperties.cellsalign + '; color: #15c40c;">' + value + '</span>';
            }
            if (value == 'Trial') {
                return '<span style="margin: 4px; float: ' + columnproperties.cellsalign + '; color: #fcb80a;">' + value + '</span>';
            }
        }
        var dataAdapter = new $.jqx.dataAdapter(source);
        $("#Grid").jqxGrid({
            theme: 'ui-sunny',
            width: '100%',
            height: '480px',
            source: dataAdapter,
            columnsresize: true,
            pageable: true,
            enabletooltips: false,
            pagermode: 'simple',
            enabletooltips: true,
            selectionmode: 'checkbox',
            showfilterrow: true,
            filterable: true,
            pagesize: 14,
            columns: [{
                text: 'Edit',
                datafield: 'Edit',
                filterable: false,
                width: 50,
                cellsrenderer: function () {
                    return '<div style="width: 100%"><img src="../../../img/Edit1.png" style="margin-left: 25%" /></div>';
                }
            },
                {
                text: 'ID',
                datafield: 'cm_iTransId',
                width: 80,
                hidden: true
            },
            {
                text: 'Customer Code',
                datafield: 'cm_vCustomerID',
                width: 150,
                minwidth: 130
                }, {
                    text: 'Customer Name',
                    datafield: 'cm_vCustomerName',
                    width: 200,
                    minwidth: 160
                }, {
                    text: 'Address',
                    datafield: 'cm_vAddress',
                    width: 220,
                    minwidth: 180
                },
            {
                text: 'GST No',
                datafield: 'cm_GSTNo',
                width: 140,
                minwidth: 120
            },          
            {
                text: 'EMail',
                datafield: 'cm_EMail',
                cellsrenderer: cellsrenderer,
                width: 160,
                minwidth: 140
                },
                {
                    text: 'Contact No',
                    datafield: 'cm_vMobileNo1',
                    width: 140,
                    minwidth: 120
                },
            ]
        });
        $("#Grid").on("cellclick", function (event) {
            var column = event.args.column;
            var rowindex = event.args.rowindex;
            var columnindex = event.args.columnindex;
            if (columnindex == 1) {
                editrow = rowindex;
                var dataRecord = $("#Grid").jqxGrid('getrowdata', editrow);
                ID = dataRecord.cm_iTransId;
                var url = "Pr_Fetch_Supplier_Master_ByID?ID=" + ID;
                var source = {
                    datatype: "json",
                    datafields: [{
                        name: 'cm_iTransId',
                        type: 'string'
                    },
                        {
                            name: 'cm_vCustomerID',
                            type: 'string'
                        },
                        {
                            name: 'cm_vCustomerName',
                            type: 'string'
                        }, {
                            name: 'cm_vAddress',
                            type: 'string'
                        },
                        {
                            name: 'cm_GSTNo',
                            type: 'string'
                        },
                        {
                            name: 'cm_EMail',
                            type: 'string'
                        },
                        {
                            name: 'cm_vMobileNo1',
                            type: 'string'
                        },
                    ],
                    id: 'id',
                    url: url
                };
                var dataAdapter_per = new $.jqx.dataAdapter(source, {
                    contentType: 'application/json; charset=utf-8',
                    loadComplete: function () {
                        var length = dataAdapter_per.records.length;
                        var records = dataAdapter_per.records;
                        var record = records[0];
                        $('#cm_iTransId').val(record.cm_iTransId);
                        $('#cm_vCustomerID').val(record.cm_vCustomerID);
                        $('#blah1').attr('src', "../../" + record.TM_vDocumentLocation);
                        $('#cm_vCustomerName').val(record.cm_vCustomerName);
                        $('#cm_vAddress').val(record.cm_vAddress);
                        $('#cm_GSTNo').val(record.cm_GSTNo);
                        $('#cm_EMail').val(record.cm_EMail); $('#cm_vMobileNo1').val(record.cm_vMobileNo1);
                        $("#btn_save_label").text('Update');
                        $('#myModal').modal('show');
                    },
                    error: function (xhr, status, error) {
                        alert(JSON.stringify(xhr));
                    }
                })
                dataAdapter_per.dataBind();
            }
        });

        $('#Delete').click(function () {
            debugger
                var selectedrows = $('#Grid').jqxGrid('getselectedrowindexes');
                if (selectedrows.length <= 0) {
                    alert('Please select row want to Delete');
                    return;
                }
                else {
                    var a = confirm("Are you sure want to delete press OK");
                    if (a == true) {
                    for (var i = 0; i < selectedrows.length; i++) {
                        cm_iTransId = $('#Grid').jqxGrid('getcellvalue', selectedrows[i], "cm_iTransId");
                        $.ajax({
                            type: 'POST',
                            contentType: "application/json; charset=utf-8",
                            url: 'Pr_Delete_Supplier_Master',
                            data: "{'ID':'" + cm_iTransId + "'}",
                            async: false,
                            success: function (response) {
                                //$("#Grid").jqxGrid('updatebounddata');
                                //alert('Record Deleted Successfully');
                            },
                            error: function () {
                                console.log('there is some error');
                            }
                        });
                    }
                }
                    else {
                        $('#Grid').jqxGrid('clearselection');
                        return;
                    }
            }
            alert("Record Saved Successfully...!");
            $('#Grid').jqxGrid('clearselection');
            $("#Grid").jqxGrid('updatebounddata');
        });

        $('#form1').jqxValidator({
            hintType: 'label',
            animationDuration: 2,
            rules: [
                //{
                //input: '#cm_vCustomerID',
                //message: 'Customer Name Required..!',
                //action: 'keyup, blur',
                //rule: 'required',
                //focus: true
                //},
                {
                    input: '#cm_vCustomerName',
                    message: 'Customer cm_GSTNo Required..!',
                action: 'keyup, blur',
                rule: 'required',
                focus: true
            }, ]
        });
        var flag = false;
        var flag = false;
        $('#form1').on('validationSuccess', function (event) {
            flag = true;
        });


        $("#btn_Save").click(function () {
            $('#form1').jqxValidator('validate');
            if (flag == true) {
                if ($("#btn_save_label").text() == 'Save') {
                    save();
                } else {
                    Update();
                }
                flag = false;
            }
        });

        function readURL(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#blah1').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        $("#imgInp").change(function () {
            readURL(this);
        });

        function save() {
            var data = new FormData();
            //var files = $("#imgInp").get(0).files;
            //if (files.length > 0) {
            //    data.append("MyImages", files[0]);
            //    // alert("hii");
            //}
            var selectedIndexSection12 = $('#cm_vCustomerID').jqxDropDownList('selectedIndex');
            if (selectedIndexSection12 < 0) {
                flag = false;
                $("#cm_vCustomerID").jqxDropDownList('focus');
                $.toaster({ priority: 'danger', title: 'Notice', message: "Please Select Material Code" });
                return;
            }
            $.ajax({
                url: "Pr_Insert_Customer_Master?cm_vCustomerID=" + $('#cm_vCustomerID').val() + "&cm_vCustomerName=" + $('#cm_vCustomerName').val() +
                    "&cm_GSTNo=" + $('#cm_GSTNo').val() + "&cm_EMail=" + $('#cm_EMail').val() + "&cm_vAddress=" + $('#cm_vAddress').val() +
                    "&cm_vMobileNo1=" + $('#cm_vMobileNo1').val() + "&cm_vUser=" + User,
                type: "POST",
                processData: false,
                contentType: false,
                data: data,
                async: false,
                success: function (response) {
                    if (response == 'True') {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Saved Successfully" });
                        $("#Grid").jqxGrid('updatebounddata');
                        $('#blah1').attr('src', "../../");
                        Clear();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function (er) {
                    alert(er.responseText);
                }
            });
        }

        function Update() {
            var data = new FormData();
            //var files = $("#imgInp").get(0).files;
            //if (files.length > 0) {
            //    data.append("MyImages", files[0]);
            //}
            $.ajax({
                url: "Pr_Update_Customer_Master?cm_iTransId=" + ID + "&cm_vCustomerID=" + $('#cm_vCustomerID').val() + "&cm_vCustomerName=" + $('#cm_vCustomerName').val() +
                    "&cm_GSTNo=" + $('#cm_GSTNo').val() + "&cm_EMail=" + $('#cm_EMail').val() + "&cm_vAddress=" + $('#cm_vAddress').val() + "&cm_vMobileNo1=" + $('#cm_vMobileNo1').val(),
               type: "POST",
                processData: false,
                contentType: false,
                data: data,
                async: false,
                success: function (response) {
                    if (response == 'True') {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Updated Successfully" });
                        $("#Grid").jqxGrid('updatebounddata');
                        Clear();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function (er) {
                    alert(er.responseText);
                }
            });
        }

        function Clear() {
            $('#cm_vCustomerID').val('');
            $('#cm_vCustomerName').val('');
            $('#cm_vAddress').val('');
            $('#cm_GSTNo').val('');
            $('#cm_EMail').val('');
            $("#btn_save_label").text('Save');
            $('#blah1').attr('src', "../../");
            flag = false;
        }

        $("#Master").addClass("active");
        $("#Supplier_Master").addClass("active");

        $("#btn_AddNew").click(function () {
            $("#btn_save_label").text('Save');
            Clear();
        })
        $("#sidebar-collapse").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        });
        $("#btn_Clear").click(function () {
            Clear();
        })
        $("#btn_Refresh").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        })
        $("#btn_Excel").click(function () {
            window.open("../../Master/Export_To_Excel?FileName=Supplier_Master&Heading=Supplier Master&Data=Pr_Fetch_Supplier_Master_Details_Web_Excel");
        })
        $("#btn_Pdf").click(function () { })
        $("#btn_Chart").click(function () { })
        $("#btn_Help").click(function () { })
    });
</script>

<div class="content-wrapper">
    <section class="content">
        <div class="row">
            <div class="col-xs-12" style="padding:5px;  padding-top:0px">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">Customer Master</h3>
                        <div class="box-tools pull-right">
                            <button type="button" id="btn_AddNew" title="Add New" data-rel="tooltip" class="btn btn-box-tool" data-toggle="modal" data-target="#myModal" style="padding:5px"><span class='fa fa fa-plus-square  bigger-130 green'></span></button>
                            <button type="button" id="btn_Refresh" title="Refresh" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-refresh bigger-130 vilote'></span></button>
                            <button type="button" id="btn_Excel" title="Export to Excel" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-file-excel-o bigger-130 green'></span></button>
                            @*<button type="button" id="btn_Pdf" title="Export to Pdf" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-file-pdf-o bigger-130 red'> </span></button>*@
                        </div>
                        <!-- /.nav-search -->
                    </div>
                    <div class="box-body">
                        <div class="col-sm-4" style="max-width: 70px; padding-left: 0px; padding-right: 0px">
                            <button type="button" id="Delete" style="width: 100px;background-color: red">Delete</button>
                        </div>
                        <p></p>
                        <div class="col-md-12" style="padding-left:0px; padding-right:0px">
                            <div class="table-wrapper">
                                <div id="Grid"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal fade  bd-example-modal-lg" id="myModal">
                    <div class="modal-dialog modal-lg">
                        <div>
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title">
                                        Customer Master <span class="pull-right ">
                                            <a href="#" data-dismiss="modal" aria-label="Close">
                                                <i class="ace-icon fa fa-times"></i>
                                            </a>
                                        </span>
                                    </h3>
                                </div>
                                <div class="panel-body">
                                    <form class="form-horizontal" role="form" id="form1">
                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star">*</span>Customer Code</label>
                                                <div class="col-sm-7">
                                                    <input id="cm_vCustomerID" type="text" placeholder="Customer Code" class="form-control" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star">*</span>Customer Name</label>
                                                <div class="col-sm-7">
                                                    <input id="cm_vCustomerName" type="text" placeholder="Customer Name" class="form-control" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star"></span>Address</label>
                                                <div class="col-sm-7">
                                                    <input id="cm_vAddress" type="text" placeholder="Address" class="form-control" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label no-padding-right" for="form-field-1"> <span class="star"></span>GST No</label>
                                                <div class="col-sm-7">
                                                    <input id="cm_GSTNo" type="text" placeholder="GST No" class="form-control" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star"></span>EMail</label>
                                                <div class="col-sm-7">
                                                    <input id="cm_EMail" type="text" placeholder="EMail" class="form-control" />
                                                </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star"></span>Contact No</label>
                                                    <div class="col-sm-7">
                                                        <input id="cm_vMobileNo1" type="text" placeholder="Contact No" class="form-control" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </form>
                                    <div class="col-sm-5"></div>
                                    <p>
                                        <button id="btn_Save" class="btn btn-white btn-info btn-bold">
                                            <i class="ace-icon fa fa-floppy-o bigger-120 blue"></i>
                                            <span id="btn_save_label">Save</span>
                                        </button>
                                        <button id="btn_Clear" class="btn btn-white btn-warning btn-bold">
                                            <i class="ace-icon fa fa-trash-o bigger-120 orange"></i>
                                            Clear
                                        </button>
                                        <button class="btn btn-white btn-default btn-round" data-dismiss="modal">
                                            <i class="ace-icon fa fa-times red2"></i>
                                            Close
                                        </button>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>



