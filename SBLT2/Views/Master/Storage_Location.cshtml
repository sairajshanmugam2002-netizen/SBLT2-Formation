@{
    ViewBag.Title = "Storage_Location";
}

<script type="text/javascript">
    $(document).ready(function () {
        var ID = 0;
        var User = sessionStorage.getItem("user");

        var url = "Pr_Fetch_StorageLocation_Master_Details_Web";
        var source = {
            datatype: "json",
            datafields: [{
                name: 'sl_ID',
                type: 'string'
            },
            {
                name: 'sl_Group',
                type: 'string'
            },
            {
                name: 'sl_StorageArea',
                type: 'string'
            },
            {
                name: 'sl_BinNo',
                type: 'string'
            },
            ],
            id: 'id',
            url: url
        };
        var dataAdapter = new $.jqx.dataAdapter(source);
        $("#Grid").jqxGrid({
            theme: 'ui-sunny',
            width: '100%',
            height: '480px',
            source: dataAdapter,
            columnsresize: true,
            pageable: true,
            enabletooltips: false,
            pagermode: 'simple',
            enabletooltips: true,
            selectionmode: 'checkbox',
            showfilterrow: true,
            filterable: true,
            pagesize: 14,
            columns: [{
                text: 'Edit',
                datafield: 'Edit',
                filterable: false,
                width: 40,
                cellsrenderer: function () {
                    return '<div style="width: 100%"><img src="../../../img/Edit1.png" style="margin-left: 25%" /></div>';
                }
            },
                //{
                //    text: 'Del',
                //    datafield: 'delete',
                //    filterable: false,
                //    width: 40,
                //    cellsrenderer: function () {
                //        return '<div style="width: 100%"><img src="../../../img/del.png" style="margin-left: 25%" /></div>';
                //    }
                //},
                {
                text: 'ID',
                datafield: 'sl_ID',
                width: '10%',
                hidden: true
            },
            {
                text: 'Group',
                datafield: 'sl_Group',
                width: '25%'
            },
            {
                text: 'Bin No',
                datafield: 'sl_BinNo',
                width: '15%'
            },
            {
                text: 'Storage Area',
                datafield: 'sl_StorageArea',
                width: '10%'
            },
            ]
        });
        $("#Grid").on("cellclick", function (event) {
            var column = event.args.column;
            var rowindex = event.args.rowindex;
            var columnindex = event.args.columnindex;
            if (columnindex == 1) {
                editrow = rowindex;
                var dataRecord = $("#Grid").jqxGrid('getrowdata', editrow);
                ID = dataRecord.sl_ID;
                var url = "Pr_Fetch_StorageLocation_Master_ByID?ID=" + ID;
                var source = {
                    datatype: "json",
                    datafields: [{
                        name: 'sl_ID',
                        type: 'string'
                    },
                        {
                            name: 'sl_Group',
                            type: 'string'
                        },
                        {
                            name: 'sl_BinNo',
                            type: 'string'
                        },
                        {
                            name: 'sl_StorageArea',
                            type: 'string'
                        },
                    ],
                    id: 'id',
                    url: url
                };
                var dataAdapter_per = new $.jqx.dataAdapter(source, {
                    contentType: 'application/json; charset=utf-8',
                    loadComplete: function () {
                        var length = dataAdapter_per.records.length;
                        var records = dataAdapter_per.records;
                        var record = records[0];
                        $('#sl_ID').val(record.sl_ID);
                        $('#sl_Group').val(record.sl_Group);
                        $('#blah1').attr('src', "../../" + record.TM_vDocumentLocation);
                        $('#sl_BinNo').val(record.sl_BinNo);
                        $('#sl_StorageArea').val(record.sl_StorageArea);
                        $("#btn_save_label").text('Update');
                        $('#myModal').modal('show');
                    },
                    error: function (xhr, status, error) {
                        alert(JSON.stringify(xhr));
                    }
                })
                dataAdapter_per.dataBind();
            }
        });

        $('#Delete').click(function () {
            debugger
            var selectedrows = $('#Grid').jqxGrid('getselectedrowindexes');
            if (selectedrows.length <= 0) {
                alert('Please select row yoy want to Delete');
                return;
            }
            else {
                var a = confirm("Are you sure want to delete press OK");
                if (a == true) {
                    for (var i = 0; i < selectedrows.length; i++) {
                        sl_ID = $('#Grid').jqxGrid('getcellvalue', selectedrows[i], "sl_ID");
                        $.ajax({
                            type: 'POST',
                            contentType: "application/json; charset=utf-8",
                            url: 'Pr_Delete_StorageLocation_Master',
                            data: "{'ID':'" + sl_ID + "'}",
                            async: false,
                            success: function (response) {
                                //$("#Grid").jqxGrid('updatebounddata');
                                //alert('Record Deleted Successfully');
                            },
                            error: function () {
                                console.log('there is some error');
                            }
                        });
                    }
                }
                else {
                    $('#Grid').jqxGrid('clearselection');
                    return;
                }
            }
            alert("Record Saved Successfully...!");
            $('#Grid').jqxGrid('clearselection');
            $("#Grid").jqxGrid('updatebounddata');
        });

        $('#form1').jqxValidator({
            hintType: 'label',
            animationDuration: 2,
            rules: [ {
                input: '#sl_Group',
                message: 'Material Code Required..!',
                action: 'keyup, blur',
                rule: 'required',
                focus: true
            }, {
                    input: '#sl_BinNo',
                    message: 'Place Required..!',
                action: 'keyup, blur',
                rule: 'required',
                focus: true
            }, ]
        });
        var flag = false;
        var flag = false;
        $('#form1').on('validationSuccess', function (event) {
            flag = true;
        });


        $("#btn_Save").click(function () {
            $('#form1').jqxValidator('validate');
            if (flag == true) {
                if ($("#btn_save_label").text() == 'Save') {
                    save();
                } else {
                    Update();
                }
                flag = false;
            }
        });

        function readURL(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#blah1').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        $("#imgInp").change(function () {
            readURL(this);
        });

        function save() {
            var data = new FormData();
            //var files = $("#imgInp").get(0).files;
            //if (files.length > 0) {
            //    data.append("MyImages", files[0]);
            //    // alert("hii");
            //}
            $.ajax({
                url: "Pr_Insert_StorageLocation_Master?sl_Group=" + $('#sl_Group').val() + "&sl_BinNo=" + $('#sl_BinNo').val() +
                    "&sl_StorageArea=" + $('#sl_StorageArea').val() + "&sl_User=" + User,
                type: "POST",
                processData: false,
                contentType: false,
                data: data,
                async: false,
                success: function (response) {
                    if (response == 'True') {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Saved Successfully" });
                        $("#Grid").jqxGrid('updatebounddata');
                        $('#blah1').attr('src', "../../");
                        Clear();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function (er) {
                    alert(er.responseText);
                }
            });
        }

        function Update() {
            var data = new FormData();
            //var files = $("#imgInp").get(0).files;
            //if (files.length > 0) {
            //    data.append("MyImages", files[0]);
            //}
            $.ajax({
                url: "Pr_Update_StorageLocation_Master?sl_ID=" + ID + "&sl_Group=" + $('#sl_Group').val() + "&sl_BinNo=" + $('#sl_BinNo').val() +
                    "&sl_StorageArea=" + $('#sl_StorageArea').val(),
               type: "POST",
                processData: false,
                contentType: false,
                data: data,
                async: false,
                success: function (response) {
                    if (response == 'True') {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Updated Successfully" });
                        $("#Grid").jqxGrid('updatebounddata');
                        Clear();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function (er) {
                    alert(er.responseText);
                }
            });
        }

        function Clear() {
            $('#sl_Group').val('');
            $('#sl_BinNo').val('');
            $('#sl_StorageArea').val('');
            $('#sm_ApprovedSupplier').val('');
            $("#btn_save_label").text('Save');
            $('#blah1').attr('src', "../../");
            flag = false;
        }

        $("#Master").addClass("active");
        $("#Storage_Location").addClass("active");

        $("#btn_AddNew").click(function () {
            $("#btn_save_label").text('Save');
            Clear();
        })
        $("#sidebar-collapse").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        });
        $("#btn_Clear").click(function () {
            Clear();
        })
        $("#btn_Refresh").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        })
        $("#btn_Excel").click(function () {
            window.open("../../Master/Export_To_Excel?FileName=Storage_Location&Heading=Storage Location&Data=Pr_Fetch_StorageLocation_Master_Details_Web_Excel");
        })
        $("#btn_Pdf").click(function () { })
        $("#btn_Chart").click(function () { })
        $("#btn_Help").click(function () { })
    });
</script>

<div class="content-wrapper">
    <section class="content">
        <div class="row">
            <div class="col-xs-12" style="padding:5px;  padding-top:0px">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">Storage Location</h3>
                        <div class="box-tools pull-right">
                            <button type="button" id="btn_AddNew" title="Add New" data-rel="tooltip" class="btn btn-box-tool" data-toggle="modal" data-target="#myModal" style="padding:5px"><span class='fa fa fa-plus-square  bigger-130 green'></span></button>
                            <button type="button" id="btn_Refresh" title="Refresh" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-refresh bigger-130 vilote'></span></button>
                            <button type="button" id="btn_Excel" title="Export to Excel" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-file-excel-o bigger-130 green'></span></button>
                            @*<button type="button" id="btn_Pdf" title="Export to Pdf" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-file-pdf-o bigger-130 red'> </span></button>*@
                        </div>
                        <!-- /.nav-search -->
                    </div>
                    <div class="box-body">
                        <div class="col-sm-4" style="max-width: 70px; padding-left: 0px; padding-right: 0px">
                            <button type="button" id="Delete" style="width: 100px;background-color: red;">Delete</button>
                        </div>
                        <div class="col-md-12" style="padding-left:0px; padding-right:0px">
                            <div id="Grid"></div>
                        </div>
                    </div>
                </div>
                <div class="modal fade  bd-example-modal-lg" id="myModal">
                    <div class="modal-dialog modal-lg">
                        <div>
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title">
                                        Storage Location <span class="pull-right ">
                                            <a href="#" data-dismiss="modal" aria-label="Close">
                                                <i class="ace-icon fa fa-times"></i>
                                            </a>
                                        </span>
                                    </h3>
                                </div>
                                <div class="panel-body">
                                    <form class="form-horizontal" role="form" id="form1">
                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star">*</span>Group</label>
                                                <div class="col-sm-7">
                                                    <input id="sl_Group" type="text" placeholder="Group" class="form-control" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star">*</span>Bin No</label>
                                                <div class="col-sm-7">
                                                    <input id="sl_BinNo" type="text" placeholder="Bin No" class="form-control" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label no-padding-right" for="form-field-1"> <span class="star"></span>Storage Area</label>
                                                <div class="col-sm-7">
                                                    <input id="sl_StorageArea" type="text" placeholder="Storage Area" class="form-control" />
                                                </div>
                                            </div>                                    
                                        </div>

                                    </form>
                                    <div class="col-sm-5"></div>
                                    <p>
                                        <button id="btn_Save" class="btn btn-white btn-info btn-bold">
                                            <i class="ace-icon fa fa-floppy-o bigger-120 blue"></i>
                                            <span id="btn_save_label">Save</span>
                                        </button>
                                        <button id="btn_Clear" class="btn btn-white btn-warning btn-bold">
                                            <i class="ace-icon fa fa-trash-o bigger-120 orange"></i>
                                            Clear
                                        </button>
                                        <button class="btn btn-white btn-default btn-round" data-dismiss="modal">
                                            <i class="ace-icon fa fa-times red2"></i>
                                            Close
                                        </button>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>




