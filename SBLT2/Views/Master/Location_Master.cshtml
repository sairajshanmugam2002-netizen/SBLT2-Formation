@{
    ViewBag.Title = "Location_Master";
}

<script type="text/javascript">
    $(document).ready(function () {
        var ID = 0;
        var User = sessionStorage.getItem("user");
        FetchTeamCode();
        function FetchTeamCode() {
            var url = "Pr_GetLocationCode";
            var source = {
                datatype: "json",
                datafields: [{
                    name: 'INC',
                    type: 'string'
                }],
                id: 'id',
                url: url,
                async: false
            };
            var dataAdapter_per = new $.jqx.dataAdapter(source, {
                contentType: 'application/json; charset=utf-8',
                loadComplete: function () {
                    var length = dataAdapter_per.records.length;
                    var records = dataAdapter_per.records;
                    var record = records[0];
                    $('#lm_LocationCode').val(record.INC);
                    //$('#SM_vSupplier_Code').prop('disabled', true);
                },
                error: function (xhr, status, error) {
                    alert(JSON.stringify(xhr));
                }
            })
            dataAdapter_per.dataBind();
        }

        var url = "Pr_Fetch_Location_Master_Details";
        var source = {
            datatype: "json",
            datafields: [{
                name: 'lm_Id',
                type: 'string'
            },
            {
                name: 'lm_LocationCode',
                type: 'string'
                },
                {
                    name: 'lm_LocationName',
                    type: 'string'
                },
            {
                name: 'lm_User',
                type: 'string'
            },
            {
                name: 'lm_CreatedDate',
                type: 'string'
            },
            ],
            id: 'id',
            url: url
        };
        var dataAdapter = new $.jqx.dataAdapter(source);
        $("#Grid").jqxGrid({
            theme: 'ui-sunny',
            width: '100%',
            height: '480px',
            source: dataAdapter,
            columnsresize: true,
            pageable: true,
            enabletooltips: false,
            pagermode: 'simple',
            enabletooltips: true,
            showfilterrow: true, selectionmode: 'checkbox',
            filterable: true,
            pagesize: 14,
            columns: [{
                text: 'Edit',
                datafield: 'Edit',
                filterable: false,
                width: 40,
                cellsrenderer: function () {
                    return '<div style="width: 100%"><img src="../../../img/Edit1.png" style="margin-left: 25%" /></div>';
                }
            },
               {
                text: 'id',
                datafield: 'lm_Id',
                width: '100px',
                hidden: true
            },
                {
                    text: 'Location',
                    datafield: 'lm_LocationCode',
                    width: '20%'
                },
                {
                    text: 'Location Name',
                    datafield: 'lm_LocationName',
                    width: '20%'
                },
           
            ]
        });
        $("#Grid").on("cellclick", function (event) {
            var column = event.args.column;
            var rowindex = event.args.rowindex;
            var columnindex = event.args.columnindex;
            if (columnindex == 1) {
                editrow = rowindex;
                var dataRecord = $("#Grid").jqxGrid('getrowdata', editrow);
                ID = dataRecord.lm_Id;
                var url = "Pr_Fetch_Location_Master_Details_ById?ID=" + ID;
                var source = {
                    datatype: "json",
                    datafields: [{
                        name: 'lm_Id',
                        type: 'string'
                    },
                    {
                        name: 'lm_LocationCode',
                        type: 'string'
                    },
                    {
                        name: 'lm_LocationName',
                        type: 'string'
                        },
                        {
                            name: 'lm_User',
                            type: 'string'
                        },
                    ],
                    id: 'id',
                    url: url
                };
                var dataAdapter_per = new $.jqx.dataAdapter(source, {
                    contentType: 'application/json; charset=utf-8',
                    loadComplete: function () {
                        var length = dataAdapter_per.records.length;
                        var records = dataAdapter_per.records;
                        var record = records[0];
                        $('#lm_Id').val(record.lm_Id);
                        $('#blah1').attr('src', "../../" + record.TM_vDocumentLocation);
                        $('#lm_LocationCode').val(record.lm_LocationCode);
                        $('#lm_LocationName').val(record.lm_LocationName);
                        $("#btn_save_label").text('Update');
                        $('#myModal').modal('show');
                    },
                    error: function (xhr, status, error) {
                        alert(JSON.stringify(xhr));
                    }
                })
                dataAdapter_per.dataBind();
            }
            //if (columnindex == 1) {
            //    editrow = rowindex;
            //    var dataRecord = $("#Grid").jqxGrid('getrowdata', editrow);
            //    var id = dataRecord.lm_Id;
            //    var a = confirm("Are you sure want to delete press OK");
            //    if (a == true) {
            //        $.ajax({
            //            type: 'POST',
            //            contentType: "application/json; charset=utf-8",
            //            url: 'Pr_Delete_Location_Master',
            //            data: "{'ID':'" + dataRecord.lm_Id + "'}",
            //            async: false,
            //            success: function (response) {
            //                $("#Grid").jqxGrid('updatebounddata');
            //                alert('Recode Deleted Success');
            //            },
            //            error: function () {
            //                console.log('there is some error');
            //            }
            //        });
            //    }
            //}
        });

        $('#Delete').click(function () {
            debugger
            var selectedrows = $('#Grid').jqxGrid('getselectedrowindexes');
            if (selectedrows.length <= 0) {
                alert('Please select row want to Delete');
                return;
            }
            else {
                var a = confirm("Are you sure want to delete press OK");
                if (a == true) {
                    for (var i = 0; i < selectedrows.length; i++) {
                        lm_Id = $('#Grid').jqxGrid('getcellvalue', selectedrows[i], "lm_Id");
                        $.ajax({
                            type: 'POST',
                            contentType: "application/json; charset=utf-8",
                            url: 'Pr_Delete_Location_Master',
                            data: "{'ID':'" + lm_Id + "'}",
                            async: false,
                            success: function (response) {
                                //$("#Grid").jqxGrid('updatebounddata');
                                //alert('Record Deleted Successfully');
                            },
                            error: function () {
                                console.log('there is some error');
                            }
                        });
                    }
                }
                else {
                    $('#Grid').jqxGrid('clearselection');
                    return;
                }
            }
            alert("Record Saved Successfully...!");
            $('#Grid').jqxGrid('clearselection');
            $("#Grid").jqxGrid('updatebounddata');
        });


        $('#form1').jqxValidator({
            hintType: 'label',
            animationDuration: 2,
            rules: [ {
                input: '#lm_LocationCode',
                message: 'Location Code Required..!',
                action: 'keyup, blur',
                rule: 'required',
                focus: true
            }, {
                    input: '#lm_LocationName',
                    message: 'LOcation Name Required..!',
                action: 'keyup, blur',
                rule: 'required',
                focus: true
            }, ]
        });
        var flag = false;
        var flag = false;
        $('#form1').on('validationSuccess', function (event) {
            flag = true;
        });


        $("#btn_Save").click(function () {
            $('#form1').jqxValidator('validate');
            if (flag == true) {
                if ($("#btn_save_label").text() == 'Save') {
                    save();
                } else {
                    Update();
                }
                flag = false;
            }
        });

        function readURL(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#blah1').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        $("#imgInp").change(function () {
            readURL(this);
        });

        function save() {
            var data = new FormData();
            $.ajax({
                url: "Pr_Insert_Location_Master?lm_LocationCode=" + $('#lm_LocationCode').val() + "&lm_LocationName=" + $('#lm_LocationName').val() + "&lm_User=" + User,
                type: "POST",
                processData: false,
                contentType: false,
                data: data,
                async: false,
                success: function (response) {
                    if (response == 'True') {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Saved Successfully" });
                        $("#Grid").jqxGrid('updatebounddata');
                        $('#blah1').attr('src', "../../");
                        Clear();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function (er) {
                    alert(er.responseText);
                }
            });
        }

        function Update() {
            var data = new FormData();
            $.ajax({
                url: "Pr_Update_Location_Master?lm_Id=" + ID + "&lm_LocationCode=" + $('#lm_LocationCode').val() + "&lm_LocationName=" + $('#lm_LocationName').val(),
                type: "POST",
                processData: false,
                contentType: false,
                data: data,
                async: false,
                success: function (response) {
                    if (response == 'True') {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Saved Successfully" });
                        $("#Grid").jqxGrid('updatebounddata');
                        Clear();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function (er) {
                    alert(er.responseText);
                }
            });
        }

        function Clear() {
            //$('#lm_BranchCode').val('');
            $('#lm_CustomerCode').val('');
            $('#lm_LocationName').val('');
            $('#lm_LocationCode').val('');
            $('#lm_Address').val('');
            $("#btn_save_label").text('Save');
            FetchTeamCode();
            $('#blah1').attr('src', "../../");
            flag = false;
        }

        $("#Master").addClass("active");
        $("#Location_Master").addClass("active");

        $("#btn_AddNew").click(function () {
            $("#btn_save_label").text('Save');
            Clear();
        })
        $("#sidebar-collapse").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        });
        $("#btn_Clear").click(function () {
            Clear();
        })
        $("#btn_Refresh").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        })
        $("#btn_Excel").click(function () {
            window.open("../../Master/Export_To_Excel?FileName=Team_Master&Heading=Team Master&Data=Pr_Fetch_Team_Master_Details_Excel");
        })
        $("#btn_Pdf").click(function () { })
        $("#btn_Chart").click(function () { })
        $("#btn_Help").click(function () { })
    });
</script>

