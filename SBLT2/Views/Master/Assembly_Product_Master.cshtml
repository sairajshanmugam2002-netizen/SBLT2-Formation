        var isClearing = false;

        function loadProductForEdit(rowindex) {
            var dataRecord = $("#Grid").jqxGrid('getrowdata', rowindex);
            if (!dataRecord || !dataRecord.PM_iID) return;
            ID = dataRecord.PM_iID;
            $.ajax({
                type: "GET",
                url: "Pr_Fetch_Product_MasterAssy_ByID?ID=" + ID,
                dataType: "json",
                success: function (data) {
                    if (typeof data === "string") {
                        try { data = JSON.parse(data); } catch (e) { }
                    }
                    var records = data && data.record ? data.record : (Array.isArray(data) ? data : []);
                    if (records && records.length > 0) {
                        var record = records[0];
                        $('#PM_Item_Code').val(record.PM_Item_Code || '');
                        $('#PM_Mold').val(record.PM_Mold || '');
                        $('#PM_Sector').val(record.PM_Sector || '');
                        $('#PM_Description').val(record.PM_Description || '');
                        $('#PM_Variant_Code').val(record.PM_Variant_Code || '');
                        $('#compare_code').val(record.compare_code || '');
                        $('#PM_Skid_Qty').val(record.PM_Skid_Qty || '');
                        $('#PM_MOQ_Qty').val(record.PM_MOQ_Qty || '');
                        $('#inv_Qty').val(record.inv_Qty || '');
                        $('#VStart').val(record.VStart || '');
                        $('#VEnd').val(record.VEnd || '');
                        $('#SerialStart').val(record.SerialStart || '');
                        $('#SerialEnd').val(record.SerialEnd || '');
                        $('#chargeing_Dub_Hrs').val(record.chargeing_Dub_Hrs || '');
                        $("#btn_save_label").text('Update');
                        $('html, body').animate({
                            scrollTop: $(".box-primary").offset().top - 15
                        }, 250);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error loading product record:", error);
                }
            });
        }

        $("#Grid").on("rowselect", function (event) {
