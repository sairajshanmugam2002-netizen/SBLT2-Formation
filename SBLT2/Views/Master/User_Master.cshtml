@{
    ViewBag.Title = "User_Master";
}

<script type="text/javascript">
    $(document).ready(function() {
        var ID = 0;
        var User = sessionStorage.getItem("user");
        var Area = sessionStorage.getItem("Area");

        var url = "../../Master/pr_get_Reference_Values?Type=User_Type";
        var Source =
        {
            datatype: "json",
            datafields: [
            { name: 'RGV_iID', type: 'string' },
            { name: 'RGV_vDesciption', type: 'string' }
            ],
            id: 'id',
            url: url
        };
        var adapter = new $.jqx.dataAdapter(Source);
        $("#UM_iUser_Type").jqxDropDownList({ selectedIndex: 1, source: adapter, displayMember: "RGV_vDesciption", valueMember: "RGV_iID", width: '100%', height: '30', autoDropDownHeight: true });

        var url = "../../Master/pr_get_Reference_Values?Type=Area";
        var Source =
        {
            datatype: "json",
            datafields: [
            { name: 'RGV_iID', type: 'string' },
            { name: 'RGV_vDesciption', type: 'string' }
            ],
            id: 'id',
            url: url
        };
        var adapter = new $.jqx.dataAdapter(Source);
        $("#UM_iArea").jqxDropDownList({ selectedIndex: 1, source: adapter, displayMember: "RGV_vDesciption", valueMember: "RGV_iID", width: '100%', height: '30', autoDropDownHeight: true });


        
        $("#UM_dApproved_Date").jqxDateTimeInput({
            height: '25px',
            formatString: 'dd-MMM-yyyy'
        });
        $("#UM_dApproved_Date").jqxDateTimeInput({
            height: '25px',
            formatString: 'dd-MMM-yyyy'
        });

        var url = "Pr_Fetch_User_Master_Details?Area=" + Area;
        var source = {
            datatype: "json",
            datafields: [{
                    name: 'UM_iID',
                    type: 'string'
                },
                {
                    name: 'UM_vUser_Name',
                    type: 'string'
                },
                {
                    name: 'UM_vUser_ID',
                    type: 'string'
                },
                {
                    name: 'UM_vPassword',
                    type: 'string'
                },
                {
                    name: 'UM_vC_Password',
                    type: 'string'
                },
                {
                    name: 'UM_vPhone_Number',
                    type: 'string'
                },
                {
                    name: 'UM_vEmail_ID',
                    type: 'string'
                },
                {
                    name: 'UM_iArea',
                    type: 'string'
                },
                {
                    name: 'UM_iUser_Type',
                    type: 'string'
                },
                {
                    name: 'UM_iCoordinator',
                    type: 'string'
                },
                {
                    name: 'UM_dApproved_Date',
                    type: 'string'
                },
                {
                    name: 'UM_iApproved_By',
                    type: 'string'
                },
                {
                    name: 'UM_vCreated_by',
                    type: 'string'
                },
            ],
            id: 'id',
            url: url
        };
        var dataAdapter = new $.jqx.dataAdapter(source);
        $("#Grid").jqxGrid({
            theme: 'ui-sunny',
            width: '100%',
            height: '480px',
            source: dataAdapter,
            columnsresize: true,
            pageable: true,
            enabletooltips: false,
            pagermode: 'simple',
            enabletooltips: true,
            showfilterrow: true,
            filterable: true,
            pagesize: 14,
            columns: [{
                    text: 'ID',
                    datafield: 'UM_iID',
                    width: '100px',
                    hidden: true
                },
                {
                    text: 'User Name',
                    datafield: 'UM_vUser_Name'
                },
                {
                    text: 'First Name',
                    datafield: 'UM_vUser_ID',
                    width: '8%'
                },
                {
                    text: 'Password',
                    datafield: 'UM_vPassword',
                    width: '8%'
                },
                {
                    text: 'C Password',
                    datafield: 'UM_vC_Password',
                    width: '10%'
                },
                {
                    text: 'Phone Number',
                    datafield: 'UM_vPhone_Number',
                    width: '11%'
                },
                {
                    text: 'Email ID',
                    datafield: 'UM_vEmail_ID',
                    width: '17%'
                },
                {
                    text: 'Area',
                    datafield: 'UM_iArea',
                    width: '11%'
                },
                {
                    text: 'User Type',
                    datafield: 'UM_iUser_Type',
                    width: '10%'
                },
                {
                    text: 'Coordinator',
                    datafield: 'UM_iCoordinator',
                    width: '8%',
                    hidden: true
                },
                {
                    text: 'Approved Date',
                    datafield: 'UM_dApproved_Date',
                    width: '8%',
                    hidden: true
                },
                {
                    text: 'Approved By',
                    datafield: 'UM_iApproved_By',
                    width: '8%',
                    hidden: true
                },
                {
                    text: 'Edit',
                    datafield: 'Edit',
                    filterable: false,
                    width: 40,
                    cellsrenderer: function() {
                        return '<div style="width: 100%"><img src="../../../img/Edit1.png" style="margin-left: 25%" /></div>';
                    }
                },
                {
                    text: 'Del',
                    datafield: 'delete',
                    filterable: false,
                    width: 40,
                    cellsrenderer: function() {
                        return '<div style="width: 100%"><img src="../../../img/del.png" style="margin-left: 25%" /></div>';
                    }
                },
            ]
        });
        $("#Grid").on("cellclick", function(event) {
            var column = event.args.column;
            var rowindex = event.args.rowindex;
            var columnindex = event.args.columnindex;
            if (columnindex == 12) {                
                editrow = rowindex;
                var dataRecord = $("#Grid").jqxGrid('getrowdata', editrow);
                ID = dataRecord.UM_iID;
                var url = "Pr_Fetch_User_Master_ByID?ID=" + ID;
                var source = {
                    datatype: "json",
                    datafields: [{
                            name: 'UM_iID',
                            type: 'string'
                        },
                        {
                            name: 'UM_vUser_Name',
                            type: 'string'
                        },
                        {
                            name: 'UM_vUser_ID',
                            type: 'string'
                        },
                        {
                            name: 'UM_vPassword',
                            type: 'string'
                        },
                        {
                            name: 'UM_vC_Password',
                            type: 'string'
                        },
                        {
                            name: 'UM_vPhone_Number',
                            type: 'string'
                        },
                        {
                            name: 'UM_vEmail_ID',
                            type: 'string'
                        },
                        {
                            name: 'UM_iArea',
                            type: 'string'
                        },
                        {
                            name: 'UM_iUser_Type',
                            type: 'string'
                        },
                        {
                            name: 'UM_iCoordinator',
                            type: 'string'
                        },
                        {
                            name: 'UM_dApproved_Date',
                            type: 'string'
                        },
                        {
                            name: 'UM_iApproved_By',
                            type: 'string'
                        },
                    ],
                    id: 'id',
                    url: url
                };
                var dataAdapter_per = new $.jqx.dataAdapter(source, {
                    contentType: 'application/json; charset=utf-8',
                    loadComplete: function() {
                        var length = dataAdapter_per.records.length;
                        var records = dataAdapter_per.records;
                        var record = records[0];
                        $('#UM_iID').val(record.UM_iID);
                        $('#UM_vUser_Name').val(record.UM_vUser_Name);
                        $('#UM_vUser_ID').val(record.UM_vUser_ID);
                        $('#UM_vPassword').val(record.UM_vPassword);
                        $('#UM_vC_Password').val(record.UM_vC_Password);
                        $('#UM_vPhone_Number').val(record.UM_vPhone_Number);
                        $('#UM_vEmail_ID').val(record.UM_vEmail_ID);
                        $('#UM_iArea').val(record.UM_iArea);
                        $('#UM_iUser_Type').val(record.UM_iUser_Type);
                        $('#UM_iCoordinator').val(record.UM_iCoordinator);
                        var UM_dApproved_Date = new Date(Date.parse(record.UM_dApproved_Date));
                        $('#UM_dApproved_Date').val(UM_dApproved_Date);
                        $('#UM_iApproved_By').val(record.UM_iApproved_By);
                        $("#btn_save_label").text('Update');
                        $('#myModal').modal('show');
                    },
                    error: function(xhr, status, error) {
                        alert(JSON.stringify(xhr));
                    }
                })
                dataAdapter_per.dataBind();
            }
            if (columnindex == 13) {               
                editrow = rowindex;
                var dataRecord = $("#Grid").jqxGrid('getrowdata', editrow);
                var id = dataRecord.UM_iID;
                var a = confirm("Are you sure want to delete press OK");
                if(a == true) {
                    $.ajax({
                        type: 'POST',
                        contentType: "application/json; charset=utf-8",
                        url: 'Pr_Delete_User_Master',
                        data: "{'ID':'" + dataRecord.UM_iID + "'}",
                        async: false,
                        success: function(response) {
                            $("#Grid").jqxGrid('updatebounddata');
                            alert('Record Deleted Success');
                        },
                        error: function() {
                            console.log('there is some error');
                        }
                    });
                }
            }
        });


        $('#form1').jqxValidator({
            hintType: 'label',
            animationDuration: 2,
            rules: [{
                input: '#UM_vPhone_Number',
                message: 'Phone Number Required..!',
                action: 'keyup, blur',
                rule: function (input) {
                    if ($("#UM_vPhone_Number").val() == "") return false; else return true;
                },
                focus: true
            }, {
                input: '#UM_vPassword',
                message: 'Password Required..!',
                action: 'keyup, blur',
                rule: 'required',
                focus: true
            }, {
                input: '#UM_vC_Password',
                message: 'Conform Password Required..!',
                action: 'keyup, blur',
                rule: 'required',
                focus: true
            }, {
                input: '#UM_vEmail_ID',
                message: 'Email Id Required..!',
                action: 'keyup, blur',
                rule: 'required',
                focus: true
            }, ]
        });
        var flag = false;
        var flag = false;
        $('#form1').on('validationSuccess', function(event) {
            flag = true;
        });


        $("#btn_Save").click(function() {
            $('#form1').jqxValidator('validate');
            if(flag == true) {
                if($("#btn_save_label").text() == 'Save') {
                    save();
                } else {
                    Update();
                }
                flag = false;
            }
        });



        function save() {
            $.ajax({
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                url: 'Pr_Insert_User_Master',
                data: "{'UM_vUser_Name':'" + $('#UM_vUser_Name').val() +
                    "', 'UM_vUser_ID':'" + $('#UM_vUser_ID').val() +
                    "', 'UM_vPassword':'" + $('#UM_vPassword').val() +
                    "', 'UM_vC_Password':'" + $('#UM_vC_Password').val() +
                    "', 'UM_vPhone_Number':'" + $('#UM_vPhone_Number').val() +
                    "', 'UM_vEmail_ID':'" + $('#UM_vEmail_ID').val() +
                    "', 'UM_iArea':'" + $('#UM_iArea').val() +
                    "', 'UM_iUser_Type':'" + $('#UM_iUser_Type').val() +
                    "', 'UM_iCoordinator':'" + $('#UM_iCoordinator').val() +
                    "', 'UM_dApproved_Date':'" + $('#UM_dApproved_Date').val() +
                    "', 'UM_iApproved_By':'" + $('#UM_iApproved_By').val() +
                    "', 'UM_vCreated_by':'" + User +
                    "'}",
                async: false,
                success: function (response) {
                    if (response=='True')
                    {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Saved Successfully" });
                        $("#Grid").jqxGrid('updatebounddata');
                        Clear();
                    }
            else
                    {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                    
                },
                error: function() {
                    console.log('there is some error');
                }
            });
        }

        function Update() {
            $.ajax({
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                url: 'Pr_update_User_Master',
                data: "{'UM_iID':'" + ID +
                    "', 'UM_vUser_Name':'" + $('#UM_vUser_Name').val() +
                    "', 'UM_vUser_ID':'" + $('#UM_vUser_ID').val() +
                    "', 'UM_vPassword':'" + $('#UM_vPassword').val() +
                    "', 'UM_vC_Password':'" + $('#UM_vC_Password').val() +
                    "', 'UM_vPhone_Number':'" + $('#UM_vPhone_Number').val() +
                    "', 'UM_vEmail_ID':'" + $('#UM_vEmail_ID').val() +
                    "', 'UM_iArea':'" + $('#UM_iArea').val() +
                    "', 'UM_iUser_Type':'" + $('#UM_iUser_Type').val() +
                    "', 'UM_iCoordinator':'" + $('#UM_iCoordinator').val() +
                    "', 'UM_dApproved_Date':'" + $('#UM_dApproved_Date').val() +
                    "', 'UM_iApproved_By':'" + $('#UM_iApproved_By').val() +
                    "', 'UM_vCreated_by':'" + User +
                    "'}",
                async: false,
                success: function (response) {
                    if (response == 'True')
                    {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Saved Successfully" });
                        $("#btn_save_label").text('Save');
                        $("#Grid").jqxGrid('updatebounddata');
                        $('#myModal').modal('hide');
                        Clear();
                    }
                    else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }                    
                },
                error: function() {
                    console.log('there is some error');
                }
            });
        }

        function Clear() {
            $('#UM_vUser_Name').val('');
            $('#UM_vUser_ID').val('');
            $('#UM_vPassword').val('');
            $('#UM_vC_Password').val('');
            $('#UM_vPhone_Number').val('');
            $('#UM_vEmail_ID').val('');
            $('#UM_iArea').val('');
            $('#UM_iUser_Type').val('');
            $('#UM_iCoordinator').val('');
            $('#UM_dApproved_Date').val('');
            $('#UM_iApproved_By').val('');
            $("#btn_save_label").text('Save');
            flag = false;
        }
        $("#btn_AddNew").click(function() {
            $("#btn_save_label").text('Save');
            Clear();
        })
        $("#sidebar-collapse").click(function() {
            $("#Grid").jqxGrid('updatebounddata');
        });
        $("#btn_Clear").click(function() {
            Clear();
        })
        $("#btn_Refresh").click(function() {
            $("#Grid").jqxGrid('updatebounddata');
        })
        $("#btn_Excel").click(function () {
            window.open("../../Master/Export_To_Excel?FileName=User_Master&Heading=User Master&Data=Pr_Fetch_User_Master_Details_Excel");

        })

        $("#Master").addClass("active");
        $("#User_Master").addClass("active");

        $("#btn_Pdf").click(function() {})
        $("#btn_Chart").click(function() {})
        $("#btn_Help").click(function() {})
    });
</script>



<div class="content-wrapper">
    <section class="content">
        <div class="row">
            <div class="col-xs-12" style="padding:5px;  padding-top:0px">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">User Master</h3>
                        <div class="box-tools pull-right">
                            <button type="button" id="btn_AddNew" title="Add New" data-rel="tooltip" class="btn btn-box-tool" data-toggle="modal" data-target="#myModal" style="padding:5px"><span class='fa fa fa-plus-square  bigger-130 green'></span></button>
                            <button type="button" id="btn_Refresh" title="Refresh" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-refresh bigger-130 vilote'></span></button>
                            <button type="button" id="btn_Excel" title="Export to Excel" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-file-excel-o bigger-130 green'></span></button>
                            @*<button type="button" id="btn_Pdf" title="Export to Pdf" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-file-pdf-o bigger-130 red'> </span></button>*@
                        </div>
                        <!-- /.nav-search -->
                    </div>
                    <div class="box-body">
                        <div class="col-md-12" style="padding-left:0px; padding-right:0px">
                            <div id="Grid"></div>
                        </div>
                    </div>
                </div>
                <div class="modal fade" id="myModal">
                    <div class="modal-dialog">
                        <div>
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title">User Master <span class="pull-right ">
                                            <a href="#" data-dismiss="modal" aria-label="Close">
                                                <i class="ace-icon fa fa-times"></i>
                                            </a>
                                        </span> </h3>
                                </div>
                                <div class="panel-body">
                                    <form class="form-horizontal" role="form" id="form1">
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star">*</span> User Name  </label>
                                            <div class="col-sm-7">
                                                <input id="UM_vUser_Name" type="text" placeholder="User Name" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star">*</span> First Name </label>
                                            <div class="col-sm-7">
                                                <input id="UM_vUser_ID" type="text" placeholder="User ID" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star">*</span> Password </label>
                                            <div class="col-sm-7">
                                                <input id="UM_vPassword" type="password" placeholder="Password" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star">*</span> C Password </label>
                                            <div class="col-sm-7">
                                                <input id="UM_vC_Password" type="password" placeholder="C Password" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star">*</span> Phone Number </label>
                                            <div class="col-sm-7">
                                                <input id="UM_vPhone_Number" type="number"   class="form-control" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star">*</span> Email ID </label>
                                            <div class="col-sm-7">
                                                <input id="UM_vEmail_ID" type="text" placeholder="Email ID" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label no-padding-right" for="form-field-1"> Area </label>
                                            <div class="col-sm-7">
                                                <div id="UM_iArea"></div>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label no-padding-right" for="form-field-1"> User Type </label>
                                            <div class="col-sm-7">
                                                <div id="UM_iUser_Type"></div>
                                            </div>
                                        </div>
                                        <div class="form-group hidden">
                                            <label class="col-sm-4 control-label no-padding-right" for="form-field-1"> Coordinator </label>
                                            <div class="col-sm-7">
                                                <input id="UM_iCoordinator" type="text" placeholder="Coordinator" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="form-group hidden">
                                            <label class="col-sm-4 control-label no-padding-right" for="form-field-1"> Approved Date </label>
                                            <div class="col-sm-7">
                                                <div id="UM_dApproved_Date"></div>
                                            </div>
                                        </div>
                                        <div class="form-group hidden">
                                            <label class="col-sm-4 control-label no-padding-right" for="form-field-1"> Approved By </label>
                                            <div class="col-sm-7">
                                                <input id="UM_iApproved_By" type="text" placeholder="Approved By" class="form-control" />
                                            </div>
                                        </div>
                                    </form>
                                    <div class="col-sm-5"></div>
                                    <p>
                                        <button id="btn_Save" class="btn btn-white btn-info btn-bold">
                                            <i class="ace-icon fa fa-floppy-o bigger-120 blue"></i>
                                            <span id="btn_save_label">Save</span>
                                        </button>
                                        <button id="btn_Clear" class="btn btn-white btn-warning btn-bold">
                                            <i class="ace-icon fa fa-trash-o bigger-120 orange"></i>
                                            Clear
                                        </button>
                                        <button class="btn btn-white btn-default btn-round" data-dismiss="modal">
                                            <i class="ace-icon fa fa-times red2"></i>
                                            Close
                                        </button>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>