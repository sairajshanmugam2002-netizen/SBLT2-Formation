@{
    ViewBag.Title = "Material_Master";
}

<script type="text/javascript">
    $(document).ready(function () {
        var ID = 0;
        var User = sessionStorage.getItem("user");

        var url = "../../Master/pr_FetchLocation"//?ID=" + User;
        var Source =
        {
            datatype: "json",
            datafields: [
                { name: 'lm_Id', type: 'string' },
                { name: 'lm_LocationName', type: 'string' }
            ],
            id: 'id',
            url: url
        };
        var adapter = new $.jqx.dataAdapter(Source);
        $("#mm_Location").jqxComboBox({ selectedIndex: -1, source: adapter, displayMember: "lm_LocationName", valueMember: "lm_Id", width: '100%', height: '30' });

        var url = "../../Master/pr_FetchCustomer"//?ID=" + User;
        var Source =
        {
            datatype: "json",
            datafields: [
                { name: 'cm_iTransId', type: 'string' },
                { name: 'cm_vCustomerName', type: 'string' }
            ],
            id: 'id',
            url: url
        };
        var adapter = new $.jqx.dataAdapter(Source);
        $("#mm_CustomerName").jqxComboBox({ selectedIndex: -1, source: adapter, displayMember: "cm_vCustomerName", valueMember: "cm_iTransId", width: '100%', height: '30' });


        var url = "Pr_Fetch_Material_Master_Details_Web";
        var source = {
            datatype: "json",
            datafields: [{name: 'mm_ID',type: 'string'},{name: 'mm_MaterialCode',type: 'string'},
                { name: 'mm_MaterialDesc', type: 'string' }, { name: 'mm_CustomerName', type: 'string' },
                { name: 'mm_Model', type: 'string' }, { name: 'mm_MaxStock', type: 'string' },
                { name: 'mm_Location', type: 'string' }, { name: 'mm_MinStock', type: 'string' },
            ],
            id: 'id',
            url: url
        };
        var dataAdapter = new $.jqx.dataAdapter(source);
        $("#Grid").jqxGrid({theme: 'ui-sunny', width: '100%',height: '480px',source: dataAdapter,columnsresize: true,
            pageable: true,enabletooltips: false,pagermode: 'simple',enabletooltips: true,selectionmode: 'checkbox',
            showfilterrow: true,filterable: true,pagesize: 14,
            columns: [{text: 'Edit',datafield: 'Edit',filterable: false,width: 40,
                cellsrenderer: function () {
                    return '<div style="width: 100%"><img src="../../../img/Edit1.png" style="margin-left: 25%" /></div>';
                }
            },
                //{
                //    text: 'Del',
                //    datafield: 'delete',
                //    filterable: false,
                //    width: 40,
                //    cellsrenderer: function () {
                //        return '<div style="width: 100%"><img src="../../../img/del.png" style="margin-left: 25%" /></div>';
                //    }
                //},
                {
                text: 'ID',
                datafield: 'mm_ID',
                width: '10%',
                hidden: true
            },
            {text: 'Material Code',datafield: 'mm_MaterialCode',width: '25%'},
            {text: 'Material Description',datafield: 'mm_MaterialDesc',width: '15%'},
                { text: 'Model', datafield: 'mm_Model', width: '10%' }, { text: 'Location', datafield: 'mm_Location', width: '10%' },
                { text: 'Customer', datafield: 'mm_CustomerName', width: '10%' }, { text: 'Max Stock', datafield: 'mm_MaxStock', width: '10%' },
                { text: 'Min Stock', datafield: 'mm_MinStock', width: '10%' },
            ]
        });
        $("#Grid").on("cellclick", function (event) {
            var column = event.args.column;
            var rowindex = event.args.rowindex;
            var columnindex = event.args.columnindex;
            if (columnindex == 1) {
                editrow = rowindex;
                var dataRecord = $("#Grid").jqxGrid('getrowdata', editrow);
                ID = dataRecord.mm_ID;
                var url = "Pr_Fetch_Material_Master_ByID?ID=" + ID;
                var source = {
                    datatype: "json",
                    datafields: [{
                        name: 'mm_ID',
                        type: 'string'
                    },
                        {
                            name: 'mm_MaterialCode',
                            type: 'string'
                        }, { name: 'mm_CustomerName', type: 'string' },
                        {
                            name: 'mm_Model',
                            type: 'string'
                        },
                        {
                            name: 'mm_MaterialDesc',
                            type: 'string'
                        },
                        {
                            name: 'mm_Location',
                            type: 'string'
                        }, { name: 'mm_MaxStock', type: 'string' }, { name: 'mm_MinStock', type: 'string' },
                    ],
                    id: 'id',
                    url: url
                };
                var dataAdapter_per = new $.jqx.dataAdapter(source, {
                    contentType: 'application/json; charset=utf-8',
                    loadComplete: function () {
                        var length = dataAdapter_per.records.length;
                        var records = dataAdapter_per.records;
                        var record = records[0];
                        $('#mm_ID').val(record.mm_ID);
                        $('#mm_MaterialCode').val(record.mm_MaterialCode);
                        $('#blah1').attr('src', "../../" + record.TM_vDocumentLocation);
                        $('#mm_Model').val(record.mm_Model);
                        $('#mm_MaterialDesc').val(record.mm_MaterialDesc);
                        $('#mm_Location').val(record.mm_Location); $('#mm_CustomerName').val(record.mm_CustomerName);
                        $('#mm_MinStock').val(record.mm_MinStock); $('#mm_MaxStock').val(record.mm_MaxStock);
                        $("#btn_save_label").text('Update');
                        $('#myModal').modal('show');
                    },
                    error: function (xhr, status, error) {
                        alert(JSON.stringify(xhr));
                    }
                })
                dataAdapter_per.dataBind();
            }
        });

        $('#Delete').click(function () {
            debugger           
                var selectedrows = $('#Grid').jqxGrid('getselectedrowindexes');
                if (selectedrows.length <= 0) {
                    alert('Please select row want to Delete');
                    return;
                }
                else {
                    var a = confirm("Are you sure want to delete press OK");
                    if (a == true) {
                    for (var i = 0; i < selectedrows.length; i++) {
                        mm_ID = $('#Grid').jqxGrid('getcellvalue', selectedrows[i], "mm_ID");
                        $.ajax({
                            type: 'POST',
                            contentType: "application/json; charset=utf-8",
                            url: 'Pr_Delete_Material_Master',
                            data: "{'ID':'" + mm_ID + "'}",
                            async: false,
                            success: function (response) {
                                //$("#Grid").jqxGrid('updatebounddata');
                                //alert('Record Deleted Successfully');
                            },
                            error: function () {
                                console.log('there is some error');
                            }
                        });
                    }
                }
                    else {
                        $('#Grid').jqxGrid('clearselection');
                        return;
                    }
            }
            alert("Record Saved Successfully...!");
            $('#Grid').jqxGrid('clearselection');
            $("#Grid").jqxGrid('updatebounddata');
        });

        $('#form1').jqxValidator({
            hintType: 'label',
            animationDuration: 2,
            rules: [ {
                input: '#mm_MaterialCode',
                message: 'Customer Name Required..!',
                action: 'keyup, blur',
                rule: 'required',
                focus: true
            }, {
                    input: '#mm_Model',
                    message: 'Customer mm_MaterialDesc Required..!',
                action: 'keyup, blur',
                rule: 'required',
                focus: true
            }, ]
        });
        var flag = false;
        var flag = false;
        $('#form1').on('validationSuccess', function (event) {
            flag = true;
        });


        $("#btn_Save").click(function () {
            $('#form1').jqxValidator('validate');
            if (flag == true) {
                if ($("#btn_save_label").text() == 'Save') {
                    save();
                } else {
                    Update();
                }
                flag = false;
            }
        });

        function readURL(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#blah1').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        $("#imgInp").change(function () {
            readURL(this);
        });

        function save() {
            var data = new FormData();
            //var files = $("#imgInp").get(0).files;
            //if (files.length > 0) {
            //    data.append("MyImages", files[0]);
            //    //alert("hii");
            //}
            $.ajax({
                url: "Pr_Insert_Material_Master?mm_MaterialCode=" + $('#mm_MaterialCode').val() + "&mm_CustomerName=" + $('#mm_CustomerName').val() +
                    "&mm_Model=" + $('#mm_Model').val() + "&mm_MinStock=" + $('#mm_MinStock').val() + "&mm_MaxStock=" + $('#mm_MaxStock').val() +
                    "&mm_MaterialDesc=" + $('#mm_MaterialDesc').val() + "&mm_Location=" + $('#mm_Location').val() + "&mm_User=" + User,
                type: "POST",
                processData: false,
                contentType: false,
                data: data,
                async: false,
                success: function (response) {
                    if (response == 'True') {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Saved Successfully" });
                        $("#Grid").jqxGrid('updatebounddata');
                        $('#blah1').attr('src', "../../");
                        Clear();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function (er) {
                    alert(er.responseText);
                }
            });
        }

        function Update() {
            var data = new FormData();
            //var files = $("#imgInp").get(0).files;
            //if (files.length > 0) {
            //    data.append("MyImages", files[0]);
            //}
            $.ajax({
                url: "Pr_Update_Material_Master?mm_ID=" + ID + "&mm_MaterialCode=" + $('#mm_MaterialCode').val() + "&mm_CustomerName=" + $('#mm_CustomerName').val() +
                    "&mm_Model=" + $('#mm_Model').val() + "&mm_MinStock=" + $('#mm_MinStock').val() + "&mm_MaxStock=" + $('#mm_MaxStock').val() +
                    "&mm_MaterialDesc=" + $('#mm_MaterialDesc').val() + "&mm_Location=" + $('#mm_Location').val(),
               type: "POST",
                processData: false,
                contentType: false,
                data: data,
                async: false,
                success: function (response) {
                    if (response == 'True') {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Updated Successfully" });
                        $("#Grid").jqxGrid('updatebounddata');
                        Clear();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function (er) {
                    alert(er.responseText);
                }
            });
        }

        function Clear() {
            $('#mm_MaterialCode').val('');
            $('#mm_Model').val('');
            $('#mm_MaterialDesc').val('');
            $('#mm_Location').val('');
            $("#btn_save_label").text('Save');
            $('#blah1').attr('src', "../../");
            flag = false;
        }

        $("#Master").addClass("active");
        $("#Material_Master").addClass("active");

        $("#btn_AddNew").click(function () {
            $("#btn_save_label").text('Save');
            Clear();
        })
        $("#sidebar-collapse").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        });
        $("#btn_Clear").click(function () {
            Clear();
        })
        $("#btn_Refresh").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        })
        $("#btn_Excel").click(function () {
            window.open("../../Master/Export_To_Excel?FileName=Material_Master&Heading=Material Master&Data=Pr_Fetch_Material_Master_Details_Web_Excel");
        })
        $("#btn_Pdf").click(function () { })
        $("#btn_Chart").click(function () { })
        $("#btn_Help").click(function () { })
    });
</script>

<div class="content-wrapper">
    <section class="content">
        <div class="row">
            <div class="col-xs-12" style="padding:5px;  padding-top:0px">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">Material Master</h3>
                        <div class="box-tools pull-right">
                            <button type="button" id="btn_AddNew" title="Add New" data-rel="tooltip" class="btn btn-box-tool" data-toggle="modal" data-target="#myModal" style="padding:5px"><span class='fa fa fa-plus-square  bigger-130 green'></span></button>
                            <button type="button" id="btn_Refresh" title="Refresh" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-refresh bigger-130 vilote'></span></button>
                            <button type="button" id="btn_Excel" title="Export to Excel" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-file-excel-o bigger-130 green'></span></button>
                            @*<button type="button" id="btn_Pdf" title="Export to Pdf" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-file-pdf-o bigger-130 red'> </span></button>*@
                        </div>
                        <!-- /.nav-search -->
                    </div>
                    <div class="box-body">
                        <div class="col-sm-4" style="max-width: 70px; padding-left: 0px; padding-right: 0px">
                            <button type="button" id="Delete" style="width: 100px;background-color: red">Delete</button>
                        </div>
                        <p></p>
                        <div class="col-md-12" style="padding-left:0px; padding-right:0px">
                            <div id="Grid"></div>
                        </div>
                    </div>
                </div>
                <div class="modal fade  bd-example-modal-lg" id="myModal">
                    <div class="modal-dialog modal-lg">
                        <div>
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title">
                                        Material Master <span class="pull-right ">
                                            <a href="#" data-dismiss="modal" aria-label="Close">
                                                <i class="ace-icon fa fa-times"></i>
                                            </a>
                                        </span>
                                    </h3>
                                </div>
                                <div class="panel-body">
                                    <form class="form-horizontal" role="form" id="form1">                                       
                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star">*</span>Material Code</label>
                                                <div class="col-sm-7">
                                                    <input id="mm_MaterialCode" type="text" placeholder="Material Code" class="form-control" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label no-padding-right" for="form-field-1"> <span class="star"></span>Material Name</label>
                                                <div class="col-sm-7">
                                                    <input id="mm_MaterialDesc" type="text" placeholder="Material Name" class="form-control" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star">*</span>Model</label>
                                                <div class="col-sm-7">
                                                    <input id="mm_Model" type="text" placeholder="Model" class="form-control" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star"></span>Location</label>
                                                <div class="col-sm-7">
                                                    <div id="mm_Location"></div>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star"></span>Customer Name</label>
                                                <div class="col-sm-7">
                                                    <div id="mm_CustomerName"></div>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star"></span>Minimum Stock</label>
                                                <div class="col-sm-7">
                                                    <input id="mm_MinStock" type="text" placeholder="Minimum Stock" class="form-control" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label no-padding-right" for="form-field-1"><span class="star"></span>Maximum Stock</label>
                                                <div class="col-sm-7">
                                                    <input id="mm_MaxStock" type="text" placeholder="Maximum Stock" class="form-control" />
                                                </div>
                                            </div>
                                        </div>

                                    </form>
                                    <div class="col-sm-5"></div>
                                    <p>
                                        <button id="btn_Save" class="btn btn-white btn-info btn-bold">
                                            <i class="ace-icon fa fa-floppy-o bigger-120 blue"></i>
                                            <span id="btn_save_label">Save</span>
                                        </button>
                                        <button id="btn_Clear" class="btn btn-white btn-warning btn-bold">
                                            <i class="ace-icon fa fa-trash-o bigger-120 orange"></i>
                                            Clear
                                        </button>
                                        <button class="btn btn-white btn-default btn-round" data-dismiss="modal">
                                            <i class="ace-icon fa fa-times red2"></i>
                                            Close
                                        </button>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>


