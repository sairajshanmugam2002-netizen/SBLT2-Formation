@{
    ViewBag.Title = "User_Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">
    $(document).ready(function () {

        var ID = 0;
        var User = sessionStorage.getItem("user");;

        $("#Settings").addClass("active");
        $("#User_Master").addClass("active");

        var url = "../../Master/pr_get_Reference_Values?Type=User_Type";
        var Source =
        {
            datatype: "json",
            datafields: [
                { name: 'RGV_iID', type: 'string' },
                { name: 'RGV_vDesciption', type: 'string' }
            ],
            id: 'id',
            url: url
        };
        var adapter = new $.jqx.dataAdapter(Source);
        $("#U_LodgeID").jqxDropDownList({ selectedIndex: -1, source: adapter, displayMember: "RGV_vDesciption", valueMember: "RGV_iID", width: '100%', height: '30', autoDropDownHeight: true });


        var url = "../../Master/pr_get_Reference_Values?Type=Role";
        var Source =
        {
            datatype: "json",
            datafields: [
                { name: 'RGV_iID', type: 'int' },
                { name: 'RGV_vDesciption', type: 'string' }
            ],
            id: 'id',
            url: url
        };
        var adapter = new $.jqx.dataAdapter(Source);
        $("#U_Rights").jqxDropDownList({ selectedIndex: -1, autoDropDownHeight: true, source: adapter, displayMember: "RGV_vDesciption", valueMember: "RGV_iID", width: '100%', height: '30' });


        var url = "Pr_Fetch_T_Setting_UserMaster_Details";
        var source = {
            datatype: "json",
            datafields: [{
                name: 'U_ID',
                type: 'string'
            },
            {
                name: 'U_UserName',
                type: 'string'
            },
            {
                name: 'U_Password',
                type: 'string'
            },
            {
                name: 'U_Rights',
                type: 'string'
            },
            {
                name: 'U_LodgeID',
                type: 'string'
            },
            ],
            id: 'id',
            url: url
        };
        var dataAdapter = new $.jqx.dataAdapter(source);
        $("#Grid").jqxGrid({
            theme: 'ui-sunny',
            width: '100%',
            height: '480px',
            source: dataAdapter,
            columnsresize: true,
            pageable: true,
            enabletooltips: false,
            pagermode: 'simple',
            enabletooltips: true,
            showfilterrow: true,
            filterable: true,
            pagesize: 14,
            columns: [{
                text: 'Edit',
                datafield: 'Edit',
                filterable: false,
                width: 40,
                cellsrenderer: function () {
                    return '<div style="width: 100%"><img src="../../../img/Edit1.png" style="margin-left: 25%" /></div>';
                }
            },
                {
                    text: 'Del',
                    datafield: 'delete',
                    filterable: false,
                    width: 40,
                    cellsrenderer: function () {
                        return '<div style="width: 100%"><img src="../../../img/del.png" style="margin-left: 25%" /></div>';
                    }
                },{
                text: 'id',
                datafield: 'U_ID',
                width: '100px',
                hidden: true
            },
            {
                text: 'User Name',
                datafield: 'U_UserName'
            },
            {
                text: 'Password',
                datafield: 'U_Password',
                width: '20%'
            },
            {
                text: 'Rights',
                datafield: 'U_Rights',
                width: '20%'
            },           
            ]
        });
        $("#Grid").on("cellclick", function (event) {
            var column = event.args.column;
            var rowindex = event.args.rowindex;
            var columnindex = event.args.columnindex;
            if (columnindex == 0) {
                //alert("edit");
                editrow = rowindex;
                var dataRecord = $("#Grid").jqxGrid('getrowdata', editrow);
                ID = dataRecord.U_ID;               
                $('#U_ID').val(dataRecord.U_ID);
                $('#U_UserName').val(dataRecord.U_UserName);
                $('#U_Password').val(dataRecord.U_Password);
                $('#U_Rights').val(dataRecord.U_Rights);
                $('#U_LodgeID').val(dataRecord.U_LodgeID);
                $("#btn_save_label").text('Update');
                $('#myModal').modal('show');            
                dataAdapter_per.dataBind();
            }
            if (columnindex == 1) {
                //alert("edit");
                editrow = rowindex;
                var dataRecord = $("#Grid").jqxGrid('getrowdata', editrow);
                var id = dataRecord.U_ID;
                var a = confirm("Are you sure want to delete press OK");
                if (a == true) {
                    $.ajax({
                        type: 'POST',
                        contentType: "application/json; charset=utf-8",
                        url: 'Pr_Delete_T_Setting_UserMaster',
                        data: "{'ID':'" + dataRecord.U_ID + "'}",
                        async: false,
                        success: function (response) {
                            $("#Grid").jqxGrid('updatebounddata');
                            alert('Recode Deleted Success');
                        },
                        error: function () {
                            console.log('there is some error');
                        }
                    });
                }
            }
        });


        $('#form1').jqxValidator({
            hintType: 'label',
            animationDuration: 2,
            rules: [{
                input: '#U_UserName',
                message: 'User Name Required..!',
                action: 'keyup, blur',
                rule: 'required',
                focus: true
            },]
        });
        var flag = false;
        var flag = false;
        $('#form1').on('validationSuccess', function (event) {
            flag = true;
        });


        $("#btn_Save").click(function () {
            $('#form1').jqxValidator('validate');
            if (flag == true) {
                if ($("#btn_save_label").text() == 'Save') {
                    save();
                } else {
                    Update();
                }
                flag = false;
            }
        });


        function save() {
            $.ajax({
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                url: 'Pr_Insert_T_Setting_UserMaster',
                data: "{'U_UserName':'" + $('#U_UserName').val() +
                    "', 'U_Password':'" + $('#U_Password').val() +
                    "', 'U_Rights':'" + $('#U_Rights').val() +
                    "', 'U_LodgeID':'" + $('#U_LodgeID').val() +
                    "', 'U_CreatedDBy':'" + User +
                    "'}",
                async: false,
                success: function (response) {
                    if (response == "True") {
                        alert("Record Saved Successfully...!");
                        $("#Grid").jqxGrid('updatebounddata');
                        Clear();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function () {
                    console.log('there is some error');
                }
            });
        }

        function Update() {
            $.ajax({
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                url: 'Pr_update_T_Setting_UserMaster',
                data: "{'U_ID':'" + ID +
                    "', 'U_UserName':'" + $('#U_UserName').val() +
                    "', 'U_Password':'" + $('#U_Password').val() +
                    "', 'U_Rights':'" + $('#U_Rights').val() +
                    "', 'U_LodgeID':'" + $('#U_LodgeID').val() +
                    //"', 'U_CreatedDBy':'" + User +
                    "'}",
                async: false,
                success: function (response) {
                    if (response == "True") {
                        alert("Record Updated Successfully...!");
                        $("#btn_save_label").text('Save');
                        $("#Grid").jqxGrid('updatebounddata');
                        $('#myModal').modal('hide');
                        Clear();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function () {
                    console.log('there is some error');
                }
            });
        }

        function Clear() {
            $('#U_UserName').val('');
            $('#U_Password').val('');
            $('#U_Rights').val('');
            $('#U_LodgeID').val('');
            $("#btn_save_label").text('Save');
            flag = false;
        }
        $("#btn_AddNew").click(function () {
            $("#btn_save_label").text('Save');
            Clear();
        })
        $("#sidebar-collapse").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        });
        $("#btn_Clear").click(function () {
            Clear();
        })
        $("#btn_Refresh").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        })
        $("#btn_Excel").click(function () { })
        $("#btn_Pdf").click(function () { })
        $("#btn_Chart").click(function () { })
        $("#btn_Help").click(function () { })
    });
</script>

<div class="content-wrapper">
    <section class="content">
        <div class="row">
            <div class="col-xs-12" style="padding:5px;  padding-top:0px">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">User Master</h3>
                        <div class="box-tools pull-right">
                            <button type="button" id="btn_AddNew" title="Add New" data-rel="tooltip" class="btn btn-box-tool" data-toggle="modal" data-target="#myModal" style="padding:5px"><span class='fa fa fa-plus-square bigger-130 green'></span></button>
                            <button type="button" id="btn_Refresh" title="Refresh" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-refresh bigger-130 vilote'></span></button>
                            <button type="button" id="btn_Excel" title="Export to Excel" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-file-excel-o bigger-130 green'></span></button>
                            @*<button type="button" id="btn_Pdf" title="Export to Pdf" data-rel="tooltip" class="btn btn-box-tool" style="padding:5px"><span class='fa fa-file-pdf-o bigger-130 red'></span></button>*@
                        </div>
                        <!-- /.nav-search -->
                    </div>
                    <div class="box-body">
                        <div class="col-md-12" style="padding-left:0px; padding-right:0px">
                            <div id="Grid"></div>
                        </div>
                    </div>
                </div>
                <div class="modal fade" id="myModal">
                    <div class="modal-dialog">
                        <div>
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title">
                                        User Master <span class="pull-right ">
                                            <a href="#" data-dismiss="modal" aria-label="Close">
                                                <i class="ace-icon fa fa-times"></i>
                                            </a>
                                        </span>
                                    </h3>
                                </div>
                                <div class="panel-body">
                                    <form class="form-horizontal" role="form" id="form1">
                                        <div class="form-group">
                                            <label class="col-sm-3 control-label no-padding-right" for="form-field-1">User Code</label>
                                            <div class="col-sm-7">
                                                <div id="U_LodgeID"></div>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-3 control-label no-padding-right" for="form-field-1">User Name</label>
                                            <div class="col-sm-7">
                                                <input id="U_UserName" type="text" placeholder="User Name" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-3 control-label no-padding-right" for="form-field-1">Password</label>
                                            <div class="col-sm-7">
                                                <input id="U_Password" type="text" placeholder="Password" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-3 control-label no-padding-right" for="form-field-1">Rights</label>
                                            <div class="col-sm-7">
                                                <div id="U_Rights"></div>
                                            </div>
                                        </div>
                                    </form>
                                    <div class="col-sm-5"></div>
                                    <p>
                                        <button id="btn_Save" class="btn btn-white btn-info btn-bold">
                                            <i class="ace-icon fa fa-floppy-o bigger-120 blue"></i>
                                            <span id="btn_save_label">Save</span>
                                        </button>
                                        <button id="btn_Clear" class="btn btn-white btn-warning btn-bold">
                                            <i class="ace-icon fa fa-trash-o bigger-120 orange"></i>
                                            Clear
                                        </button>
                                        <button class="btn btn-white btn-default btn-round" data-dismiss="modal">
                                            <i class="ace-icon fa fa-times red2"></i>
                                            Close
                                        </button>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
