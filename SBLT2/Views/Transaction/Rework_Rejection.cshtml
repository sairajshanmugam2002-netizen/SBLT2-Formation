@{
    ViewBag.Title = "Rework / Rejection";
}

<style>
    .required-star {
        color: #d9534f;
        font-weight: bold;
        margin-right: 3px;
    }
    .form-group label {
        font-weight: 600;
        color: #333;
        margin-bottom: 6px;
    }
    .box-title {
        font-size: 16px;
        font-weight: bold;
        color: #1e395b;
    }

    /* ==========================================================================
       Rework / Rejection: Field Block Spacing Standards (Consistent 10px Gap)
       Applied strictly to Rework / Rejection page
       ========================================================================== */
    .scanner-hero > .row,
    #formReworkRejection > .row:first-child {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 14px 10px !important; /* 14px vertical gap, 10px horizontal gap between field blocks */
        margin-left: 0 !important;
        margin-right: 0 !important;
        margin-bottom: 0 !important;
    }

    .scanner-hero > .row:before,
    .scanner-hero > .row:after,
    #formReworkRejection > .row:first-child:before,
    #formReworkRejection > .row:first-child:after {
        display: none !important;
        content: none !important;
    }

    .scanner-hero > .row > [class*="col-"],
    #formReworkRejection > .row:first-child > [class*="col-"] {
        float: none !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        margin-top: 0 !important;
        margin-bottom: 0 !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        box-sizing: border-box !important;
    }

    @@media (min-width: 992px) {
        .scanner-hero > .row > .col-md-12 {
            flex: 0 0 100% !important;
            max-width: 100% !important;
            width: 100% !important;
        }
        .scanner-hero > .row > .col-md-6 {
            flex: 0 0 calc((100% - 10px) / 2) !important;
            max-width: calc((100% - 10px) / 2) !important;
            width: calc((100% - 10px) / 2) !important;
        }
        #formReworkRejection > .row:first-child > .col-md-6 {
            flex: 0 0 calc((100% - 10px) / 2) !important;
            max-width: calc((100% - 10px) / 2) !important;
            width: calc((100% - 10px) / 2) !important;
        }
    }

    @@media (min-width: 768px) and (max-width: 991px) {
        .scanner-hero > .row > .col-md-12 {
            flex: 0 0 100% !important;
            max-width: 100% !important;
            width: 100% !important;
        }
        .scanner-hero > .row > .col-md-6,
        #formReworkRejection > .row:first-child > [class*="col-"] {
            flex: 0 0 calc((100% - 10px) / 2) !important;
            max-width: calc((100% - 10px) / 2) !important;
            width: calc((100% - 10px) / 2) !important;
        }
    }

    @@media (max-width: 767px) {
        .scanner-hero > .row > [class*="col-"],
        #formReworkRejection > .row:first-child > [class*="col-"] {
            flex: 0 0 100% !important;
            max-width: 100% !important;
            width: 100% !important;
        }
    }

    #formReworkRejection label,
    .scanner-hero label {
        display: inline-block !important;
        margin-bottom: 6px !important;
        font-size: 12.5px !important;
        font-weight: 600 !important;
        color: var(--text-primary) !important;
    }

    #formReworkRejection .form-control,
    .scanner-hero .form-control {
        width: 100% !important;
        box-sizing: border-box !important;
    }

    #formReworkRejection .jqx-widget {
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }
</style>

<div class="content-wrapper">
    <section class="content">
        <div class="row">
            <div class="col-xs-12" style="padding: 10px 15px 0 15px;">
                <!-- TOP BARCODE / BATTERY DETAILS PANEL -->
                <div class="scanner-hero" style="margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #E2E8F0; padding-bottom: 10px; margin-bottom: 14px;">
                        <h4 style="font-size: 14px; font-weight: 700; color: var(--text-primary); margin: 0; display: flex; align-items: center; gap: 8px;">
                            <span class="pulse-dot"></span>
                            <i class="fa fa-qrcode" style="color: #007A3D;"></i> Battery Serial Identification
                        </h4>
                        <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #007A3D; background: #E6F4EC; border: 1px solid #A7F3D0; padding: 2px 8px; border-radius: 12px;">
                            <i class="fa fa-barcode"></i> Ready For Scan
                        </span>
                    </div>
                    <div class="row">
                        <!-- 1. QR Code / Serial Scanner -->
                        <div class="col-md-12 col-sm-12">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label for="txt_Scan_QRCode" style="font-weight: 600; font-size: 12.5px; color: var(--text-primary);">
                                    Battery Serial / QR Code <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-addon" style="background-color: var(--input-addon-bg); color: var(--input-addon-text); border-color: var(--input-border);">
                                        <i class="fa fa-barcode text-primary"></i>
                                    </span>
                                    <input type="text" 
                                           id="txt_Scan_QRCode" 
                                           name="txt_Scan_QRCode" 
                                           class="form-control" 
                                           placeholder="Scan 10-digit serial..." 
                                           maxlength="30" 
                                           autocomplete="off" 
                                           autofocus 
                                           style="font-weight: 700; letter-spacing: 0.8px; font-variant-numeric: tabular-nums;" />
                                    <span class="input-group-btn">
                                        <button class="btn btn-default" type="button" id="btn_Clear_Scan" title="Clear Scanner Input">
                                            <i class="fa fa-times text-muted"></i>
                                        </button>
                                    </span>
                                </div>
                                <small id="scan_feedback" class="text-muted" style="display: block; margin-top: 4px; font-size: 11px;">
                                    Scan QR code with scanner or hit Enter.
                                </small>
                            </div>
                        </div>

                        <!-- 2. Battery Type Read-Only Box -->
                        <div class="col-md-6 col-sm-6">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label for="txt_Battery_Type" style="font-weight: 600; font-size: 12.5px; color: var(--text-primary);">
                                    Battery Type
                                </label>
                                <div class="input-group">
                                    <span class="input-group-addon" style="background-color: var(--input-addon-bg); color: var(--input-addon-text); border-color: var(--input-border);">
                                        <i class="fa fa-battery-three-quarters text-green"></i>
                                    </span>
                                    <input type="text" 
                                           id="txt_Battery_Type" 
                                           name="txt_Battery_Type" 
                                           class="form-control" 
                                           placeholder="-- Auto-filled from Serial --" 
                                           readonly 
                                           style="background-color: var(--input-disabled-bg); font-weight: 600; color: var(--text-primary); border-color: var(--input-border);" />
                                </div>
                            </div>
                        </div>

                        <!-- 3. CKT No Read-Only Box -->
                        <div class="col-md-6 col-sm-6">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label for="txt_CKT_No" style="font-weight: 600; font-size: 12.5px; color: var(--text-primary);">
                                    CKT No
                                </label>
                                <div class="input-group">
                                    <span class="input-group-addon" style="background-color: var(--input-addon-bg); color: var(--input-addon-text); border-color: var(--input-border);">
                                        <i class="fa fa-bolt text-warning"></i>
                                    </span>
                                    <input type="text" 
                                           id="txt_CKT_No" 
                                           name="txt_CKT_No" 
                                           class="form-control" 
                                           placeholder="-- Auto-filled from Serial --" 
                                           readonly 
                                           style="background-color: var(--input-disabled-bg); font-weight: 600; color: var(--text-primary); border-color: var(--input-border);" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="box box-primary" style="border-top: 3px solid var(--ar-primary) !important;">
                    <div class="box-header with-border" style="background-color: var(--card-header-bg); padding: 14px 20px;">
                        <h3 class="box-title" style="font-size: 15px; font-weight: 700; color: var(--text-primary);">
                            <i class="fa fa-wrench" style="color: var(--ar-primary); margin-right: 6px;"></i>
                            Rework / Rejection Entry
                        </h3>
                        <div class="box-tools pull-right">
                            <button type="button" id="btn_Refresh" title="Refresh Grid Data" class="btn btn-box-tool">
                                <span class='fa fa-refresh text-primary'></span>
                            </button>
                        </div>
                    </div>

                    <div class="panel-body" style="padding: 20px 24px;">

                        <!-- VISUAL DEFECT TYPE TOGGLE PILLS -->
                        <div style="margin-bottom: 16px;">
                            <label style="font-size: 12px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">
                                Quick Select Defect Mode:
                            </label>
                            <div class="defect-toggle-group" id="toggle_DefectType">
                                <button type="button" class="defect-toggle-btn toggle-rework" id="toggle_Rework">
                                    <i class="fa fa-wrench"></i> Rework Defect
                                </button>
                                <button type="button" class="defect-toggle-btn toggle-rejection" id="toggle_Rejection">
                                    <i class="fa fa-ban"></i> Rejection Defect
                                </button>
                            </div>
                        </div>

                        <form class="form-horizontal" role="form" id="formReworkRejection" onsubmit="return false;">
                            <!-- Hidden ddlType dropdown container to preserve adapter, event handlers and backend POST data -->
                            <div style="position: absolute; left: -9999px; visibility: hidden; width: 200px; height: 34px;" aria-hidden="true">
                                <div id="ddlType"></div>
                            </div>

                            <div class="row">
                                <!-- Field 1: Reason -->
                                <div class="col-md-6 col-sm-6 form-group">
                                    <label for="ddlReason">
                                        <span class="required-star">*</span> 1. Reason
                                    </label>
                                    <div id="ddlReason"></div>
                                </div>

                                <!-- Field 2: Employee -->
                                <div class="col-md-6 col-sm-6 form-group">
                                    <label for="ddlEmployee">
                                        <span class="required-star">*</span> 2. Employee
                                    </label>
                                    <div id="ddlEmployee"></div>
                                </div>
                            </div>

                            <div class="row" style="margin-top: 15px; margin-bottom: 10px;">
                                <div class="col-md-12 text-left" style="padding-left: 0px;">
                                    <button id="btn_Save" type="button" class="btn btn-primary" style="min-width: 110px; background-color: var(--ar-primary) !important; border-color: var(--ar-primary) !important; color: #FFF !important;">
                                        <i class="ace-icon fa fa-floppy-o bigger-120"></i>
                                        <span id="btn_save_label">Save Record</span>
                                    </button>
                                    <button id="btn_Clear" type="button" class="btn btn-white btn-warning btn-bold" style="min-width: 90px; margin-left: 8px;">
                                        <i class="ace-icon fa fa-trash-o bigger-120 orange"></i>
                                        Clear
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Records Grid Section -->
                    <div class="box-body" style="padding: 10px 25px 20px 25px; border-top: 1px solid var(--border-color);">
                        <h4 style="font-size: 14px; font-weight: bold; color: var(--text-primary); margin-bottom: 10px;">
                            <i class="fa fa-list"></i> Logged Rework / Rejection Records
                        </h4>
                        <div id="Grid"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        // Highlight active menu in sidebar
        $("#Formation").addClass("active");
        $("#Rework_Rejection").addClass("active");

        var User = sessionStorage.getItem("user") || "formation";

        // =========================================================================
        // 1. Initialize Rework / Rejection Type Dropdown (from Reference_Group)
        // Flow: Reference_Group -> Fetch Reference Types -> Filter (Rework, Rejection)
        // =========================================================================
        var typeUrl = "../../Transaction/pr_fetch_Rework_Rejection_Types";
        var typeSource = {
            datatype: "json",
            datafields: [
                { name: 'RG_iID', type: 'string' },
                { name: 'RG_vCode', type: 'string' },
                { name: 'RG_vDescription', type: 'string' }
            ],
            id: 'RG_iID',
            url: typeUrl,
            async: false
        };
        var typeAdapter = new $.jqx.dataAdapter(typeSource);
        $("#ddlType").jqxDropDownList({
            selectedIndex: -1,
            source: typeAdapter,
            displayMember: "RG_vDescription",
            valueMember: "RG_iID",
            promptText: "Select Type",
            width: '100%',
            height: '34px',
            autoDropDownHeight: true
        });

        // =========================================================================
        // 2. Initialize Reason Dropdown (Dependent on Rework / Rejection Type)
        // Flow: Selected Type -> Fetch Reference Master filtered by Type -> Display in Reason
        // Initial state: No Type selected -> display "[ Select Type First ]"
        // =========================================================================
        function loadReasons(typeId) {
            if (!typeId) {
                $("#ddlReason").jqxDropDownList({
                    selectedIndex: -1,
                    source: [],
                    promptText: "Select Type First",
                    width: '100%',
                    height: '34px'
                });
                return;
            }

            var reasonUrl = "../../Transaction/pr_fetch_Rework_Rejection_Reasons?Type_ID=" + encodeURIComponent(typeId);
            var reasonSource = {
                datatype: "json",
                datafields: [
                    { name: 'RGV_iID', type: 'string' },
                    { name: 'RGV_vDesciption', type: 'string' },
                    { name: 'RGV_iRG_ID', type: 'string' },
                    { name: 'Reference_Type', type: 'string' }
                ],
                id: 'RGV_iID',
                url: reasonUrl,
                async: false
            };
            var reasonAdapter = new $.jqx.dataAdapter(reasonSource);
            $("#ddlReason").jqxDropDownList({
                selectedIndex: -1,
                source: reasonAdapter,
                displayMember: "RGV_vDesciption",
                valueMember: "RGV_vDesciption",
                promptText: "Select Reason",
                width: '100%',
                height: '34px',
                filterable: true,
                filterPlaceHolder: "Search Reason..."
            });
            $('#ddlReason').jqxDropDownList('clearSelection');
        }

        // Initial State: No type selected, display "Select Type First"
        loadReasons(null);

        // Synchronize Defect Mode Toggle Buttons with Dropdown Selection
        function syncToggleWithDdl(typeText) {
            $('.defect-toggle-btn').removeClass('active');
            if (!typeText) return;
            typeText = typeText.toLowerCase();
            if (typeText.indexOf('rework') !== -1) {
                $('#toggle_Rework').addClass('active');
            } else if (typeText.indexOf('rejection') !== -1) {
                $('#toggle_Rejection').addClass('active');
            }
        }

        $('#toggle_Rework').on('click', function () {
            var items = $("#ddlType").jqxDropDownList('getItems');
            if (items) {
                for (var i = 0; i < items.length; i++) {
                    if (items[i].label.toLowerCase().indexOf('rework') !== -1) {
                        $("#ddlType").jqxDropDownList('selectIndex', i);
                        break;
                    }
                }
            }
        });

        $('#toggle_Rejection').on('click', function () {
            var items = $("#ddlType").jqxDropDownList('getItems');
            if (items) {
                for (var i = 0; i < items.length; i++) {
                    if (items[i].label.toLowerCase().indexOf('rejection') !== -1) {
                        $("#ddlType").jqxDropDownList('selectIndex', i);
                        break;
                    }
                }
            }
        });

        // When Rework / Rejection Type changes:
        // Clear previous reason, fetch descriptions for selected type, bind to Reason dropdown
        $('#ddlType').on('select', function (event) {
            if (event.args) {
                var item = event.args.item;
                if (item && item.value) {
                    syncToggleWithDdl(item.label);
                    loadReasons(item.value);
                } else {
                    syncToggleWithDdl(null);
                    loadReasons(null);
                }
            } else {
                syncToggleWithDdl(null);
                loadReasons(null);
            }
        });

        // =========================================================================
        // 3. Initialize Employee Dropdown (from Employee_Master where EM_Status = 'A')
        // Flow: Employee_Master -> Filter Active only -> Display in Dropdown
        // =========================================================================
        var empUrl = "../../Transaction/pr_fetch_Active_Employees";
        var empSource = {
            datatype: "json",
            datafields: [
                { name: 'EM_ID', type: 'string' },
                { name: 'EM_Code', type: 'string' },
                { name: 'EM_Employee_Name', type: 'string' },
                { name: 'EM_Display_Name', type: 'string' }
            ],
            id: 'EM_ID',
            url: empUrl,
            async: false
        };
        var empAdapter = new $.jqx.dataAdapter(empSource);
        $("#ddlEmployee").jqxDropDownList({
            selectedIndex: -1,
            source: empAdapter,
            displayMember: "EM_Display_Name",
            valueMember: "EM_ID",
            promptText: "Select Employee",
            width: '100%',
            height: '34px',
            filterable: true,
            filterPlaceHolder: "Search Employee..."
        });

        // =========================================================================
        // QR Code / Serial Scanner Hook Scripts
        // =========================================================================
        function handleScanQRCode(serial) {
            serial = $.trim(serial);
            if (!serial) {
                $('#scan_feedback').html('<span class="text-danger"><i class="fa fa-exclamation-circle"></i> Please scan or enter a serial number.</span>');
                $('#txt_Battery_Type').val('');
                $('#txt_CKT_No').val('');
                return;
            }

            $('#scan_feedback').html('<span class="text-info"><i class="fa fa-spinner fa-spin"></i> Looking up serial: ' + serial + '...</span>');

            $.ajax({
                type: "GET",
                url: "../../Transaction/pr_fetch_QRCode_Details?ID=" + encodeURIComponent(serial),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    if (response && response.success) {
                        $('#txt_Battery_Type').val(response.batteryType || '');
                        $('#txt_CKT_No').val(response.cktNo || '');
                        $('#scan_feedback').html('<span class="text-success"><i class="fa fa-check-circle"></i> Scanned: <strong>' + serial + '</strong> — Battery Type: <strong>' + (response.batteryType || 'N/A') + '</strong>, CKT No: <strong>' + (response.cktNo || 'N/A') + '</strong></span>');
                    } else {
                        $('#txt_Battery_Type').val('');
                        $('#txt_CKT_No').val('');
                        var msg = (response && response.message) ? response.message : ("Serial / QR Code '" + serial + "' not found in formation records.");
                        $('#scan_feedback').html('<span class="text-danger"><i class="fa fa-exclamation-circle"></i> ' + msg + '</span>');
                    }
                },
                error: function (xhr, status, error) {
                    $('#txt_Battery_Type').val('');
                    $('#txt_CKT_No').val('');
                    $('#scan_feedback').html('<span class="text-danger"><i class="fa fa-times-circle"></i> Error querying serial: ' + error + '</span>');
                }
            });
        }

        $('#txt_Scan_QRCode').on('keypress', function (e) {
            if (e.which === 13 || e.keyCode === 13) {
                e.preventDefault();
                handleScanQRCode($(this).val());
            }
        });

        $('#btn_Clear_Scan').on('click', function () {
            $('#txt_Scan_QRCode').val('').focus();
            $('#txt_Battery_Type').val('');
            $('#txt_CKT_No').val('');
            $('#scan_feedback').html('Scan QR code with scanner or hit Enter.');
        });

        // Load Grid of saved records
        getGrid();

        // Refresh Button
        $("#btn_Refresh").click(function () {
            Clear();
            getGrid();
        });

        // Clear Button
        $("#btn_Clear").click(function () {
            Clear();
        });

        // =========================================================================
        // SAVE BUTTON CLICK & VALIDATION
        // =========================================================================
        $("#btn_Save").click(function () {
            saveRecord();
        });

        function saveRecord() {
            // Validation 1: Defect Mode (Rework / Rejection Type)
            var selectedTypeIndex = $('#ddlType').jqxDropDownList('selectedIndex');
            if (selectedTypeIndex < 0) {
                $.toaster({ priority: 'danger', title: 'Notice', message: "Please Select Defect Mode (Rework or Rejection)" });
                return;
            }

            // Validation 2: Reason
            var selectedReasonIndex = $('#ddlReason').jqxDropDownList('selectedIndex');
            if (selectedReasonIndex < 0) {
                $('#ddlReason').jqxDropDownList('focus');
                $.toaster({ priority: 'danger', title: 'Notice', message: "Please Select Reason" });
                return;
            }

            // Validation 3: Employee
            var selectedEmpIndex = $('#ddlEmployee').jqxDropDownList('selectedIndex');
            if (selectedEmpIndex < 0) {
                $('#ddlEmployee').jqxDropDownList('focus');
                $.toaster({ priority: 'danger', title: 'Notice', message: "Please Select Employee" });
                return;
            }

            var selectedTypeItem = $('#ddlType').jqxDropDownList('getSelectedItem');
            var selectedReasonItem = $('#ddlReason').jqxDropDownList('getSelectedItem');
            var selectedEmpItem = $('#ddlEmployee').jqxDropDownList('getSelectedItem');
            var reason = selectedReasonItem.label;

            // Send via AJAX to TransactionController
            $.ajax({
                type: "POST",
                url: "../../Transaction/pr_insert_Formation_Rework_Rejection",
                data: {
                    FRR_Type_ID: selectedTypeItem.value,
                    FRR_Type_Name: selectedTypeItem.label,
                    FRR_Reason: reason,
                    FRR_Employee_ID: selectedEmpItem.value,
                    FRR_Employee_Name: selectedEmpItem.label,
                    FRR_Created_By: User,
                    FRR_QRCode: $.trim($('#txt_Scan_QRCode').val()),
                    FRR_BatteryType: $.trim($('#txt_Battery_Type').val()),
                    FRR_CKTNo: $.trim($('#txt_CKT_No').val())
                },
                success: function (response) {
                    if (response === "True") {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Saved Successfully...!" });
                        try {
                            var savedType = (selectedTypeItem && selectedTypeItem.label) ? selectedTypeItem.label : '';
                            localStorage.setItem('rework_rejection_saved', JSON.stringify({ type: savedType, time: Date.now() }));
                        } catch (e) { }
                        try {
                            if (window.parent && window.parent !== window) {
                                if (typeof window.parent.refreshDashboardCounts === 'function') {
                                    window.parent.refreshDashboardCounts(savedType);
                                }
                                if (savedType && savedType.toLowerCase() === 'rework' && typeof window.parent.refreshReworkChart === 'function') {
                                    window.parent.refreshReworkChart();
                                } else if (savedType && savedType.toLowerCase() === 'rejection' && typeof window.parent.refreshRejectionChart === 'function') {
                                    window.parent.refreshRejectionChart();
                                }
                            }
                        } catch (e) { }
                        try {
                            if (window.opener) {
                                if (typeof window.opener.refreshDashboardCounts === 'function') {
                                    window.opener.refreshDashboardCounts(savedType);
                                }
                                if (savedType && savedType.toLowerCase() === 'rework' && typeof window.opener.refreshReworkChart === 'function') {
                                    window.opener.refreshReworkChart();
                                } else if (savedType && savedType.toLowerCase() === 'rejection' && typeof window.opener.refreshRejectionChart === 'function') {
                                    window.opener.refreshRejectionChart();
                                }
                            }
                        } catch (e) { }
                        Clear();
                        getGrid();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function (xhr, status, error) {
                    $.toaster({ priority: 'danger', title: 'Notice', message: "Failed to save record: " + error });
                }
            });
        }

        function Clear() {
            $('#ddlType').jqxDropDownList('clearSelection');
            loadReasons(null);
            $('#ddlEmployee').jqxDropDownList('clearSelection');
            $('#btn_save_label').text('Save Record');
            $('#btn_Clear_Scan').trigger('click');
            syncToggleWithDdl(null);
        }

        // =========================================================================
        // Grid Displaying Saved Records
        // =========================================================================
        function getGrid() {
            var gridUrl = "../../Transaction/pr_fetch_Formation_Rework_Rejection_List";
            var gridSource = {
                datatype: "json",
                datafields: [
                    { name: 'SNo', type: 'int' },
                    { name: 'FRR_ID', type: 'int' },
