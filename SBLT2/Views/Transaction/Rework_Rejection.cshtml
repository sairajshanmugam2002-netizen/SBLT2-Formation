@{
    ViewBag.Title = "Rework / Rejection";
}

<style>
    .required-star {
        color: #d9534f;
        font-weight: bold;
        margin-right: 3px;
    }
    .form-group label {
        font-weight: 600;
        color: #333;
        margin-bottom: 5px;
    }
    .box-title {
        font-size: 16px;
        font-weight: bold;
        color: #1e395b;
    }
</style>

<div class="content-wrapper">
    <section class="content">
        <div class="row">
            <div class="col-xs-12" style="padding:5px; padding-top:0px">
                <div class="box box-primary">
                    <div class="box-header with-border" style="background-color: #f7f9fa; border-bottom: 1px solid #e1e8ed;">
                        <h3 class="box-title">
                            <i class="fa fa-wrench text-primary" style="margin-right: 5px;"></i>
                            Rework / Rejection
                        </h3>
                        <div class="box-tools pull-right">
                            <button type="button" id="btn_Refresh" title="Refresh" class="btn btn-box-tool" style="padding:5px">
                                <span class='fa fa-refresh bigger-130' style="color:#5c6bc0;"></span>
                            </button>
                        </div>
                    </div>

                    <div class="panel-body" style="padding: 20px 25px 10px 25px;">
                        <form class="form-horizontal" role="form" id="formReworkRejection" onsubmit="return false;">
                            <div class="row">
                                <!-- Field 1: Rework / Rejection Type -->
                                <div class="col-md-4 col-sm-6 form-group" style="padding-right: 15px;">
                                    <label for="ddlType">
                                        <span class="required-star">*</span>1. Rework / Rejection Type
                                    </label>
                                    <div id="ddlType"></div>
                                </div>

                                <!-- Field 2: Reason -->
                                <div class="col-md-4 col-sm-6 form-group" style="padding-right: 15px;">
                                    <label for="ddlReason">
                                        <span class="required-star">*</span>2. Reason
                                    </label>
                                    <div id="ddlReason"></div>
                                </div>

                                <!-- Field 3: Employee -->
                                <div class="col-md-4 col-sm-6 form-group">
                                    <label for="ddlEmployee">
                                        <span class="required-star">*</span>3. Employee
                                    </label>
                                    <div id="ddlEmployee"></div>
                                </div>
                            </div>

                            <div class="row" style="margin-top: 15px; margin-bottom: 10px;">
                                <div class="col-md-12 text-left" style="padding-left: 0px;">
                                    <button id="btn_Save" type="button" class="btn btn-white btn-info btn-bold" style="min-width: 100px;">
                                        <i class="ace-icon fa fa-floppy-o bigger-120 blue"></i>
                                        <span id="btn_save_label">Save</span>
                                    </button>
                                    <button id="btn_Clear" type="button" class="btn btn-white btn-warning btn-bold" style="min-width: 90px; margin-left: 8px;">
                                        <i class="ace-icon fa fa-trash-o bigger-120 orange"></i>
                                        Clear
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Records Grid Section -->
                    <div class="box-body" style="padding: 10px 25px 20px 25px; border-top: 1px solid #eee;">
                        <h4 style="font-size: 14px; font-weight: bold; color: #555; margin-bottom: 10px;">
                            <i class="fa fa-list"></i> Logged Rework / Rejection Records
                        </h4>
                        <div id="Grid"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        // Highlight active menu in sidebar
        $("#Formation").addClass("active");
        $("#Rework_Rejection").addClass("active");

        var User = sessionStorage.getItem("user") || "formation";

        // =========================================================================
        // 1. Initialize Rework / Rejection Type Dropdown (from Reference_Group)
        // Flow: Reference_Group -> Fetch Reference Types -> Filter (Rework, Rejection)
        // =========================================================================
        var typeUrl = "../../Transaction/pr_fetch_Rework_Rejection_Types";
        var typeSource = {
            datatype: "json",
            datafields: [
                { name: 'RG_iID', type: 'string' },
                { name: 'RG_vCode', type: 'string' },
                { name: 'RG_vDescription', type: 'string' }
            ],
            id: 'RG_iID',
            url: typeUrl,
            async: false
        };
        var typeAdapter = new $.jqx.dataAdapter(typeSource);
        $("#ddlType").jqxDropDownList({
            selectedIndex: -1,
            source: typeAdapter,
            displayMember: "RG_vDescription",
            valueMember: "RG_iID",
            promptText: "Select Type",
            width: '100%',
            height: '34px',
            autoDropDownHeight: true
        });

        // =========================================================================
        // 2. Initialize Reason Dropdown (Dependent on Rework / Rejection Type)
        // Flow: Selected Type -> Fetch Reference Master filtered by Type -> Display in Reason
        // Initial state: No Type selected -> display "[ Select Type First ]"
        // =========================================================================
        function loadReasons(typeId) {
            if (!typeId) {
                $("#ddlReason").jqxDropDownList({
                    selectedIndex: -1,
                    source: [],
                    promptText: "Select Type First",
                    width: '100%',
                    height: '34px'
                });
                return;
            }

            var reasonUrl = "../../Transaction/pr_fetch_Rework_Rejection_Reasons?Type_ID=" + encodeURIComponent(typeId);
            var reasonSource = {
                datatype: "json",
                datafields: [
                    { name: 'RGV_iID', type: 'string' },
                    { name: 'RGV_vDesciption', type: 'string' },
                    { name: 'RGV_iRG_ID', type: 'string' },
                    { name: 'Reference_Type', type: 'string' }
                ],
                id: 'RGV_iID',
                url: reasonUrl,
                async: false
            };
            var reasonAdapter = new $.jqx.dataAdapter(reasonSource);
            $("#ddlReason").jqxDropDownList({
                selectedIndex: -1,
                source: reasonAdapter,
                displayMember: "RGV_vDesciption",
                valueMember: "RGV_vDesciption",
                promptText: "Select Reason",
                width: '100%',
                height: '34px',
                filterable: true,
                filterPlaceHolder: "Search Reason..."
            });
            $('#ddlReason').jqxDropDownList('clearSelection');
        }

        // Initial State: No type selected, display "Select Type First"
        loadReasons(null);

        // When Rework / Rejection Type changes:
        // Clear previous reason, fetch descriptions for selected type, bind to Reason dropdown
        $('#ddlType').on('select', function (event) {
            if (event.args) {
                var item = event.args.item;
                if (item && item.value) {
                    loadReasons(item.value);
                } else {
                    loadReasons(null);
                }
            } else {
                loadReasons(null);
            }
        });

        // =========================================================================
        // 3. Initialize Employee Dropdown (from Employee_Master where EM_Status = 'A')
        // Flow: Employee_Master -> Filter Active only -> Display in Dropdown
        // =========================================================================
        var empUrl = "../../Transaction/pr_fetch_Active_Employees";
        var empSource = {
            datatype: "json",
            datafields: [
                { name: 'EM_ID', type: 'string' },
                { name: 'EM_Code', type: 'string' },
                { name: 'EM_Employee_Name', type: 'string' },
                { name: 'EM_Display_Name', type: 'string' }
            ],
            id: 'EM_ID',
            url: empUrl,
            async: false
        };
        var empAdapter = new $.jqx.dataAdapter(empSource);
        $("#ddlEmployee").jqxDropDownList({
            selectedIndex: -1,
            source: empAdapter,
            displayMember: "EM_Display_Name",
            valueMember: "EM_ID",
            promptText: "Select Employee",
            width: '100%',
            height: '34px',
            filterable: true,
            filterPlaceHolder: "Search Employee..."
        });

        // Load Grid of saved records
        getGrid();

        // Refresh Button
        $("#btn_Refresh").click(function () {
            Clear();
            getGrid();
        });

        // Clear Button
        $("#btn_Clear").click(function () {
            Clear();
        });

        // =========================================================================
        // SAVE BUTTON CLICK & VALIDATION
        // =========================================================================
        $("#btn_Save").click(function () {
            saveRecord();
        });

        function saveRecord() {
            // Validation 1: Rework / Rejection Type
            var selectedTypeIndex = $('#ddlType').jqxDropDownList('selectedIndex');
            if (selectedTypeIndex < 0) {
                $('#ddlType').jqxDropDownList('focus');
                $.toaster({ priority: 'danger', title: 'Notice', message: "Please Select Rework / Rejection Type" });
                return;
            }

            // Validation 2: Reason
            var selectedReasonIndex = $('#ddlReason').jqxDropDownList('selectedIndex');
            if (selectedReasonIndex < 0) {
                $('#ddlReason').jqxDropDownList('focus');
                $.toaster({ priority: 'danger', title: 'Notice', message: "Please Select Reason" });
                return;
            }

            // Validation 3: Employee
            var selectedEmpIndex = $('#ddlEmployee').jqxDropDownList('selectedIndex');
            if (selectedEmpIndex < 0) {
                $('#ddlEmployee').jqxDropDownList('focus');
                $.toaster({ priority: 'danger', title: 'Notice', message: "Please Select Employee" });
                return;
            }

            var selectedTypeItem = $('#ddlType').jqxDropDownList('getSelectedItem');
            var selectedReasonItem = $('#ddlReason').jqxDropDownList('getSelectedItem');
            var selectedEmpItem = $('#ddlEmployee').jqxDropDownList('getSelectedItem');
            var reason = selectedReasonItem.label;

            // Send via AJAX to TransactionController
            $.ajax({
                type: "POST",
                url: "../../Transaction/pr_insert_Formation_Rework_Rejection",
                data: {
                    FRR_Type_ID: selectedTypeItem.value,
                    FRR_Type_Name: selectedTypeItem.label,
                    FRR_Reason: reason,
                    FRR_Employee_ID: selectedEmpItem.value,
                    FRR_Employee_Name: selectedEmpItem.label,
                    FRR_Created_By: User
                },
                success: function (response) {
                    if (response === "True") {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Saved Successfully...!" });
                        try {
                            var savedType = (selectedTypeItem && selectedTypeItem.label) ? selectedTypeItem.label : '';
                            localStorage.setItem('rework_rejection_saved', JSON.stringify({ type: savedType, time: Date.now() }));
                        } catch (e) { }
                        try {
                            if (window.parent && window.parent !== window) {
                                if (typeof window.parent.refreshDashboardCounts === 'function') {
                                    window.parent.refreshDashboardCounts(savedType);
                                }
                                if (savedType && savedType.toLowerCase() === 'rework' && typeof window.parent.refreshReworkChart === 'function') {
                                    window.parent.refreshReworkChart();
                                } else if (savedType && savedType.toLowerCase() === 'rejection' && typeof window.parent.refreshRejectionChart === 'function') {
                                    window.parent.refreshRejectionChart();
                                }
                            }
                        } catch (e) { }
                        try {
                            if (window.opener) {
                                if (typeof window.opener.refreshDashboardCounts === 'function') {
                                    window.opener.refreshDashboardCounts(savedType);
                                }
                                if (savedType && savedType.toLowerCase() === 'rework' && typeof window.opener.refreshReworkChart === 'function') {
                                    window.opener.refreshReworkChart();
                                } else if (savedType && savedType.toLowerCase() === 'rejection' && typeof window.opener.refreshRejectionChart === 'function') {
                                    window.opener.refreshRejectionChart();
                                }
                            }
                        } catch (e) { }
                        Clear();
                        getGrid();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function (xhr, status, error) {
                    $.toaster({ priority: 'danger', title: 'Notice', message: "Failed to save record: " + error });
                }
            });
        }

        function Clear() {
            $('#ddlType').jqxDropDownList('clearSelection');
            loadReasons(null);
            $('#ddlEmployee').jqxDropDownList('clearSelection');
            $('#btn_save_label').text('Save');
        }

        // =========================================================================
        // Grid Displaying Saved Records
        // =========================================================================
        function getGrid() {
            var gridUrl = "../../Transaction/pr_fetch_Formation_Rework_Rejection_List";
            var gridSource = {
                datatype: "json",
                datafields: [
                    { name: 'SNo', type: 'int' },
                    { name: 'FRR_ID', type: 'int' },
                    { name: 'FRR_Type_Name', type: 'string' },
                    { name: 'FRR_Reason', type: 'string' },
                    { name: 'FRR_Employee_Name', type: 'string' },
                    { name: 'FRR_Created_By', type: 'string' },
                    { name: 'FRR_Created_Date', type: 'string' },
                    { name: 'FRR_Status', type: 'string' }
                ],
                id: 'FRR_ID',
                url: gridUrl,
                async: true
            };
            var gridAdapter = new $.jqx.dataAdapter(gridSource);
            $("#Grid").jqxGrid({
                width: '100%',
                height: '320px',
                source: gridAdapter,
                pageable: true,
                pagesize: 10,
                sortable: true,
                filterable: true,
                columnsresize: true,
                columns: [
                    { text: 'S.No', datafield: 'SNo', width: '8%', align: 'center', cellsalign: 'center' },
                    { text: 'Type', datafield: 'FRR_Type_Name', width: '15%' },
                    { text: 'Reason', datafield: 'FRR_Reason', width: '37%' },
                    { text: 'Employee', datafield: 'FRR_Employee_Name', width: '20%' },
                    { text: 'Created By', datafield: 'FRR_Created_By', width: '10%' },
                    { text: 'Date & Time', datafield: 'FRR_Created_Date', width: '10%' }
                ]
            });
        }
    });
</script>
