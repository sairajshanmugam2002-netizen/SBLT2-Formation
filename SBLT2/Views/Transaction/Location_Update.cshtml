@{
    ViewBag.Title = "Location_Update";
}

<script type="text/javascript">
    $(document).ready(function () {
        var ID = 0;
        var User = sessionStorage.getItem("user");

        $("#from_Date").jqxDateTimeInput({ width: '110px', height: '25px', formatString: 'dd-MMM-yyyy' });
        $("#to_Date").jqxDateTimeInput({ width: '110px', height: '25px', formatString: 'dd-MMM-yyyy' });

        var url = "../../Transaction/pr_FetchBinNo"//?ID=" + User;
        var Source =
        {
            datatype: "json",
            datafields: [

                { name: 'sl_ID', type: 'string' },
                { name: 'sl_BinNo', type: 'string' }
            ],
            id: 'id',
            url: url
        };
        var adapter = new $.jqx.dataAdapter(Source);
        $("#sl_BinNo").jqxDropDownList({ selectedIndex: -1, source: adapter, displayMember: "sl_BinNo", valueMember: "sl_ID", width: '100%', height: '30' });

        getgrid();
        function getgrid() {
            var Rights = sessionStorage.getItem('rights');
            var User = sessionStorage.getItem('Code');
            var url = "";
            if (Rights == 19) {
                $("#from_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });
                $("#to_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });

                url = "pr_FetchLocationUpdate?from=" + $('#from_Date').val() + "&to=" + $('#to_Date').val();

                $("#from_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
                $("#to_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
            }
            else {
                $("#from_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });
                $("#to_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });

                url = "pr_FetchLocationUpdate?from=" + $('#from_Date').val() + "&to=" + $('#to_Date').val();

                $("#from_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
                $("#to_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
            }
            var source = {
                datatype: "json",
                datafields: [{
                    name: 'mr_ID',
                    type: 'string'
                }, {
                        name: 'TagNo',
                        type: 'string'
                    },
                    {
                        name: 'mr_DOR',
                        type: 'string'
                    },
                {
                    name: 'mr_MaterialCode',
                    type: 'string'
                    },
                    {
                        name: 'mr_MaterialDescription',
                        type: 'string'
                    },
                {
                    name: 'mr_DOM',
                    type: 'string'
                },
                {
                    name: 'mr_BinNo',
                    type: 'string'
                    }, {
                        name: 'UOM',
                        type: 'string'
                    }, {
                        name: 'mr_Weight',
                        type: 'string'
                    },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter = new $.jqx.dataAdapter(source);
            $("#Grid").jqxGrid({
                theme: 'ui-sunny',
                width: '100%',
                autoheight: true,
                source: dataAdapter,
                columnsresize: true,
                pageable: true,
                editable: true,
                enabletooltips: false,
                pagermode: 'simple',
                enabletooltips: true,
                selectionmode: 'checkbox',
                showfilterrow: true,
                filterable: true,
                pagesize: 14,
                columns: [{
                    text: 'id',
                    datafield: 'mr_ID',
                    width: '100px',
                    hidden: true
                },
                    {
                        text: 'Tag No',
                        datafield: 'TagNo',
                        width: '20%'
                    },
                    {
                        text: 'DOR',
                        datafield: 'mr_DOR',
                        width: '20%'
                    }, {
                        text: 'Material Code',
                        datafield: 'mr_MaterialCode',
                        width: '20%'
                    },
                    {
                        text: 'Material Description',
                        datafield: 'mr_MaterialDescription',
                        width: '18%',
                    },
                    {
                        text: 'UOM',
                        datafield: 'UOM',
                        width: '20%'
                    }, {
                        text: 'Weight',
                        datafield: 'mr_Weight',
                        width: '20%'
                    }, {
                        text: 'Bin No',
                        datafield: 'mr_BinNo',
                        width: '20%',
                    },                  
                    //{
                    //    text: 'Edit',
                    //    datafield: 'Edit',
                    //    filterable: false,
                    //    width: 40,
                    //    cellsrenderer: function () {
                    //        return '<div style="width: 100%"><img src="../../../img/Edit1.png" style="margin-left: 25%"/></div>';
                    //    }
                    //},
                    //{
                    //    text: 'Del',
                    //    datafield: 'delete',
                    //    filterable: false,
                    //    width: 40,
                    //    cellsrenderer: function () {
                    //        return '<div style="width: 100%"><img src="../../../img/del.png" style="margin-left: 25%"/></div>';
                    //    }
                    //},
                ]
            });
        }
        $("#Grid").on('cellendedit', function (event) {
            debugger
            var column = event.args.column;
            var rowindex = event.args.rowindex;
            var columnindex = event.args.columnindex;
            var dataRecord = $("#Grid").jqxGrid('getrowdata', rowindex);
            if (args.datafield == 'mr_BinNo') {
                if (args.value != "" && args.oldvalue != args.value) {
                    $.ajax({
                        type: 'POST',
                        contentType: "application/json; charset=utf-8",
                        url: 'Pr_Update_LocationUpdate',
                        data: "{'Bin':'" + args.value + "','ID':'" + args.row.mr_ID + "'}",//,'sc_StockQty':'" + args.value + "','sc_StoreID':'" + StoreID + "','sc_User':'" + User + "','sc_ItemBarcode':'" + args.row.IM_Barcode + "'}",
                        async: false,
                        success: function (response) {
                        },
                        error: function () {
                            console.log('there is some error');
                        }
                    });
                }
            }
        });

        $('#btnsave').click(function () {
            debugger
            var selectedrows = $('#Grid').jqxGrid('getselectedrowindexes');
            if (selectedrows.length <= 0) {
                alert('Please select row want to Save');
                return;
            }
            else {
                //var a = confirm("Are you sure want to delete press OK");
                //if (a == true) {
                    for (var i = 0; i < selectedrows.length; i++) {
                        mr_ID = $('#Grid').jqxGrid('getcellvalue', selectedrows[i], "mr_ID");
                        $.ajax({
                            type: 'POST',
                            contentType: "application/json; charset=utf-8",
                            url: 'Pr_Update_LocationUpdate',
                            data: "{'ID':'" + mr_ID + "','Bin':'" + $('#sl_BinNo').val() + "'}",
                            async: false,
                            success: function (response) {
                                //$("#Grid").jqxGrid('updatebounddata');
                                //alert('Record Deleted Successfully');
                            },
                            error: function () {
                                console.log('there is some error');
                            }
                        });
                    }
                //}
                //else {
                    //$('#Grid').jqxGrid('clearselection');
                    //return;
                //}
            }
            alert("Record Updated Successfully...!");
            $('#Grid').jqxGrid('clearselection');
            $("#Grid").jqxGrid('updatebounddata');
        });

        $("#btnshow").click(function () {
            $('#myModal').modal('hide');
            getgrid();
        })

        $("#Transactions").addClass("active");
        $("#Location_Update").addClass("active");

        $("#sidebar-collapse").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        });
        $("#btn_Clear").click(function () {
            Clear();
        })
        $("#btn_Refresh").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        })
        $("#btn_Excel").click(function () {
            $("#from_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });
            $("#to_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'yyyyMMdd' });
            window.open("../../Master/Export_To_Excel?FileName=Location Update&Heading=Location Update&Data=pr_FetchLocationUpdate_Excel '" + $('#from_Date').val() + "','" + $('#to_Date').val() + "'");
            $("#from_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
            $("#to_Date").jqxDateTimeInput({ width: '180px', height: '25px', formatString: 'dd-MMM-yyyy' });
        })

        $("#Transactions").addClass("active");
        $("#Location_Update").addClass("active");

        $("#btn_Pdf").click(function () { })
        $("#btn_Chart").click(function () { })
        $("#btn_Help").click(function () { })
    });
</script>


