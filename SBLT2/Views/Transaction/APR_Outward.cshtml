            $.ajax({
                url: "pr_update_APROutward?inv_QRCode=" + $('#inv_QRCode').val() +
                    "&inv_User=" + User,
                type: "POST",
                processData: false,
                contentType: false,
                data: data,
                async: false,
                success: function (response) {
                    if (response == 'True') {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Saved Successfully" });
                        $('#blah1').attr('src', "../../");
                        Clear();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function (er) {
                    alert(er.responseText);
                }
            });
            getGrid();
        }

        function Update() {
            var data = new FormData();
            $.ajax({
                url: "pr_update_MaterialReceipt?inv_Id=" + ID + "&inv_ProdName=" + $('#inv_ProdName').val() + "&inv_ProdCode=" + $('#inv_ProdCode').val() + "&inv_Model=" + $('#inv_Model').val() +
                    "&inv_Customer=" + $('#inv_Customer').val() + "&inv_Location=" + $('#inv_Location').val() +
                    "&inv_Qty=" + $('#inv_Qty').val() + "&inv_LabelCount=" + $('#inv_LabelCount').val() + "&inv_QRCode=" + $('#inv_QRCode').val() +
                    "&mr_BE_No=" + $('#mr_BE_No').val() + "&mr_Place=" + $('#mr_Place').val() + "&mr_AvgWeight=" + $('#mr_AvgWeight').val() +
                    "&mr_Lot_No=" + $('#mr_Lot_No').val() + "&mr_Source=" + $('#mr_Source').val() + "&mr_SupplierName=" + $('#mr_SupplierName').val() +
                    "&mr_DOM=" + $('#mr_DOM').val() + "&mr_ApprovedSource=" + $('#mr_ApprovedSource').val() + "&mr_CreadtedBy=" + $('#mr_CreadtedBy').val() +
                    "&mr_Remarks=" + $('#mr_Remarks').val(),
               type: "POST",
                processData: false,
                contentType: false,
                data: data,
                async: false,
                success: function (response) {
                    if (response == 'True') {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Updated Successfully" });
                        $("#Grid").jqxGrid('updatebounddata');
                        Clear();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function (er) {
                    alert(er.responseText);
                }
            });
        }

