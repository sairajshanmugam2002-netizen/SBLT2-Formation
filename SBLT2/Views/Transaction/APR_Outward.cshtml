        $('#inv_QRCode').keypress(function (e) {
            var flag = true;
            if (e.keyCode == 13) {
                var a = "false";
                $.ajax({
                    type: "POST",
                    url: "pr_Fetch_APRInward_Available?ID=" + $('#inv_QRCode').val(),
                    dataType: "text",
                    async: false,
                    success: function (response) {
                        a = response;
                        //alert(a);
                    }
                });
                if (a == "false") {
                    alert("QR Code Not yet Inward in Ananthapur or Already Scanned");
                    $('#inv_QRCode').val("");
                    $('#inv_QRCode').focus();
                    return;
                }
                else {
                    var url = "../../Transaction/pr_fetch_CHEInwardDetails?ID=" + $('#inv_QRCode').val();
                    var Source =
                    {
                        datatype: "json",
                        datafields: [
                            { name: 'inv_ProdCode', type: 'string' }, { name: 'inv_Customer', type: 'string' },
                            { name: 'inv_Model', type: 'string' }, { name: 'inv_Location', type: 'string' },
                            { name: 'inv_Qty', type: 'string' }, { name: 'inv_ProdName', type: 'string' },
                            { name: 'inv_RouteCard', type: 'string' }, { name: 'inv_OracleStage', type: 'string' }
                        ],
                        id: 'id',
                        url: url,
                        async: false
                    };
                    var dataAdapter_per = new $.jqx.dataAdapter(Source, {
                        contentType: 'application/json; charset=utf-8',
                        loadComplete: function () {
                            var length = dataAdapter_per.records.length;
                            var records = dataAdapter_per.records;
                            var record = records[0];
                            flag = false;
                            $('#inv_ProdCode').val(record.inv_ProdCode); $('#inv_Customer').val(record.inv_Customer);
                            $('#inv_Location').val(record.inv_Location); $('#inv_Model').val(record.inv_Model);
