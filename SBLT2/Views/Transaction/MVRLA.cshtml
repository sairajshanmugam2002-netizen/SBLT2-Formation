        function Bind(ID) {
            var url = "../../Transaction/pr_FetchProductDetails?ID=" + ID;
            var Source =
            {
                datatype: "json",
                datafields: [
                    { name: 'mm_ID', type: 'string' }, { name: 'mm_MaterialCode', type: 'string' },
                    { name: 'mm_CustomerName', type: 'string' }, { name: 'mm_Location', type: 'string' },
                    { name: 'mm_Model', type: 'string' },
                ],
                id: 'id',
                url: url
            };
            var dataAdapter_per = new $.jqx.dataAdapter(Source, {
                contentType: 'application/json; charset=utf-8',
                loadComplete: function () {
                    var length = dataAdapter_per.records.length;
                    var records = dataAdapter_per.records;
                    var record = records[0];
                    $('#mv_NoOfCells').val(record.mm_MaterialCode); $('#mv_CDPassedQty').val(record.mm_CustomerName);
                    $('#mv_AcidSPG').val(record.mm_Location); $('#mv_FillingStartTime').val(record.mm_Model);
                },
                error: function (xhr, status, error) {
                    alert(JSON.stringify(xhr));
                }
            })
            dataAdapter_per.dataBind();
        }

