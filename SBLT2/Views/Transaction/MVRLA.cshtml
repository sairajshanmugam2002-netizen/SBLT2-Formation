                    "&mv_FillingOperator=" + $('#mv_FillingOperator').val() + "&mv_QAInspector=" + $('#mv_QAInspector').val() + "&mv_Shift=" + $('#mv_Shift').val() +
                    "&mv_ShiftEngineer=" + $('#mv_ShiftEngineer').val() + "&mv_QRCode=" + $('#mv_QRCode').val() + "&mv_User=" + User,
                type: "POST",
                processData: false,
                contentType: false,
                data: data,
                async: false,
                success: function (response) {
                    if (response == 'True') {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Saved Successfully" });
                        $('#blah1').attr('src', "../../");
                        Clear();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function (er) {
                    alert(er.responseText);
                }
            });
            getGrid();
        }

        function Update() {
            var data = new FormData();
            $.ajax({
                url: "pr_update_MaterialReceipt?inv_Id=" + ID + "&mv_Date=" + $('#mv_Date').val() + "&mv_NoOfCells=" + $('#mv_NoOfCells').val() + "&mv_FillingStartTime=" + $('#mv_FillingStartTime').val() +
                    "&mv_CDPassedQty=" + $('#mv_CDPassedQty').val() + "&mv_AcidSPG=" + $('#mv_AcidSPG').val() +
                    "&mv_TubNo=" + $('#mv_TubNo').val() + "&inv_LabelCount=" + $('#inv_LabelCount').val() + "&mv_BatteryType=" + $('#mv_BatteryType').val() +
                    "&mr_BE_No=" + $('#mr_BE_No').val() + "&mr_Place=" + $('#mr_Place').val() + "&mr_AvgWeight=" + $('#mr_AvgWeight').val() +
                    "&mr_Lot_No=" + $('#mr_Lot_No').val() + "&mr_Source=" + $('#mr_Source').val() + "&mr_SupplierName=" + $('#mr_SupplierName').val() +
                    "&mr_DOM=" + $('#mr_DOM').val() + "&mr_ApprovedSource=" + $('#mr_ApprovedSource').val() + "&mr_CreadtedBy=" + $('#mr_CreadtedBy').val() +
                    "&mr_Remarks=" + $('#mr_Remarks').val(),
               type: "POST",
                processData: false,
                contentType: false,
                data: data,
                async: false,
                success: function (response) {
                    if (response == 'True') {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Updated Successfully" });
                        $("#Grid").jqxGrid('updatebounddata');
                        Clear();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function (er) {
                    alert(er.responseText);
                }
            });
        }

        $("#inv_LabelCount").change(function () {
            debugger
            if ($('#inv_LabelCount').val() != "") {
                $('#mr_AvgWeight').val(parseInt($('#mv_TubNo').val()) / parseInt($('#inv_LabelCount').val()))
            }
        });

        $("#mv_TubNo").change(function () {
            debugger
            if ($('#mv_TubNo').val() != "") {
                $('#mr_AvgWeight').val(parseInt($('#mv_TubNo').val()) / parseInt($('#inv_LabelCount').val()))
            }
        });

        $('#Dep_Period').focusout(function (e) {
            debugger
            var d = $('#Dep_Period').val();
            var iNum = parseInt(d);
            var a = $('#Dep_date').jqxDateTimeInput('getDate');
            a.setHours(0, 0, 0, 0);
            var current = new Date(a);
            current.setMonth(a.getMonth() + iNum);
            $('#Dep_Maturitydate ').jqxDateTimeInput('setDate', new Date(current));
        });

        $("#btnApp").click(function () {
            var url = ("../../Transaction/pr_print_application?FileName=Bond&Heading=Bond&Data=pr_print_bond " + "&mv_Date=" + $('#mv_Date').val());
            window.open(url, '_blank', '800', '700');
        })

        function Clear() {
            $('#mv_QRCode').val('');
            $("#btn_save_label").text('Save');
            $('#blah1').attr('src', "../../");
            flag = false;
        }

        $("#Transactions").addClass("active");
        $("#CHN_Inward").addClass("active");

        $("#btn_AddNew").click(function () {
            $("#btn_save_label").text('Save');
            Clear();
        })
        $("#sidebar-collapse").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        });
        $("#btn_Clear").click(function () {
            Clear();
        })
        $("#btn_Refresh").click(function () {
            $("#Grid").jqxGrid('updatebounddata');
        })
        $("#btn_Excel").click(function () {
            window.open("../../Master/Export_To_Excel?FileName=Material_Receipt&Heading=Material Receipt&Data=Pr_Fetch_MaterialReceipt_Excel");
        })
        $("#btn_Pdf").click(function () { })
        $("#btn_Chart").click(function () { })
        $("#btn_Help").click(function () { })
    });
</script>

