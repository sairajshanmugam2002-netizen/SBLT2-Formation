        function save() {
            var data = new FormData();
            var selectedIndexSection12 = $('#mr_MaterialCode').jqxComboBox('selectedIndex');
            if (selectedIndexSection12 < 0) {
                flag = false;
                $("#mr_MaterialCode").jqxComboBox('focus');
                $.toaster({ priority: 'danger', title: 'Notice', message: "Please Select Material Code" });
                return;
            }
            var selectedIndexSection13 = $('#mr_SupplierName').jqxComboBox('selectedIndex');
            if (selectedIndexSection13 < 0) {
                flag = false;
                $("#mr_SupplierName").jqxComboBox('focus');
                $.toaster({ priority: 'danger', title: 'Notice', message: "Please Select Supplier Name" });
                return;
            }
            $.ajax({
                url: "pr_insert_MaterialReceipt?mr_MRC_No=" + $('#mr_MRC_No').val() + "&mr_InvoiceNo=" + $('#mr_InvoiceNo').val() +"&mr_DOR=" + $('#mr_DOR').val() +
                    "&mr_MaterialCode=" + $('#mr_MaterialCode').val() + "&mr_MaterialDescription=" + $('#mr_MaterialDescription').val() +
                    "&mr_Weight=" + $('#mr_Weight').val() + "&mr_NoOfBages=" + $('#mr_NoOfBages').val() + "&mr_BondNo=" + $('#mr_BondNo').val() +
                    "&mr_BE_No=" + $('#mr_BE_No').val() + "&mr_Place=" + $('#mr_Place').val() + "&mr_AvgWeight=" + $('#mr_AvgWeight').val() +
                    "&mr_Lot_No=" + $('#mr_Lot_No').val() +"&mr_Source=" + $('#mr_Source').val() + "&mr_SupplierName=" + $('#mr_SupplierName').val() +
                    "&mr_DOM=" + $('#mr_DOM').val() +"&mr_ApprovedSource=" + $('#mr_ApprovedSource').val() + "&mr_CreadtedBy=" + $('#mr_CreadtedBy').val() +
                    "&mr_Remarks=" + $('#mr_Remarks').val() + "&mr_User=" + User,
                type: "POST",
                processData: false,
                contentType: false,
                data: data,
                async: false,
                success: function (response) {
                    if (response == 'True') {
                        $.toaster({ priority: 'success', title: 'Notice', message: "Record Saved Successfully" });
                        $('#blah1').attr('src', "../../");
                        Clear();
                    } else {
                        $.toaster({ priority: 'danger', title: 'Notice', message: response });
                    }
                },
                error: function (er) {
                    alert(er.responseText);
                }
            });
            getGrid();
        }

